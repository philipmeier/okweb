---
import { Image } from "astro:assets";
import philipImg from "/src/assets/media/philip.jpg";

interface Props {
  name?: string;
  role?: string;
  avatar?: any;
}

const {
  name = "Philip Meier, PhD",
  role = "Founder, 10zebra & Computational Neuroscientist",
  avatar = philipImg,
} = Astro.props;
---

<div class="glass p-6 md:p-8 rounded-2xl border border-[var(--border-subtle)] my-12 relative overflow-hidden bg-gradient-to-br from-[rgba(26,28,33,0.7)] to-[rgba(19,20,23,0.9)]">
  <div class="absolute -top-12 -right-12 w-36 h-36 bg-[var(--accent)] opacity-10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
    <div class="relative flex-shrink-0">
      <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-[var(--accent)] to-[var(--accent-secondary)] p-[2px] shadow-lg shadow-orange-950/40 shrink-0">
        <div class="w-full h-full rounded-full bg-[#131417] flex items-center justify-center overflow-hidden">
          <Image
            src={avatar}
            alt={name}
            width={128}
            height={128}
            class="w-full h-full object-cover rounded-full"
          />
        </div>
      </div>
      <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-[#0c0d10] rounded-full flex items-center justify-center border border-[var(--border-subtle)]" title="Verified Creator">
        <svg class="w-3 h-3 text-[var(--accent)]" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>

    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <h4 class="font-display font-bold text-lg text-[var(--text-primary)]">{name}</h4>
        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-orange-500/20 font-medium">Founder</span>
      </div>
      <p class="text-xs text-[var(--text-muted)] mb-2 font-mono">{role}</p>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
        Neuroscientist, printmaker, and founder of 10zebra. Holding a PhD in computational neuroscience from UCSD, Philip explores how artists trick the human brain into seeing fiction and helps creative teams bridge traditional camera techniques with multi-model generative AI.
      </p>

      <div class="flex items-center gap-4 mt-4">
        <a href="https://twitter.com/10zebra_app" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 no-underline">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Follow @10zebra_app
        </a>
        <span class="text-[var(--border-strong)]">•</span>
        <a href="https://www.linkedin.com/in/philip-meier-phd/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 no-underline">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</div>
