---
import { Image } from "astro:assets";
import type { BlogPost } from "../../utils/blog";
import { formatBlogDate, calculateReadingTime } from "../../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, image, imageAlt, category, author } = post.data;
const readingTime = calculateReadingTime(post.body || '');
const formattedDate = formatBlogDate(pubDate);

// Category accent colors mapping
const categoryColors: Record<string, string> = {
  'Workflows & Tutorials': '#f97316',
  'Case Studies & Previs': '#38bdf8',
  'AI Models & Tech': '#a855f7',
  'Narrative & Perception': '#ec4899',
  'Community & Events': '#10b981'
};
const accent = categoryColors[category] || '#f97316';
---

<article class={`group relative flex flex-col glass rounded-2xl overflow-hidden border border-[var(--border-subtle)] hover:border-orange-500/40 hover:shadow-2xl hover:shadow-orange-950/20 transition-all duration-300 ${featured ? 'md:col-span-2 md:grid md:grid-cols-2 md:gap-6' : ''}`}>
  <!-- Thumbnail Container -->
  <a href={`/blog/${post.slug}`} class="block relative aspect-video overflow-hidden bg-[#131417] no-underline focus:outline-none" aria-label={`Read ${title}`}>
    {image && typeof image === 'object' ? (
      <Image
        src={image}
        alt={imageAlt || title}
        width={720}
        height={405}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#1a1c21] to-[#0c0d10]">
        <span class="text-xs uppercase tracking-widest text-[var(--text-muted)] font-mono">10zebra Studio</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-surface)] via-transparent to-transparent opacity-40"></div>

    <!-- Category Pill Tag (Overlaid on thumbnail) -->
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class="text-[0.68rem] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full backdrop-blur-md bg-[#0c0d10]/80 border border-white/10 text-white" style={`border-left: 3px solid ${accent};`}>
        {category}
      </span>
    </div>
  </a>

  <!-- Content Body -->
  <div class="flex-1 p-5 md:p-6 flex flex-col justify-between">
    <div>
      <!-- Meta line: Date & Reading time -->
      <div class="flex items-center gap-3 text-xs text-[var(--text-muted)] mb-3">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span class="flex items-center gap-1 font-mono text-[0.7rem] text-[var(--text-secondary)]">
          <svg class="w-3 h-3 text-[var(--accent)]" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
          </svg>
          {readingTime} min read
        </span>
      </div>

      <!-- Title -->
      <h3 class="font-display font-bold text-lg md:text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors duration-200 mb-3 leading-snug line-clamp-2">
        <a href={`/blog/${post.slug}`} class="no-underline text-inherit focus:outline-none">
          {title}
        </a>
      </h3>

      <!-- Excerpt Description -->
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-2 md:line-clamp-3 mb-4">
        {description}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between mt-auto">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-orange-500/20 text-[var(--accent)] flex items-center justify-center text-[0.65rem] font-bold font-display border border-orange-500/30">
          PM
        </div>
        <span class="text-xs text-[var(--text-muted)] font-medium">{author}</span>
      </div>

      <a href={`/blog/${post.slug}`} class="text-xs font-semibold text-[var(--accent)] group-hover:text-amber-300 flex items-center gap-1 transition-all duration-200 no-underline" aria-hidden="true" tabindex="-1">
        Read
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
