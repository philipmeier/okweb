---
const flow = [
  { icon: '&#129504;', label: 'Claude · ChatGPT · Cursor' },
  { icon: '&#128268;', label: '10zebra MCP' },
  { icon: '&#9889;', label: '8+ AI models' },
  { icon: '&#10003;', label: 'Your project' },
];
---
<section class="section py-16!" aria-labelledby="mcp-heading">
  <div class="glass mcp reveal">
    <div class="mcp-copy">
      <span class="sect-label">MCP Integration</span>
      <h2 id="mcp-heading">Generate From <span class="grad-text">Claude, ChatGPT &amp; Cursor</span></h2>
      <p>Your LLM sends the request. Results land in your project, with budgets and permissions intact.</p>
      <a href="/mcp" class="btn btn-ghost" id="mcp-setup-btn">Set up MCP &rarr;</a>
    </div>
    <ol class="mcp-flow" aria-label="How MCP generation flows">
      {flow.map((f, i) => (
        <li style={`--i:${i}`}>
          <span class="mcp-icon" set:html={f.icon} aria-hidden="true" />
          <span>{f.label}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mcp {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem;
    background:
      radial-gradient(ellipse at 100% 50%, rgba(249, 115, 22, 0.08), transparent 60%),
      var(--bg-card);
  }
  .mcp-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin-bottom: 0.75rem;
  }
  .mcp-copy p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem; max-width: 440px; }
  .mcp-flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    position: relative;
  }
  .mcp-flow::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-secondary), var(--accent), #34d399);
    opacity: 0.35;
  }
  .mcp-flow li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .mcp-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    background: var(--bg-elevated);
    border: 1px solid rgba(249, 115, 22, 0.3);
    box-shadow: 0 0 0 6px var(--bg-page);
    animation: mcp-pulse 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.5s);
  }
  @keyframes mcp-pulse {
    0%, 70%, 100% { border-color: rgba(249, 115, 22, 0.3); box-shadow: 0 0 0 6px var(--bg-page); }
    15% { border-color: var(--accent); box-shadow: 0 0 0 6px var(--bg-page), 0 0 22px var(--accent-glow); }
  }
  @media (max-width: 900px) {
    .mcp { grid-template-columns: 1fr; padding: 1.75rem; }
  }
  @media (max-width: 500px) {
    .mcp-flow { grid-template-columns: repeat(2, 1fr); }
    .mcp-flow::before { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .mcp-icon { animation: none; } }
</style>