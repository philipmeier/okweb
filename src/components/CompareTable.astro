---
import { totalFamilies, totalModels } from '/src/data/models';
---
<section class="section" aria-labelledby="compare-heading">
  <div class="sect-head reveal">
    <span class="sect-label">Comparison</span>
    <h2 id="compare-heading">Why Teams Choose <span class="grad-text">10zebra</span></h2>
    <p>The only workspace built for multi-model, multi-person production.</p>
  </div>

  <div class="glass overflow-x-auto p-2 reveal">
    <table class="w-full border-collapse text-sm" aria-label="Feature comparison">
      <thead>
        <tr>
          <th class="text-left p-3 text-[0.72rem] uppercase tracking-[1px] text-[var(--text-muted)] border-b border-[var(--border-subtle)] font-semibold">Capability</th>
          <th class="text-left p-3 text-[0.72rem] uppercase tracking-[1px] text-[var(--accent)] border-b border-[var(--border-subtle)] font-semibold">10zebra</th>
          <th class="text-left p-3 text-[0.72rem] uppercase tracking-[1px] text-[var(--text-muted)] border-b border-[var(--border-subtle)] font-semibold">Runway</th>
          <th class="text-left p-3 text-[0.72rem] uppercase tracking-[1px] text-[var(--text-muted)] border-b border-[var(--border-subtle)] font-semibold">Higgsfield</th>
          <th class="text-left p-3 text-[0.72rem] uppercase tracking-[1px] text-[var(--text-muted)] border-b border-[var(--border-subtle)] font-semibold">Artlist</th>
        </tr>
      </thead>
      <tbody>
        <!-- Group: Multi-Model -->
        <tr><td colspan="5" class="px-3 pt-5 pb-2 text-[0.7rem] uppercase tracking-[1.5px] text-[var(--text-muted)] font-bold border-b border-[var(--border-subtle)] bg-white/[0.01]">Multi-Model Generation</td></tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Generate across {totalFamilies} model families in one workspace</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; {totalFamilies} model families ({totalModels}+ engines)</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; 1 model family</td>
          <td class="p-3 text-[var(--text-muted)] italic">Partial</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; 1 model family</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">A/B test models on the same shot</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Text-to-sequence (auto multi-shot storyboard)</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <!-- Group: Team & Project Management -->
        <tr><td colspan="5" class="px-3 pt-5 pb-2 text-[0.7rem] uppercase tracking-[1.5px] text-[var(--text-muted)] font-bold border-b border-[var(--border-subtle)] bg-white/[0.01]">Project Management (Teams &amp; Budgets)</td></tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Project-level seats (invite per project, not whole app)</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; Per-project seats</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; App-wide only ($35+/mo)</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Single user</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Single user</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Project-isolated credit budgets &amp; spend caps</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; Per-project vault</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Account-wide pool</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Free client &amp; reviewer seats (Viewer role)</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; Free Viewers</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Paid seat required</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Agency, enterprise &amp; collaborator isolation</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; Zero client bleed</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Shared workspace</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Per-project audit trail &amp; generation history</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; Per-shot &amp; model</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; Basic account log</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <!-- Group: Production -->
        <tr><td colspan="5" class="px-3 pt-5 pb-2 text-[0.7rem] uppercase tracking-[1.5px] text-[var(--text-muted)] font-bold border-b border-[var(--border-subtle)] bg-white/[0.01]">Production Pipeline</td></tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Character consistency across shots</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003;</td>
          <td class="p-3 text-[var(--text-muted)] italic">Limited</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">Take-level trim + sequence export</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
        <!-- Group: Pricing -->
        <tr><td colspan="5" class="px-3 pt-5 pb-2 text-[0.7rem] uppercase tracking-[1.5px] text-[var(--text-muted)] font-bold border-b border-[var(--border-subtle)] bg-white/[0.01]">Pricing</td></tr>
        <tr class="border-b border-[rgba(46,50,59,0.4)]">
          <td class="p-3 text-[var(--text-primary)] font-medium">No subscription required (PAYG)</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003; $0 to start</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; $15/mo min</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; $9/mo min</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007; $14.99/mo</td>
        </tr>
        <tr>
          <td class="p-3 text-[var(--text-primary)] font-medium">Purchased credits never expire</td>
          <td class="p-3 text-[var(--accent)] font-semibold">&#10003;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
          <td class="p-3 text-[var(--text-muted)]">&#10007;</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
