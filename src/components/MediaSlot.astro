---
/**
 * MediaSlot — renders a slot from src/data/media.ts.
 * - Optimized responsive image (always rendered; acts as poster/fallback).
 * - Optional looping video, lazy-loaded and only played while on screen.
 * - Dev-only "MEDIA" tag; hover/focus to read the generation brief.
 * Size it from the parent (e.g. class="absolute inset-0" or "aspect-video").
 */
import { Image, getImage } from 'astro:assets';
import type { MediaSlot } from '../data/media';

interface Props {
  slot: MediaSlot;
  class?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** Hide the dev tag (e.g. for tiny thumbnails). */
  hideTag?: boolean;
}

const {
  slot,
  class: className = '',
  sizes = '(max-width: 900px) 100vw, 50vw',
  widths = [480, 800, 1280],
  eager = false,
  hideTag = false,
} = Astro.props;

const poster = slot.video ? await getImage({ src: slot.image, width: 1280, format: 'webp' }) : null;
const showTag = import.meta.env.DEV && !hideTag;
---

<div class:list={['media-slot', className]} data-media-slot={slot.id}>
  <Image
    src={slot.image}
    alt={slot.alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    class="media-slot__img"
  />
  {slot.video && poster && (
    <video
      class="media-slot__video"
      muted
      loop
      playsinline
      preload="none"
      poster={poster.src}
      data-src={slot.video}
      aria-hidden="true"
    ></video>
  )}
  {showTag && (
    <span class="media-slot__tag" tabindex="0">
      MEDIA · {slot.id}
      <span class="media-slot__brief">{slot.brief}</span>
    </span>
  )}
</div>

<style>
  .media-slot {
    position: relative;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .media-slot :global(.media-slot__img),
  .media-slot__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .media-slot__video { opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .media-slot__video.is-playing { opacity: 1; }

  /* Dev-only brief tag */
  .media-slot__tag {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 20;
    font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.5px;
    padding: 4px 6px;
    border-radius: 4px;
    color: #fde68a;
    background: rgba(12, 13, 16, 0.75);
    border: 1px dashed rgba(251, 191, 36, 0.6);
    cursor: help;
    white-space: nowrap;
  }
  .media-slot__brief {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 260px;
    white-space: normal;
    font: 500 11px/1.5 var(--font-body);
    letter-spacing: 0;
    color: var(--text-primary);
    background: #1a1c21;
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: 8px;
    padding: 8px 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .media-slot__tag:hover .media-slot__brief,
  .media-slot__tag:focus .media-slot__brief { display: block; }
</style>

<script>
  // Lazy-load + play videos only while visible; respect reduced motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video.media-slot__video[data-src]');
  if (!reduceMotion && videos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!v.src) v.src = v.dataset.src || '';
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { threshold: 0.25 }
    );
    videos.forEach((v) => {
      v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
      io.observe(v);
    });
  }
</script>
