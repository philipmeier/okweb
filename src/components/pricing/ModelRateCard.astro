---
// src/components/pricing/ModelRateCard.astro
import { modelRates, toolRates } from "/src/data/pricing";
---

<section class="section py-16 border-t border-[var(--border-subtle)]" aria-labelledby="rate-card-heading">
  <div class="wrap">
    <div class="sect-head mb-12 text-center">
      <span class="sect-label">Transparent Consumption</span>
      <h2 id="rate-card-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight">
        Model &amp; Feature <span class="grad-text">Credit Rate Card</span>
      </h2>
      <p class="max-w-2xl mx-auto text-[var(--text-secondary)] text-sm md:text-base mt-2">
        No hidden conversions or opaque token math. Here is the exact credit cost for every AI model and production tool in 10zebra.
      </p>
    </div>

    <!-- Automated Refund Guarantee Callout -->
    <div class="glass p-5 rounded-xl border border-emerald-500/30 bg-emerald-500/5 mb-10 flex flex-col sm:flex-row items-center gap-4">
      <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-lg shrink-0">
        &#10003;
      </div>
      <div class="text-center sm:text-left">
        <h3 class="text-sm font-bold text-[var(--text-primary)]">
          100% Automated Failed-Generation Credit Refund
        </h3>
        <p class="text-xs text-[var(--text-secondary)] mt-0.5 leading-relaxed">
          AI foundation models occasionally timeout or fail server-side safety filters. If a generation fails for any reason, 10zebra automatically returns 100% of the credits back to your project balance instantly. You never pay for blank takes.
        </p>
      </div>
    </div>

    <!-- Models Table -->
    <div class="glass overflow-x-auto rounded-2xl border border-[var(--border-subtle)] p-2 mb-12">
      <table class="w-full border-collapse text-left text-sm" aria-label="Model credit rates">
        <thead>
          <tr class="border-b border-[var(--border-subtle)] text-[0.72rem] uppercase tracking-wider text-[var(--text-muted)] font-semibold">
            <th class="p-3.5 pl-4">Model</th>
            <th class="p-3.5">Category</th>
            <th class="p-3.5">Credit Cost</th>
            <th class="p-3.5">Typical Speed</th>
            <th class="p-3.5">Resolution</th>
          </tr>
        </thead>
        <tbody>
          {modelRates.map((m) => (
            <tr class="border-b border-[rgba(46,50,59,0.3)] hover:bg-white/[0.02] transition-colors">
              <td class="p-3.5 pl-4">
                <div class="font-bold text-[var(--text-primary)]">{m.name}</div>
                <div class="text-xs text-[var(--text-muted)] max-w-sm mt-0.5">{m.desc}</div>
              </td>
              <td class="p-3.5 whitespace-nowrap">
                <span class="text-[0.7rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/20">
                  {m.badge}
                </span>
              </td>
              <td class="p-3.5 whitespace-nowrap">
                <div class="text-lg font-extrabold text-[var(--text-primary)] font-mono">
                  {m.credits} <span class="text-xs font-normal text-[var(--text-muted)]">credits</span>
                </div>
                <div class="text-[0.7rem] text-[var(--text-muted)]">{m.type}</div>
              </td>
              <td class="p-3.5 whitespace-nowrap text-xs text-[var(--text-secondary)] font-mono">
                {m.speed}
              </td>
              <td class="p-3.5 whitespace-nowrap text-xs text-[var(--text-secondary)] font-mono">
                {m.res}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Production Tools Table -->
    <div class="mt-8">
      <h3 class="text-lg font-bold text-[var(--text-primary)] mb-4" style="font-family:var(--font-display);">
        Production Pipeline Tools
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {toolRates.map((t) => (
          <div class="glass p-5 rounded-xl border border-[var(--border-subtle)] flex justify-between items-start gap-4">
            <div>
              <h4 class="text-sm font-bold text-[var(--text-primary)]">{t.tool}</h4>
              <p class="text-xs text-[var(--text-muted)] mt-1 leading-relaxed">{t.desc}</p>
            </div>
            <div class="text-right shrink-0">
              <span class="text-sm font-black text-emerald-400 font-mono whitespace-nowrap">
                {t.cost}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
