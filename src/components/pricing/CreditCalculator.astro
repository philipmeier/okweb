---
// src/components/pricing/CreditCalculator.astro
---

<section class="section py-16" aria-labelledby="calculator-heading">
  <div class="wrap">
    <div class="sect-head mb-10 text-center">
      <span class="sect-label">Production Estimator</span>
      <h2 id="calculator-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight">
        Estimate Your <span class="grad-text">Credit Consumption</span>
      </h2>
      <p class="max-w-xl mx-auto text-[var(--text-secondary)] text-sm md:text-base mt-2">
        Directing video requires multiple takes. Adjust your estimated shots and model preferences to see how many credits you need and which plan fits your workflow.
      </p>
    </div>

    <div
      class="glass max-w-4xl mx-auto p-6 md:p-10 rounded-2xl border border-[var(--border-subtle)] shadow-2xl relative overflow-hidden"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Controls Column (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Slider 1: Finished Shots -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label for="shots-slider" class="text-sm font-semibold text-[var(--text-primary)]">
                Target Finished Shots / Month
              </label>
              <span id="shots-val" class="text-lg font-black text-[var(--accent)] font-mono">
                25 shots
              </span>
            </div>
            <input
              type="range"
              id="shots-slider"
              min="5"
              max="150"
              step="5"
              value="25"
              class="w-full h-2 bg-[var(--bg-elevated)] rounded-lg appearance-none cursor-pointer accent-[var(--accent)]"
            />
            <div class="flex justify-between text-[0.7rem] text-[var(--text-muted)] mt-1 font-mono">
              <span>5 shots (quick spot)</span>
              <span>50 shots (social series)</span>
              <span>150+ (agency / film)</span>
            </div>
          </div>

          <!-- Selector 2: Production Style -->
          <div>
            <label class="text-sm font-semibold text-[var(--text-primary)] block mb-2.5">
              Production Workflow &amp; Model Mix
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="style-selector">
              <button
                type="button"
                data-multiplier="30"
                class="style-btn active text-left p-3 rounded-xl border border-[var(--accent)] bg-[var(--accent-subtle)] transition-all cursor-pointer"
              >
                <div class="text-xs font-bold text-[var(--text-primary)]">Balanced Multi-Model</div>
                <div class="text-[0.72rem] text-[var(--text-secondary)] mt-0.5">Kling 3.0 + Veo + Runway + Grok</div>
              </button>

              <button
                type="button"
                data-multiplier="45"
                class="style-btn text-left p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] transition-all cursor-pointer hover:border-[var(--border-strong)]"
              >
                <div class="text-xs font-bold text-[var(--text-primary)]">Cinematic Ultra</div>
                <div class="text-[0.72rem] text-[var(--text-secondary)] mt-0.5">Sora + Kling 3.0 + 4K Upscale</div>
              </button>

              <button
                type="button"
                data-multiplier="15"
                class="style-btn text-left p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] transition-all cursor-pointer hover:border-[var(--border-strong)]"
              >
                <div class="text-xs font-bold text-[var(--text-primary)]">Rapid Social &amp; Previs</div>
                <div class="text-[0.72rem] text-[var(--text-secondary)] mt-0.5">Veo 3 Fast + Grok + Wan</div>
              </button>

              <button
                type="button"
                data-multiplier="40"
                class="style-btn text-left p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] transition-all cursor-pointer hover:border-[var(--border-strong)]"
              >
                <div class="text-xs font-bold text-[var(--text-primary)]">Character-Consistent</div>
                <div class="text-[0.72rem] text-[var(--text-secondary)] mt-0.5">Takes + 10z Character Swaps</div>
              </button>
            </div>
          </div>

          <!-- Selector 3: Average Takes per Shot -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label class="text-sm font-semibold text-[var(--text-primary)]">
                Average Takes Generated per Shot
              </label>
              <span id="takes-val" class="text-xs font-mono text-[var(--accent)] font-semibold">2 takes</span>
            </div>
            <div class="flex gap-2">
              <button type="button" data-takes="1" class="take-btn flex-1 py-1.5 px-3 text-xs font-semibold rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer">
                1 Take (Direct)
              </button>
              <button type="button" data-takes="2" class="take-btn active flex-1 py-1.5 px-3 text-xs font-semibold rounded-lg border border-[var(--accent)] bg-[var(--accent-subtle)] text-[var(--text-primary)] cursor-pointer">
                2 Takes (Compare)
              </button>
              <button type="button" data-takes="3" class="take-btn flex-1 py-1.5 px-3 text-xs font-semibold rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer">
                3 Takes (A/B/C Test)
              </button>
            </div>
          </div>

        </div>

        <!-- Output Column (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-center p-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)]/60 relative">
          <div class="text-[0.72rem] uppercase tracking-wider font-bold text-[var(--text-muted)] mb-1">
            Estimated Monthly Need
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span id="calc-credits" class="text-4xl md:text-5xl font-black text-[var(--text-primary)] font-mono tracking-tight">
              1,500
            </span>
            <span class="text-sm text-[var(--text-muted)] font-medium">credits / mo</span>
          </div>

          <div class="p-3.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] mb-5 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[var(--text-secondary)]">Recommended Setup:</span>
              <span id="calc-plan-badge" class="font-bold text-[var(--accent)] uppercase tracking-wider text-[0.7rem] px-2 py-0.5 rounded bg-[var(--accent-subtle)]">
                Maker Plan
              </span>
            </div>
            <div class="text-xs text-[var(--text-muted)] leading-relaxed" id="calc-plan-desc">
              Maker Plan (1,200 credits) + 1 Starter Top-up pack with 15% subscriber discount.
            </div>
          </div>

          <!-- Comparison vs multiple subscriptions -->
          <div class="border-t border-[var(--border-subtle)] pt-3.5 mb-5">
            <div class="text-[0.7rem] uppercase tracking-wider font-semibold text-[var(--text-muted)] mb-1.5">
              Cost Comparison:
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-[var(--text-secondary)]">Single-model subs (Runway + Kling + Midjourney):</span>
              <span class="line-through text-red-400 font-mono font-semibold">$95+/mo</span>
            </div>
            <div class="flex justify-between items-center text-xs mt-1">
              <span class="text-[var(--text-primary)] font-semibold">10zebra all-in-one workspace:</span>
              <span id="calc-cost" class="font-mono font-bold text-emerald-400 text-sm">$29/mo</span>
            </div>
          </div>

          <a href="/signup" id="calc-cta" class="btn btn-primary btn-full py-2.5 text-xs font-bold uppercase tracking-wider">
            Start Free &amp; Test This Volume
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const shotsSlider = document.getElementById("shots-slider") as HTMLInputElement | null;
  const shotsVal = document.getElementById("shots-val");
  const takesVal = document.getElementById("takes-val");
  const calcCredits = document.getElementById("calc-credits");
  const calcPlanBadge = document.getElementById("calc-plan-badge");
  const calcPlanDesc = document.getElementById("calc-plan-desc");
  const calcCost = document.getElementById("calc-cost");
  const calcCta = document.getElementById("calc-cta");

  let baseMultiplier = 30; // Balanced
  let takeMultiplier = 2;   // 2 takes

  const styleButtons = document.querySelectorAll(".style-btn");
  styleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      styleButtons.forEach((b) => {
        b.classList.remove("active", "border-[var(--accent)]", "bg-[var(--accent-subtle)]");
        b.classList.add("border-[var(--border-subtle)]", "bg-[var(--bg-card)]");
      });
      btn.classList.add("active", "border-[var(--accent)]", "bg-[var(--accent-subtle)]");
      btn.classList.remove("border-[var(--border-subtle)]", "bg-[var(--bg-card)]");
      baseMultiplier = parseInt(btn.getAttribute("data-multiplier") || "30", 10);
      recalculate();
    });
  });

  const takeButtons = document.querySelectorAll(".take-btn");
  takeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      takeButtons.forEach((b) => {
        b.classList.remove("active", "border-[var(--accent)]", "bg-[var(--accent-subtle)]", "text-[var(--text-primary)]");
        b.classList.add("border-[var(--border-subtle)]", "bg-[var(--bg-card)]", "text-[var(--text-secondary)]");
      });
      btn.classList.add("active", "border-[var(--accent)]", "bg-[var(--accent-subtle)]", "text-[var(--text-primary)]");
      btn.classList.remove("border-[var(--border-subtle)]", "bg-[var(--bg-card)]", "text-[var(--text-secondary)]");
      takeMultiplier = parseInt(btn.getAttribute("data-takes") || "2", 10);
      if (takesVal) takesVal.textContent = `${takeMultiplier} take${takeMultiplier > 1 ? "s" : ""}`;
      recalculate();
    });
  });

  shotsSlider?.addEventListener("input", () => {
    if (shotsVal && shotsSlider) shotsVal.textContent = `${shotsSlider.value} shots`;
    recalculate();
  });

  function recalculate() {
    if (!shotsSlider || !calcCredits) return;
    const shots = parseInt(shotsSlider.value, 10);
    // Rough calculation: shots * takes * baseMultiplier
    const totalCredits = shots * takeMultiplier * baseMultiplier;
    calcCredits.textContent = totalCredits.toLocaleString();

    if (totalCredits <= 300) {
      if (calcPlanBadge) calcPlanBadge.textContent = "Pay-As-You-Go";
      if (calcPlanDesc) calcPlanDesc.textContent = "Start with 200 free trial credits. Grab one $10 Starter Top-Up (400 credits) whenever needed. Credits never expire.";
      if (calcCost) calcCost.textContent = "$0/mo + top-ups";
      if (calcCta) {
        calcCta.textContent = "Start Free with 200 Credits";
        calcCta.setAttribute("href", "/signup");
      }
    } else if (totalCredits <= 1500) {
      if (calcPlanBadge) calcPlanBadge.textContent = "Maker Plan";
      if (calcPlanDesc) calcPlanDesc.textContent = "Maker ($29/mo) gives you 1,200 credits/mo, priority queues, plus a 15% discount on any extra top-ups.";
      if (calcCost) calcCost.textContent = "$29/mo";
      if (calcCta) {
        calcCta.textContent = "Start Maker Plan";
        calcCta.setAttribute("href", "/signup?plan=maker");
      }
    } else if (totalCredits <= 4500) {
      if (calcPlanBadge) calcPlanBadge.textContent = "Director Plan";
      if (calcPlanDesc) calcPlanDesc.textContent = "Director ($79/mo) covers 3,500 credits/mo, project budget controls, shared team pools, and 30% off all top-ups.";
      if (calcCost) calcCost.textContent = "$79/mo";
      if (calcCta) {
        calcCta.textContent = "Start Director Plan";
        calcCta.setAttribute("href", "/signup?plan=director");
      }
    } else {
      if (calcPlanBadge) calcPlanBadge.textContent = "Studio / Custom Volume";
      if (calcPlanDesc) calcPlanDesc.textContent = "High volume production. Stack Director ($79/mo) with discounted 30% bulk top-up packs, or contact us for custom pools.";
      if (calcCost) calcCost.textContent = "Custom Volume";
      if (calcCta) {
        calcCta.textContent = "Contact Production Sales";
        calcCta.setAttribute("href", "mailto:sales@10zebra.com?subject=High-Volume%20Inquiry");
      }
    }
  }

  // Initial calculation
  recalculate();
</script>
