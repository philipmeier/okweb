---
---
<header class="h-[60px] px-[5%] flex justify-between items-center sticky top-0 z-[1000] border-b border-[var(--border-subtle)]"
  style="background:rgba(12,13,16,0.85); backdrop-filter:blur(16px) saturate(1.3);">

  <a href="/" class="flex items-center gap-2 no-underline text-[var(--text-primary)] max-w-[200px]" aria-label="10zebra home">
    <img
      src="https://cdn.prod.website-files.com/63c08dc99cc1f6e207c35685/673d8f0ef64a98520b1354de_10zebra-watermark-white.png"
      alt="10zebra" class="block w-full"
    />
  </a>

  <nav aria-label="Main navigation" class="nav-links flex gap-6 items-center">
    <a href="/features" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">Features</a>
    <a href="/models" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">AI Models</a>
    <a href="/pricing" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">Pricing</a>
    <a href="/resources" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">Resources</a>
    <a href="/mcp" class="text-[var(--accent)] text-sm font-medium no-underline hover:text-sky-300 transition-colors">MCP</a>
  </nav>

  <div class="flex items-center gap-3">
    <a href="/login" class="btn btn-ghost" id="nav-login-btn">Log In</a>
    <a href="/signup" class="btn btn-primary" id="nav-signup-btn">Start Free</a>
  </div>
</header>
