---
import MediaSlot from './MediaSlot.astro';
import { media } from '/src/data/media';

const perks = [
  {
    iconPath: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    title: 'Project-Level Seats',
    body: 'Invite editors, clients, or freelancers per project — not rigid app-wide seats.',
  },
  {
    iconPath: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
    title: 'Isolated Credit Vaults',
    body: 'Dedicated credit pools and caps. One project overrun never touches another.',
  },
  {
    iconPath: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
    title: 'Free Client Reviewers',
    body: 'Bring brand clients in as free Viewers to scrub takes, add notes, and approve.',
  },
  {
    iconPath: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    title: 'Agencies & Collabs',
    body: 'Strict client NDA isolation, multi-department walls, and creator co-directing.',
  },
];

// Illustrative projects — credits only (no mixed units).
const projects = [
  { name: 'Apex Sports Commercial', client: 'Agency Client · 3 Seats + Free Viewer', slot: media.personaAgencies, used: 320, total: 500, color: '#34d399', team: ['PM', 'AL', 'JR'] },
  { name: 'Lumière Fragrance Spot', client: 'Agency Client · Isolated Credit Vault', slot: media.personaCreativeDirectors, used: 410, total: 1200, color: '#38bdf8', team: ['MR', 'SK'] },
  { name: 'Nebula Protocol Pilot', client: 'Creator Collab · 4 Co-Directors', slot: media.personaFilmProduction, used: 1840, total: 2500, color: '#fbbf24', team: ['DV', 'EL', 'TS', 'NB'] },
];
const fmt = (n: number) => n.toLocaleString('en-US');
---
<section class="section" aria-labelledby="team-heading">
  <div class="sect-head reveal">
    <span class="sect-label">Project Management</span>
    <h2 id="team-heading">Project Teams &amp; Budgets. <span class="grad-text">Built for Production.</span></h2>
    <p>Project-level seats and isolated credit vaults &mdash; tailored for agencies, enterprise teams, and creator collaborations.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 reveal tb">
    <!-- Differentiator card -->
    <div class="lg:col-span-2 glass p-8 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute right-0 top-0 w-64 h-64 pointer-events-none"
        style="background:radial-gradient(ellipse at 100% 0%, rgba(249,115,22,0.1) 0%, transparent 70%);"></div>
      <div>
        <span class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[1.5px] text-[var(--accent)] mb-4">
          <span class="pulse-dot"></span> Only on 10zebra
        </span>
        <h3 class="text-2xl md:text-[1.75rem] font-extrabold leading-tight mb-3" style="font-family:var(--font-display);">
          Project Seats &amp; Budgets Hand-in-Hand
        </h3>
        <p class="text-[var(--text-secondary)] text-sm leading-relaxed mb-6">
          Traditional AI tools force expensive app-wide seats ($35&ndash;$100/mo) and pool credits into one vulnerable bucket. 10zebra scopes membership and budgets per project: invite clients, freelancers, and co-directors to specific productions with zero cross-client bleed or financial risk.
        </p>
      </div>
      <div class="flex gap-3 flex-wrap">
        <a href="/signup/index.html" class="btn btn-primary btn-lg" id="team-signup-btn">Start Free &mdash; 200 Credits</a>
        <a href="/features/project-management/index.html" class="btn btn-ghost btn-lg" id="team-learn-more-btn">Explore Project Management &rarr;</a>
      </div>
    </div>

    <!-- Budget visual -->
    <div class="lg:col-span-3 glass p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-semibold text-[var(--text-secondary)]">Active Production Projects</span>
        <span class="text-[0.65rem] font-bold uppercase tracking-[1px] px-2 py-1 rounded-md text-[#34d399] border border-[rgba(52,211,153,0.3)] bg-[rgba(52,211,153,0.08)]">Project-Level Seats &amp; Vaults</span>
      </div>
      <ul class="tb-list">
        {projects.map((p, i) => {
          const pct = Math.round((p.used / p.total) * 100);
          return (
            <li class="tb-row" style={`--d:${i * 120}ms`}>
              <MediaSlot slot={p.slot} class="tb-thumb" sizes="96px" widths={[96, 192]} hideTag />
              <div class="tb-main">
                <div class="tb-head">
                  <div class="min-w-0">
                    <div class="tb-name">{p.name}</div>
                    <div class="tb-client">{p.client}</div>
                  </div>
                  <div class="tb-team" aria-hidden="true">
                    {p.team.map((t) => <span>{t}</span>)}
                  </div>
                </div>
                <div class="tb-track"><span class="tb-fill" style={`--w:${pct}%; --c:${p.color};`}></span></div>
                <div class="tb-meta">
                  <span>{fmt(p.used)} / {fmt(p.total)} credits</span>
                  <span style={`color:${p.color}`}>{fmt(p.total - p.used)} left</span>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <!-- Perks -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-4 reveal">
    {perks.map((p) => (
      <div class="glass p-5">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-3"
          style="background:var(--accent-subtle); border:1px solid rgba(249,115,22,0.2);">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
            stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={p.iconPath}/>
          </svg>
        </div>
        <h4 class="font-bold text-sm mb-1" style="font-family:var(--font-display);">{p.title}</h4>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{p.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .tb-list { list-style: none; display: grid; gap: 0.75rem; }
  .tb-row {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }
  .tb-row :global(.tb-thumb) { width: 72px; height: 54px; border-radius: 8px; flex-shrink: 0; }
  .tb-main { flex: 1; min-width: 0; }
  .tb-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
  .tb-name { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tb-client { font-size: 0.7rem; color: var(--text-muted); }
  .tb-team { display: flex; flex-shrink: 0; }
  .tb-team span {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    margin-left: -6px;
    display: grid;
    place-items: center;
    font-size: 0.55rem;
    font-weight: 800;
    color: #0c0d10;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    box-shadow: 0 0 0 2px #17191e;
  }
  .tb-track { height: 6px; border-radius: 6px; background: rgba(255, 255, 255, 0.06); overflow: hidden; margin-bottom: 0.4rem; }
  .tb-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--c);
    box-shadow: 0 0 12px var(--c);
    transition: width 1.2s var(--ease-out);
    transition-delay: calc(var(--d) + 300ms);
  }
  .tb-row { --d: 0ms; }
  .tb.visible .tb-fill { width: var(--w); }
  .tb-meta { display: flex; justify-content: space-between; font: 600 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) {
    .tb-fill { transition: none; width: var(--w); }
  }
</style>