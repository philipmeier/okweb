---
// src/components/Pricing.astro
import { plans, creditPacks } from "/src/data/pricing";
import { totalFamilies, totalModels } from "/src/data/models";
import { featureGates } from "/src/data/config";

interface Props {
  includeAnnual?: boolean;
  isHero?: boolean;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  showEnterpriseBanner?: boolean;
  showFooterLinks?: boolean;
  idPrefix?: string;
}

const {
  includeAnnual = false,
  isHero = false,
  eyebrow = isHero
    ? featureGates.subscriptions
      ? "Transparent Multi-Model Pricing"
      : "Simple Pay-As-You-Go Pricing · No Subscription Required"
    : "Pricing",
  title = "Pay for What You Create. Nothing More.",
  subtitle = featureGates.subscriptions
    ? "Start free with 200 credits. No subscription needed — buy more when you need them, or subscribe for stacked discounts."
    : "Simple pay-as-you-go pricing with no subscription required. Start free with 200 credits, add team collaborators at no cost, and buy non-expiring credit packs only when you need them.",
  showEnterpriseBanner = isHero,
  showFooterLinks = !isHero,
  idPrefix = isHero ? "hero-pricing" : "home-pricing",
} = Astro.props;

const showSubscriptions = featureGates.subscriptions;
---

<section class={`pricing-section relative ${isHero ? 'pt-12 pb-16' : 'section'}`} aria-labelledby={`${idPrefix}-heading`}>
  {isHero && (
    <div
      class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] pointer-events-none rounded-full blur-[140px] opacity-25"
      style="background: radial-gradient(ellipse, var(--accent) 0%, rgba(251,191,36,0.3) 50%, transparent 80%);"
      aria-hidden="true"
    ></div>
  )}

  <div class={isHero ? "wrap relative z-10" : ""}>
    <!-- Section Header Block -->
    <div class="sect-head reveal mb-8">
      {isHero ? (
        <span class="badge mb-4">
          <span class="pulse-dot" aria-hidden="true"></span>
          {eyebrow}
        </span>
      ) : (
        <span class="sect-label">{eyebrow}</span>
      )}

      {isHero ? (
        <h1 id={`${idPrefix}-heading`} class="text-[clamp(2rem,4.5vw,3.25rem)] font-extrabold tracking-[-1px] leading-[1.1] mb-4">
          {showSubscriptions ? (
            <>Pay for What You Create. <span class="grad-text">Never What You Waste.</span></>
          ) : (
            <>Simple Pay-As-You-Go. <span class="grad-text">No Subscription Required.</span></>
          )}
        </h1>
      ) : (
        <h2 id={`${idPrefix}-heading`}>
          {showSubscriptions ? (
            <>Pay for What You Create. <span class="grad-text">Nothing More.</span></>
          ) : (
            <>Simple Pay-As-You-Go. <span class="grad-text">No Subscription Required.</span></>
          )}
        </h2>
      )}

      <p class="max-w-2xl mx-auto text-base md:text-lg text-[var(--text-secondary)] leading-relaxed">
        {subtitle}
      </p>
    </div>

    {showSubscriptions ? (
      <>
        <!-- Optional Annual Billing Toggle -->
        {includeAnnual && (
          <div class="flex items-center justify-center gap-3 mb-10 reveal">
            <span class="text-sm font-semibold text-[var(--text-secondary)]" id={`${idPrefix}-label-monthly`}>Monthly</span>
            <button
              type="button"
              id={`${idPrefix}-toggle`}
              role="switch"
              aria-checked="false"
              aria-label="Toggle between monthly and annual billing"
              class="relative inline-flex h-7 w-14 shrink-0 cursor-pointer rounded-full border-2 border-[var(--border-subtle)] bg-[var(--bg-elevated)] p-0.5 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
            >
              <span
                id={`${idPrefix}-thumb`}
                class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-[var(--accent)] shadow-md transition duration-200 ease-in-out translate-x-0"
              ></span>
            </button>
            <span class="text-sm font-semibold text-[var(--text-primary)] flex items-center gap-2" id={`${idPrefix}-label-annual`}>
              Annual
              <span class="text-[0.7rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                Save 20% &middot; 2 Mo Free
              </span>
            </span>
          </div>
        )}

        <!-- Plan Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch reveal pt-3">
          {plans.map((p) => {
            const cardId = `${idPrefix}-${p.id}`;
            return (
              <div
                class={`glass relative flex flex-col p-8 transition-all duration-300 hover:-translate-y-1.5 ${
                  p.featured ? "border-[var(--accent)] glow-border" : "border-[var(--border-subtle)] hover:border-[var(--border-strong)]"
                }`}
                id={cardId}
                style={p.featured ? "background: linear-gradient(180deg, rgba(249,115,22,0.06) 0%, rgba(26,28,33,0.7) 35%);" : ""}
              >
                {p.featured && (
                  <div
                    class="absolute -top-[12px] right-6 z-10 text-[0.65rem] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-lg"
                    style="background: linear-gradient(135deg, var(--accent), var(--accent-secondary)); color:#0c0d10;"
                  >
                    {p.badge || "Most Popular"}
                  </div>
                )}

                <div class="mb-5">
                  <span class={`text-[0.72rem] uppercase tracking-wider font-bold block mb-1 ${p.featured ? 'text-[var(--accent)]' : 'text-[var(--text-muted)]'}`}>
                    {p.kicker}
                  </span>
                  <h3 class="text-2xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
                    {p.name}
                  </h3>
                  <p class="text-sm text-[var(--text-muted)] mt-1 min-h-[40px]">
                    {p.desc}
                  </p>
                </div>

                <div class="mb-4">
                  <div class="flex items-baseline gap-1">
                    <span
                      class="plan-price-val text-4xl lg:text-5xl font-extrabold text-[var(--text-primary)] tracking-tight transition-all duration-200"
                      style="font-family:var(--font-display);"
                      data-monthly={p.price}
                      data-annual={p.annualPrice}
                    >
                      {p.price}
                    </span>
                    <span class="text-sm text-[var(--text-muted)] font-medium">{p.period}</span>
                  </div>

                  {includeAnnual && (
                    <span class="plan-billed-note text-xs text-[var(--accent)] font-medium mt-1 block h-4">
                      {p.id === 'payg' ? '' : 'Billed monthly'}
                    </span>
                  )}

                  <span class="text-xs font-semibold text-emerald-400 mt-1 block">
                    {p.credit}
                  </span>
                  <span class="text-xs text-[var(--text-muted)] mt-0.5 block">
                    {p.approx}
                  </span>
                </div>

                <div class="h-px bg-[var(--border-subtle)] my-5"></div>

                <ul class="feat-list flex-1 mb-6 space-y-3">
                  {p.features.map((f) => (
                    <li>
                      <span class="check-icon">&#10003;</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={p.ctaHref}
                  class={`btn ${p.btnClass} btn-full py-3 ${p.featured ? 'text-sm font-bold shadow-lg' : ''}`}
                  id={`${cardId}-cta`}
                >
                  {p.cta}
                </a>
                <p class="text-[0.72rem] text-center text-[var(--text-muted)] mt-2.5">
                  {p.id === 'payg' ? 'No credit card required' : p.id === 'maker' ? '2 team seats/project · Cancel anytime' : 'Unlimited team seats & project pools'}
                </p>
              </div>
            );
          })}
        </div>
      </>
    ) : (
      /* Streamlined Pay-As-You-Go Showcase (When Subscriptions Gate is Off) */
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch reveal pt-2">
        <!-- Left: Free Starter + Full Studio Unlock Card -->
        <div
          class="lg:col-span-5 glass relative flex flex-col justify-between p-8 border-[var(--accent)] glow-border"
          id={`${idPrefix}-payg`}
          style="background: linear-gradient(180deg, rgba(249,115,22,0.08) 0%, rgba(26,28,33,0.8) 45%);"
        >
          <div
            class="absolute -top-[12px] right-6 z-10 text-[0.65rem] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-lg"
            style="background: linear-gradient(135deg, var(--accent), var(--accent-secondary)); color:#0c0d10;"
          >
            No Subscription Required
          </div>

          <div>
            <span class="text-[0.72rem] uppercase tracking-wider font-bold block mb-1 text-[var(--accent)]">
              Zero Monthly Commitment
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]" style="font-family:var(--font-display);">
              Pay-As-You-Go Studio
            </h3>
            <p class="text-sm text-[var(--text-secondary)] mt-1.5 leading-relaxed">
              Every feature, AI model, and collaborative workflow unlocked from day one. Start with 200 free credits and top up only when you direct.
            </p>

            <div class="mt-5 mb-5 p-4 rounded-xl bg-[rgba(12,13,16,0.65)] border border-[var(--border-subtle)] flex items-baseline justify-between gap-4">
              <div>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl font-extrabold text-[var(--text-primary)]" style="font-family:var(--font-display);">$0</span>
                  <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold">To Start Free</span>
                </div>
                <span class="text-xs text-[var(--text-muted)] block mt-0.5">Includes 200 free signup credits</span>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-[var(--accent)] block">Top-Ups From $10</span>
                <span class="text-[11px] text-[var(--text-muted)] block">Credits never expire</span>
              </div>
            </div>

            <ul class="feat-list space-y-2.5 mb-6">
              <li>
                <span class="check-icon">&#10003;</span>
                <span><strong>200 Free Credits</strong> on signup (no credit card needed)</span>
              </li>
              <li>
                <span class="check-icon">&#10003;</span>
                <span>All <strong>{totalFamilies} model families ({totalModels}+ engines)</strong>: Kling, Veo, Sora, Runway &amp; more</span>
              </li>
              <li>
                <span class="check-icon">&#10003;</span>
                <span><strong>Team collaborators at no cost</strong> ($0/seat) + per-member credit budgets</span>
              </li>
              <li>
                <span class="check-icon">&#10003;</span>
                <span><strong>Hybrid Production:</strong> combine live-action footage &amp; AI styles</span>
              </li>
              <li>
                <span class="check-icon">&#10003;</span>
                <span><strong>Quick Start &amp; Scene Extension</strong> workflow tools included</span>
              </li>
              <li>
                <span class="check-icon">&#10003;</span>
                <span><strong>Purchased credits never expire</strong> — zero monthly forfeiture</span>
              </li>
            </ul>
          </div>

          <div>
            <a
              href="/signup/index.html"
              class="btn btn-primary btn-full py-3.5 text-sm font-bold shadow-lg"
              id={`${idPrefix}-payg-cta`}
            >
              Start Free — 200 Credits &rarr;
            </a>
            <p class="text-[0.72rem] text-center text-[var(--text-muted)] mt-2.5">
              No credit card required &middot; Full commercial rights included
            </p>
          </div>
        </div>

        <!-- Right: Non-Expiring Credit Top-Up Packs -->
        <div class="lg:col-span-7 flex flex-col justify-between gap-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 flex-1">
            {creditPacks.map((pack) => (
              <div
                class={`glass p-5 flex flex-col justify-between relative transition-all duration-200 hover:-translate-y-1 ${
                  pack.popular ? 'border-[var(--accent)] ring-1 ring-[var(--accent)]/30' : 'border-[var(--border-subtle)]'
                }`}
              >
                {pack.popular && (
                  <span
                    class="absolute -top-2.5 right-4 text-[0.62rem] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider"
                    style="background: linear-gradient(135deg, var(--accent), var(--accent-secondary)); color:#0c0d10;"
                  >
                    Most Popular
                  </span>
                )}
                <div>
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">{pack.name}</span>
                    <span class="text-xs font-mono text-emerald-400 font-semibold">{pack.unitPrice}</span>
                  </div>
                  <div class="flex items-baseline justify-between gap-2 my-2">
                    <div>
                      <span class="text-2xl sm:text-3xl font-extrabold text-[var(--accent)]" style="font-family:var(--font-display);">
                        {pack.credits}
                      </span>
                      <span class="text-xs font-semibold text-[var(--text-secondary)] ml-1">credits</span>
                    </div>
                    <span class="text-2xl font-extrabold text-[var(--text-primary)]" style="font-family:var(--font-display);">
                      {pack.basePrice}
                    </span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-1">{pack.approx}</p>
                </div>

                <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-muted)]">
                  <span>{pack.idealFor}</span>
                  <span class="text-emerald-400 font-semibold">Never expires</span>
                </div>
              </div>
            ))}
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--text-secondary)]">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
              <span>
                <strong>Pay only for what you generate:</strong> Invite co-directors, editors, and client reviewers to your projects for free, and top up credits anytime with one click.
              </span>
            </div>
            <a href="/pricing/index.html#rates" class="text-[var(--accent)] font-semibold hover:underline shrink-0">
              See Model Rate Card &rarr;
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Optional Referral Callout (Only when referralProgram gate is true) -->
    {featureGates.referralProgram && (
      <div class="mt-8 reveal">
        <a href="/features/referral-program/index.html" class="p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] hover:border-[var(--accent)] transition-colors flex items-start gap-3.5 group">
          <span class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold shrink-0 text-sm">3%</span>
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-emerald-400">Referral Program &middot; Powered by Tolt</div>
            <h3 class="text-sm font-bold text-[var(--text-primary)] mt-0.5 group-hover:text-[var(--accent)] transition-colors">Earn a 3% Lifetime Payout &rarr;</h3>
            <p class="text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">
              Share your unique referral code. Get paid 3% for life whenever referred creators or studios purchase credit packs or subscribe.
            </p>
          </div>
        </a>
      </div>
    )}

    <!-- Optional Enterprise / Studio Callout Banner -->
    {showEnterpriseBanner && (
      <div
        class="mt-10 p-6 md:p-8 rounded-2xl border border-[var(--border-subtle)] flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden reveal"
        style="background: linear-gradient(135deg, rgba(26,28,33,0.85) 0%, rgba(19,20,23,0.95) 100%);"
        id={`${idPrefix}-enterprise`}
      >
        <div class="space-y-1.5 text-center md:text-left">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
            <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
            Studio &amp; Enterprise
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            Directing at Studio Scale or Need Custom Cloud Pipelines?
          </h3>
          <p class="text-sm text-[var(--text-secondary)] max-w-2xl leading-relaxed">
            Get custom pooled credit volume, dedicated Slack channel with 10zebra engineers, SAML/SSO authentication, custom model fine-tuning, and SLA guarantees for production deadlines.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
          <a href="mailto:sales@10zebra.com?subject=Studio%20%26%20Enterprise%20Inquiry" class="btn btn-primary" id={`${idPrefix}-enterprise-contact`}>
            Talk to Production Sales
          </a>
          <a href="/demo/index.html" class="btn btn-ghost" id={`${idPrefix}-enterprise-demo`}>
            Book 1-on-1 Demo
          </a>
        </div>
      </div>
    )}

    <!-- Optional Footer Links (for Homepage) -->
    {showFooterLinks && (
      <div class="mt-12 text-center reveal space-y-3">
        <div class="flex flex-wrap items-center justify-center gap-4 text-sm font-semibold">
          <a href="/pricing/index.html#calculator" class="text-[var(--accent)] hover:underline inline-flex items-center gap-1.5">
            <span>Interactive Credit Estimator &amp; Model Rate Card</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <span class="text-[var(--border-strong)] hidden sm:inline">&middot;</span>
          <a href="/pricing/index.html#top-ups" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5">
            <span>View Never-Expiring Top-Up Packs</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          {showSubscriptions && (
            <>
              <span class="text-[var(--border-strong)] hidden sm:inline">&middot;</span>
              <a href="/pricing/index.html#comparison" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5">
                <span>Full Feature Comparison Matrix</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </>
          )}
        </div>
        <p class="text-xs text-[var(--text-muted)]">
          Producing at studio scale or need pooled enterprise infrastructure?{" "}
          <a href="/pricing/index.html#enterprise" class="text-[var(--text-secondary)] hover:text-[var(--accent)] underline">
            Explore Studio &amp; Enterprise options
          </a>
        </p>
      </div>
    )}
  </div>
</section>

{showSubscriptions && includeAnnual && (
  <script define:vars={{ idPrefix }}>
    const toggle = document.getElementById(`${idPrefix}-toggle`);
    const thumb = document.getElementById(`${idPrefix}-thumb`);
    const priceEls = document.querySelectorAll(`#${idPrefix}-payg .plan-price-val, #${idPrefix}-maker .plan-price-val, #${idPrefix}-director .plan-price-val`);
    const makerBilled = document.querySelector(`#${idPrefix}-maker .plan-billed-note`);
    const directorBilled = document.querySelector(`#${idPrefix}-director .plan-billed-note`);

    let isAnnual = false;

    toggle?.addEventListener("click", () => {
      isAnnual = !isAnnual;
      toggle.setAttribute("aria-checked", isAnnual ? "true" : "false");

      if (isAnnual) {
        thumb?.classList.remove("translate-x-0");
        thumb?.classList.add("translate-x-7");

        priceEls.forEach((el) => {
          const annual = el.getAttribute("data-annual");
          if (annual) el.textContent = annual;
        });

        if (makerBilled) makerBilled.textContent = "Billed annually ($276/yr) — Save $72";
        if (directorBilled) directorBilled.textContent = "Billed annually ($756/yr) — Save $192";
      } else {
        thumb?.classList.remove("translate-x-7");
        thumb?.classList.add("translate-x-0");

        priceEls.forEach((el) => {
          const monthly = el.getAttribute("data-monthly");
          if (monthly) el.textContent = monthly;
        });

        if (makerBilled) makerBilled.textContent = "Billed monthly ($29)";
        if (directorBilled) directorBilled.textContent = "Billed monthly ($79)";
      }
    });
  </script>
)}