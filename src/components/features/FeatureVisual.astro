---
/**
 * FeatureVisual — renders a feature's imagery from src/data/features.ts.
 *  - gallery of 4 → 2×2 grid (e.g. same prompt across 4 models)
 *  - gallery of 3 → filmstrip (e.g. wide → medium → close)
 *  - otherwise   → single media slot
 * Fills its parent; size it from the outside (aspect-ratio or absolute inset).
 */
import MediaSlot from '/src/components/MediaSlot.astro';
import type { FeatureRef } from '/src/data/features';

interface Props {
  feature: FeatureRef;
  class?: string;
  sizes?: string;
  eager?: boolean;
  hideTag?: boolean;
  /** Force a single image even if a gallery exists (e.g. blurred backdrops). */
  single?: boolean;
  /** Show gallery labels (model names / shot sizes). */
  labels?: boolean;
}

const {
  feature,
  class: className = '',
  sizes = '(max-width: 900px) 100vw, 50vw',
  eager = false,
  hideTag = false,
  single = false,
  labels = true,
} = Astro.props;

const gallery = !single && feature.gallery && feature.gallery.length >= 3 ? feature.gallery : null;
const layout = gallery ? (gallery.length >= 4 ? 'quad' : 'strip') : 'single';
const cellSizes = layout === 'quad' ? '(max-width: 900px) 50vw, 25vw' : '(max-width: 900px) 33vw, 18vw';
---

<div class:list={['fv', `fv--${layout}`, className]}>
  {gallery ? (
    gallery.slice(0, layout === 'quad' ? 4 : 3).map((g, i) => (
      <div class="fv__cell" style={`--i:${i}`}>
        <MediaSlot slot={g.slot} class="fv__fill" sizes={cellSizes} widths={[320, 640]} eager={eager} hideTag={hideTag || i > 0} />
        {labels && <span class="fv__label">{g.label}</span>}
      </div>
    ))
  ) : (
    <MediaSlot slot={feature.media} class="fv__fill" sizes={sizes} widths={[480, 800, 1280, 1920]} eager={eager} hideTag={hideTag} />
  )}
</div>

<style>
  .fv { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--bg-elevated); }
  .fv :global(.fv__fill) { position: absolute; inset: 0; }
  .fv--quad { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 3px; background: #07080a; }
  .fv--strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; background: #07080a; }
  .fv__cell { position: relative; overflow: hidden; }
  .fv__label {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    font: 700 0.62rem/1 var(--font-body);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #fff;
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    background: rgba(12, 13, 16, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
  }
  /* First cell in a quad reads as the "picked" take */
  .fv--quad .fv__cell:first-child::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 2px solid var(--accent);
    pointer-events: none;
  }
  .fv--quad .fv__cell:first-child .fv__label { background: var(--accent); color: #0c0d10; border-color: transparent; }
</style>
