---
---

<div class="youtube-export-mockup w-full rounded-xl overflow-hidden bg-[#0e1014] border border-[var(--border-subtle)] shadow-2xl">
  <!-- Top bar -->
  <div class="bg-[#16181e] px-4 py-3 border-b border-[var(--border-subtle)] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      <span class="text-xs font-mono text-[var(--text-muted)] ml-2">Export Engine &middot; YouTube Direct Publisher</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        YouTube OAuth Connected
      </span>
    </div>
  </div>

  <div class="p-4 sm:p-6 bg-[#0a0b0e]">
    <!-- Storyboard Sequence Timeline Strip -->
    <div class="mb-5 rounded-xl border border-[var(--border-subtle)] bg-[#14161c] p-4">
      <div class="flex items-center justify-between mb-3 text-xs">
        <span class="font-mono text-[var(--text-secondary)] uppercase tracking-wider font-semibold">
          Final Sequence Assembly (4 Shots &middot; 00:32 Total Duration)
        </span>
        <span class="text-xs text-[var(--accent)] font-semibold">1080p 60fps &middot; Master Audio Mastered</span>
      </div>

      <!-- Shot timeline cards -->
      <div class="grid grid-cols-4 gap-2 mb-3">
        <div class="rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-black/60 relative group">
          <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?w=240&h=135&fit=crop&q=80" alt="Shot 1" class="w-full aspect-video object-cover"/>
          <div class="p-1.5 text-[10px] bg-[#101216] flex justify-between items-center">
            <span class="font-mono text-white/90">01: Hook</span>
            <span class="text-[var(--accent)]">0:06</span>
          </div>
        </div>
        <div class="rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-black/60 relative group">
          <img src="https://images.unsplash.com/photo-1536240478700-b869070f9279?w=240&h=135&fit=crop&q=80" alt="Shot 2" class="w-full aspect-video object-cover"/>
          <div class="p-1.5 text-[10px] bg-[#101216] flex justify-between items-center">
            <span class="font-mono text-white/90">02: Wide</span>
            <span class="text-[var(--accent)]">0:08</span>
          </div>
        </div>
        <div class="rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-black/60 relative group">
          <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=240&h=135&fit=crop&q=80" alt="Shot 3" class="w-full aspect-video object-cover"/>
          <div class="p-1.5 text-[10px] bg-[#101216] flex justify-between items-center">
            <span class="font-mono text-white/90">03: Action</span>
            <span class="text-[var(--accent)]">0:10</span>
          </div>
        </div>
        <div class="rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-black/60 relative group">
          <img src="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=240&h=135&fit=crop&q=80" alt="Shot 4" class="w-full aspect-video object-cover"/>
          <div class="p-1.5 text-[10px] bg-[#101216] flex justify-between items-center">
            <span class="font-mono text-white/90">04: Payoff</span>
            <span class="text-[var(--accent)]">0:08</span>
          </div>
        </div>
      </div>

      <!-- Audio Track Strip -->
      <div class="h-8 rounded bg-[#0d0f14] border border-[var(--border-subtle)] flex items-center px-3 justify-between text-[11px]">
        <div class="flex items-center gap-2 text-sky-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
          </svg>
          <span class="font-mono">audio_cinematic_score_mixdown.wav</span>
        </div>
        <span class="text-xs text-[var(--text-muted)] font-mono">Ducked under SFX</span>
      </div>
    </div>

    <!-- YouTube Publishing Modal / Metadata Panel -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 rounded-xl border border-rose-500/20 bg-[#121418] p-5">
      <div class="md:col-span-8 space-y-3">
        <div>
          <label class="block text-[11px] font-mono uppercase text-[var(--text-muted)] mb-1">Video Title</label>
          <input 
            type="text" 
            readonly 
            value="The Neon Courier | Official 4K Cinematic Trailer (AI Generated)" 
            class="w-full px-3 py-2 rounded-lg bg-[#0e1014] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] font-medium"
          />
        </div>

        <div>
          <label class="block text-[11px] font-mono uppercase text-[var(--text-muted)] mb-1">Description &amp; Model Attribution</label>
          <textarea 
            readonly 
            rows="2" 
            class="w-full px-3 py-2 rounded-lg bg-[#0e1014] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] font-mono"
          >Created entirely inside 10zebra. Shots rendered across Kling 3.0, Grok, and SeeDance. Character locked with 10zebra reference engine.</textarea>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <div>
            <label class="block text-[10px] font-mono uppercase text-[var(--text-muted)] mb-1">Privacy Status</label>
            <span class="px-3 py-1.5 rounded-lg bg-[#0e1014] border border-[var(--border-subtle)] block text-[var(--text-primary)]">
              Unlisted (Client Review)
            </span>
          </div>
          <div>
            <label class="block text-[10px] font-mono uppercase text-[var(--text-muted)] mb-1">Category</label>
            <span class="px-3 py-1.5 rounded-lg bg-[#0e1014] border border-[var(--border-subtle)] block text-[var(--text-primary)]">
              Film &amp; Animation
            </span>
          </div>
        </div>
      </div>

      <div class="md:col-span-4 flex flex-col justify-between items-center text-center p-3 rounded-xl bg-black/40 border border-white/5">
        <div class="w-full">
          <div class="text-[10px] font-mono uppercase text-[var(--text-muted)] mb-2">Publish Target</div>
          <div class="w-12 h-12 rounded-full bg-rose-600/20 border border-rose-500/40 flex items-center justify-center text-rose-500 mx-auto mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-[var(--text-primary)]">Studio Channel</div>
          <div class="text-[10px] text-[var(--text-muted)]">OAuth Token Active</div>
        </div>

        <button class="w-full py-2.5 px-4 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-rose-600/20 transition-all mt-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z"/>
          </svg>
          Publish Directly to YouTube
        </button>
      </div>
    </div>
  </div>

  <div class="bg-[#121418] px-4 py-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
    <span>Zero manual downloading, exporting, or re-uploading required.</span>
    <span class="text-emerald-400 font-semibold">Direct Cloud Render &rarr; YouTube Ingest</span>
  </div>
</div>
