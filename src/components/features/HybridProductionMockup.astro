---
import livePlateImg from '/src/assets/media/features/hybrid-live-plate-1970s.jpg';
import stylizedTakeImg from '/src/assets/media/features/hybrid-stylized-take-1970s.jpg';
import splitHeroImg from '/src/assets/media/features/hybrid-production-1970s.jpg';
import refPortraitImg from '/src/assets/media/character-reference-1970s.jpg';
---

<div class="hybrid-production-mockup w-full rounded-xl overflow-hidden bg-[#0e1014] border border-[var(--border-subtle)] shadow-2xl">
  <!-- Top Window Bar -->
  <div class="bg-[#16181e] px-4 py-3 border-b border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      <span class="text-xs font-mono text-[var(--text-muted)] ml-2">
        Hybrid Production Studio &middot; Live-Action Plate + AI Transformation
      </span>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
        Auto Shot Split: 6 Panels
      </span>
      <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        Live + AI Active
      </span>
    </div>
  </div>

  <!-- Main 3-Column Comparison Pipeline -->
  <div class="p-4 sm:p-6 grid grid-cols-1 md:grid-cols-12 gap-5 items-stretch bg-[#0a0b0e]">
    <!-- Column 1: Raw Live-Action Camera Plate -->
    <div class="md:col-span-4 rounded-xl border border-cyan-500/30 bg-[#12161d] p-3.5 flex flex-col justify-between text-left">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-cyan-300 font-bold">
            01 &middot; Live-Action Plate
          </span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-200 border border-cyan-500/30">
            Uploaded .MP4 / .MOV
          </span>
        </div>
        <div class="relative aspect-video rounded-lg overflow-hidden mb-3 bg-black border border-white/10">
          <img
            src={livePlateImg.src}
            alt="1970s behind-the-scenes live-action camera rig filming a stunt actor in a stationary cockpit buck"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 left-2 text-[10px] font-mono bg-black/80 px-2 py-0.5 rounded text-cyan-300 border border-cyan-500/30">
            RAW CAMERA PLATE &middot; 24fps
          </div>
          <div class="absolute bottom-2 left-2 text-[10px] font-mono bg-black/80 px-2 py-0.5 rounded text-white/90">
            Stunt Driver / Soundstage Buck
          </div>
        </div>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          Upload real camera footage, rehearsal blocking, or B-roll. 10zebra automatically detects cuts and turns every shot into a storyboard panel.
        </p>
      </div>
      <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
        <span>Camera Motion &amp; Timing</span>
        <span class="text-emerald-400 font-bold">100% Locked</span>
      </div>
    </div>

    <!-- Column 2: AI Style & Character Transformation Controls -->
    <div class="md:col-span-4 rounded-xl border border-[var(--border-subtle)] bg-[#14161c] p-3.5 flex flex-col justify-between text-left">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] font-bold">
            02 &middot; AI Restyle + Recast
          </span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/5 text-[var(--text-secondary)]">
            vid2vid + Multi-Ref
          </span>
        </div>

        <!-- Split Preview Banner -->
        <div class="relative aspect-video rounded-lg overflow-hidden mb-3 bg-black border border-[var(--accent)]/40">
          <img
            src={splitHeroImg.src}
            alt="Split-screen transition from live-action studio cockpit buck to stylized 1970s Le Mans night race"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-y-0 left-1/2 w-0.5 bg-[var(--accent)] shadow-[0_0_10px_#f97316]"></div>
          <div class="absolute bottom-2 inset-x-2 flex items-center justify-between text-[10px] font-mono">
            <span class="bg-black/80 px-1.5 py-0.5 rounded text-cyan-300">Live Plate</span>
            <span class="bg-black/80 px-1.5 py-0.5 rounded text-amber-300">AI Restyled</span>
          </div>
        </div>

        <!-- Anchor + Prompt Controls -->
        <div class="flex items-center gap-2.5 p-2 rounded-lg bg-[#0c0e12] border border-[var(--border-subtle)] mb-2">
          <img
            src={refPortraitImg.src}
            alt="Elena Vance character reference anchor"
            class="w-10 h-10 rounded-lg object-cover border border-[var(--accent)] shrink-0"
          />
          <div class="min-w-0">
            <div class="text-[11px] font-bold text-[var(--text-primary)] truncate">
              Actor Swap: Elena Vance
            </div>
            <div class="text-[10px] text-[var(--text-muted)] truncate">
              + Style: 1970s Le Mans Night Rain
            </div>
          </div>
        </div>
      </div>

      <div class="p-2 rounded-lg bg-[var(--accent-subtle)] border border-[rgba(249,115,22,0.3)] text-[11px] text-[var(--text-secondary)]">
        <strong class="text-[var(--text-primary)]">Transform or Intercut:</strong> Restyle real plates with AI visuals, swap actors, or cut raw camera shots beside AI takes.
      </div>
    </div>

    <!-- Column 3: Resulting AI-Transformed Output Take -->
    <div class="md:col-span-4 rounded-xl border border-[var(--accent)] ring-1 ring-[var(--accent)]/50 bg-[#14161c] p-3.5 flex flex-col justify-between text-left">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--accent)] font-bold">
            03 &middot; Hybrid Final Take
          </span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-[var(--accent)] text-[#0c0d10] font-black">
            Cinema Output
          </span>
        </div>
        <div class="relative aspect-video rounded-lg overflow-hidden mb-3 bg-black">
          <img
            src={stylizedTakeImg.src}
            alt="AI-transformed 1970s Le Mans night endurance race with Elena Vance in the #10 prototype"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 right-2 text-[10px] font-bold bg-emerald-500 text-black px-1.5 py-0.5 rounded">
            Performance Preserved ✓
          </div>
          <div class="absolute bottom-2 left-2 text-[10px] font-mono bg-black/80 px-2 py-0.5 rounded text-amber-300">
            Elena Vance &middot; #10 Le Mans Night Circuit
          </div>
        </div>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          The actor's real steering performance and camera framing are preserved while the soundstage transforms into a rain-slicked 1970s night circuit.
        </p>
      </div>
      <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
        <span>Timeline Assembly</span>
        <span class="text-amber-400 font-bold">Live + AI Ready</span>
      </div>
    </div>
  </div>

  <!-- Bottom Timeline Strip -->
  <div class="bg-[#121418] px-4 py-3 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2 text-[var(--text-secondary)]">
      <span class="text-amber-400">★</span>
      <span>
        <strong>Unified Hybrid Storyboard:</strong> Import full videos into panels, transform live performances with AI styles, and cut real camera footage right alongside Kling, Veo, and Sora takes.
      </span>
    </div>
    <span class="px-2.5 py-1 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] font-mono text-[11px] shrink-0">
      vid2vid &middot; Swap &middot; Splice
    </span>
  </div>
</div>

