---
// src/components/features/AgenticWorkflowsMockup.astro
---

<div class="agent-z-mockup w-full rounded-xl overflow-hidden bg-[#0e1014] border border-[var(--border-subtle)] shadow-2xl text-left">
  <!-- Window Top Bar -->
  <div class="bg-[#16181e] px-4 py-3 border-b border-[var(--border-subtle)] flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      <span class="text-xs font-mono text-[var(--text-muted)] ml-2">Agent Z &middot; Autonomous Batch Pipeline &amp; Dry Run Planner</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Dry Run Complete &middot; Awaiting Approval
      </span>
    </div>
  </div>

  <!-- Main Workspace Grid -->
  <div class="p-4 sm:p-5 grid grid-cols-1 lg:grid-cols-12 gap-5 bg-[#0a0b0e]">
    <!-- Left Column: Agent Z Batch Command & Capabilities -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
      <!-- Agent Z Identity Card -->
      <div class="rounded-xl border border-[rgba(249,115,22,0.35)] bg-[#13151b] p-3.5 relative overflow-hidden">
        <div class="flex items-center gap-3 mb-2.5">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center font-display font-black text-sm text-[#0c0d10] shrink-0 shadow-lg" style="background: linear-gradient(135deg, var(--accent), var(--accent-secondary));">
            Z
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white tracking-tight">Agent Z</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[var(--accent-subtle)] text-[var(--accent)] border border-[rgba(249,115,22,0.3)]">10zebra Agent</span>
            </div>
            <div class="text-[11px] text-[var(--text-muted)]">Project Storyboard Orchestrator</div>
          </div>
        </div>

        <div class="p-2.5 rounded-lg bg-[#0b0c10] border border-[var(--border-subtle)] text-[11px] text-[var(--text-secondary)] font-mono leading-relaxed">
          <span class="text-[var(--accent)] font-bold">&gt; Directive:</span> "Across Scenes 1&ndash;3: batch create 4 establishing shots, batch replace Lead Actor with <span class="text-amber-300">@Elena_Anchor</span>, convert 4 takes to 9:16, regen 2 flagged takes, and batch upscale finals to 4K."
        </div>
      </div>

      <!-- Batch Modes Selector -->
      <div class="rounded-xl border border-[var(--border-subtle)] bg-[#13151b] p-3.5">
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)] font-bold">Batch Capabilities Engaged</span>
          <span class="text-[10px] text-emerald-400 font-mono">5 / 5 Active</span>
        </div>

        <div class="grid grid-cols-1 gap-1.5 text-xs">
          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              <span class="font-semibold text-white text-[11px]">Batch Create</span>
            </div>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">Multi-shot scene fanout</span>
          </div>

          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-[var(--accent-subtle)] border border-[rgba(249,115,22,0.3)]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              <span class="font-semibold text-[var(--accent)] text-[11px]">Batch Replace Characters</span>
            </div>
            <span class="text-[10px] text-amber-300 font-mono">Project-wide face/motion lock</span>
          </div>

          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
              <span class="font-semibold text-white text-[11px]">Batch Convert</span>
            </div>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">Aspect ratio &amp; vid2vid restyle</span>
          </div>

          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
              <span class="font-semibold text-white text-[11px]">Batch Regen</span>
            </div>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">Re-roll takes &amp; model fallback</span>
          </div>

          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span class="font-semibold text-white text-[11px]">Batch Upscale</span>
            </div>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">Parallel 4K UHD detail pass</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Dry Run Analysis Plan, Credit Cost & Approval Gate -->
    <div class="lg:col-span-7 rounded-xl border border-[var(--border-subtle)] bg-[#13151b] p-4 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-[var(--border-subtle)]">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white uppercase tracking-wider font-mono">Dry Run Analysis</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-mono font-bold">0 Credits Charged Yet</span>
            </div>
            <p class="text-[11px] text-[var(--text-muted)] mt-0.5">
              Agent Z simulated 22 operations across 3 scenes. Review the itemized execution plan and credit cost below.
            </p>
          </div>
        </div>

        <!-- Dry Run Plan Table -->
        <div class="space-y-2 mb-4">
          <div class="grid grid-cols-12 items-center px-3 py-2 rounded-lg bg-[#0b0c10] border border-[var(--border-subtle)] text-[11px]">
            <div class="col-span-6">
              <span class="font-bold text-white block">01. Batch Create Shots</span>
              <span class="text-[10px] text-[var(--text-muted)]">4 new establishing shots &middot; Google Veo 3 Fast</span>
            </div>
            <div class="col-span-3 text-right font-mono text-[var(--text-secondary)]">4 &times; 20 cr</div>
            <div class="col-span-3 text-right font-mono font-bold text-white">80 cr</div>
          </div>

          <div class="grid grid-cols-12 items-center px-3 py-2 rounded-lg bg-[rgba(249,115,22,0.07)] border border-[rgba(249,115,22,0.28)] text-[11px]">
            <div class="col-span-6">
              <span class="font-bold text-[var(--accent)] block">02. Batch Replace Characters</span>
              <span class="text-[10px] text-[var(--text-secondary)]">8 takes swapped to @Elena_Anchor &middot; Motion Locked</span>
            </div>
            <div class="col-span-3 text-right font-mono text-[var(--text-secondary)]">8 &times; 15 cr</div>
            <div class="col-span-3 text-right font-mono font-bold text-[var(--accent)]">120 cr</div>
          </div>

          <div class="grid grid-cols-12 items-center px-3 py-2 rounded-lg bg-[#0b0c10] border border-[var(--border-subtle)] text-[11px]">
            <div class="col-span-6">
              <span class="font-bold text-white block">03. Batch Convert &amp; Regen</span>
              <span class="text-[10px] text-[var(--text-muted)]">4 takes reframed (9:16) + 2 regens &middot; Kling 3.0</span>
            </div>
            <div class="col-span-3 text-right font-mono text-[var(--text-secondary)]">6 &times; 25 cr</div>
            <div class="col-span-3 text-right font-mono font-bold text-white">150 cr</div>
          </div>

          <div class="grid grid-cols-12 items-center px-3 py-2 rounded-lg bg-[#0b0c10] border border-[var(--border-subtle)] text-[11px]">
            <div class="col-span-6">
              <span class="font-bold text-white block">04. Batch Upscale to 4K</span>
              <span class="text-[10px] text-[var(--text-muted)]">4 hero timeline cuts &middot; 4K AI Detail Enhancer</span>
            </div>
            <div class="col-span-3 text-right font-mono text-[var(--text-secondary)]">4 &times; 15 cr</div>
            <div class="col-span-3 text-right font-mono font-bold text-white">60 cr</div>
          </div>
        </div>
      </div>

      <!-- Cost Summary & Approval Bar -->
      <div class="rounded-xl bg-[#0b0c10] border border-[var(--border-subtle)] p-3.5">
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-[var(--border-subtle)]">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)] block">Estimated Batch Cost</span>
            <div class="flex items-baseline gap-2">
              <span class="text-xl font-black font-mono text-white">410 Credits</span>
              <span class="text-[11px] text-emerald-400 font-mono">(&#10003; Within Project Cap: 1,850 cr avail)</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)] block">Safety Guarantees</span>
            <span class="text-[11px] text-[var(--text-secondary)]">Non-destructive &middot; 90% refund || free regen on fails</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="px-3 py-1.5 rounded-lg bg-white/[0.04] border border-[var(--border-subtle)] text-[11px] font-semibold text-[var(--text-secondary)]">
            Modify Selection (22 Takes)
          </span>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-lg bg-rose-500/10 border border-rose-500/25 text-[11px] font-semibold text-rose-300">
              Cancel Dry Run
            </span>
            <span class="px-4 py-1.5 rounded-lg text-[11px] font-black text-[#0c0d10] shadow-lg" style="background: linear-gradient(135deg, var(--accent), var(--accent-secondary));">
              &#10003; Approve &amp; Execute Plan (410 cr)
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

