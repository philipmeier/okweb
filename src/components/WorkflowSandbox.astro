---
import seq1 from '/src/assets/media/solutions/film-breakdown-1970s.jpg';
import seq2 from '/src/assets/media/solutions/film-cast-1970s.jpg';
import seq3 from '/src/assets/media/solutions/film-plates-1970s.jpg';
import swap1 from '/src/assets/media/solutions/cd-explore-1970s.jpg';
import swap2 from '/src/assets/media/character-reference-1970s.jpg';
import swap3 from '/src/assets/media/features/character-swap-1970s.jpg';
import ref1 from '/src/assets/media/character-reference-1970s.jpg';
import ref2 from '/src/assets/media/features/quick-start-1970s.jpg';
import ref3 from '/src/assets/media/features/multi-reference-1970s.jpg';
import prod1 from '/src/assets/media/take-b-1970s.jpg';
import prod2 from '/src/assets/media/features/storyboard-1970s.jpg';
import prod3 from '/src/assets/media/features/produce-export-1970s.jpg';
import team1 from '/src/assets/media/features/project-budgets-1970s.jpg';
import team2 from '/src/assets/media/features/agentic-workflows-1970s.jpg';
import team3 from '/src/assets/media/features/team-1970s.jpg';

const workflowsData = {
  sequence: [
    { title: 'Prompt → Shot 1: The Hook',   desc: 'One input prompt. 10zebra auto-generates the opening pit-wall hook shot — close-up, high tension.', img: seq1.src },
    { title: 'Auto → Shot 2: The Scene',     desc: 'Middle shot created automatically — same characters, next beat of the endurance race.',              img: seq2.src },
    { title: 'Auto → Shot 3: The Payoff',    desc: 'Closing shot with consistent setting and crew — ready to export.',                                   img: seq3.src },
  ],
  swap: [
    { title: 'Original Video',  desc: 'Source video with original talent — any Kling, Runway, or uploaded clip.',           img: swap1.src },
    { title: 'Reference Photo', desc: 'Drop in a single reference portrait of Lead Driver Elena Vance to swap in.',         img: swap2.src },
    { title: 'Swapped Output',  desc: 'Same motion, same background — new character. Batch-ready with Agent Z.',            img: swap3.src },
  ],
  multiref: [
    { title: 'Ref 1: Character',   desc: 'Character portrait — locks face and Nomex suit across the edit.',                    img: ref1.src },
    { title: 'Ref 2: Environment', desc: 'Environment reference — 1970s paddock location and tungsten lighting locked in.',    img: ref2.src },
    { title: 'Generated Output',   desc: 'Character placed in setting — coherent, production-ready keyframe.',                 img: ref3.src },
  ],
  produce: [
    { title: 'Select Best Takes', desc: 'Review takes from multiple models. Pick the winner for each shot.',                  img: prod1.src },
    { title: 'Arrange & Trim',    desc: 'Drag shots into order. Trim each clip. Add background audio.',                       img: prod2.src },
    { title: 'Export to YouTube', desc: 'One-click export — download your finished video or share a preview link.',           img: prod3.src },
  ],
  team: [
    { title: 'Owner Funds Project', desc: 'Project owner sets a credit budget and adds team members with specific roles.',    img: team1.src },
    { title: 'Agent Z & Team Run',  desc: 'Members generate takes and run Agent Z Dry Run batches using project credits.',    img: team2.src },
    { title: 'Owner Reviews',       desc: 'Owner reviews takes, checks costs, selects best outputs, and exports the final cut.',img: team3.src },
  ],
};
---
<section class="section" aria-labelledby="sandbox-heading">
  <div class="sect-head reveal">
    <span class="sect-label">Workflows</span>
    <h2 id="sandbox-heading">See How a Single Idea Becomes a <span class="grad-text">Full Shot Sequence</span></h2>
    <p>Select a workflow to see how 10zebra structures one concept into production-ready shots.</p>
  </div>

  <div class="glass p-8 reveal" id="workflow-sandbox">
    <div class="flex gap-2 flex-wrap justify-center mb-8 pb-6 border-b border-[var(--border-subtle)]"
      role="tablist" aria-label="Workflow demos">
      <button class="tab-btn active" role="tab" aria-selected="true" data-workflow="sequence" id="tab-sequence">Text-to-Sequence</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-workflow="swap" id="tab-swap">Character Swap</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-workflow="multiref" id="tab-multiref">Multi-Reference</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-workflow="produce" id="tab-produce">Produce &amp; Export</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-workflow="team" id="tab-team">Team Workflow</button>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5" id="sandbox-grid" role="tabpanel"></div>
  </div>
</section>

<style>
  .tab-btn {
    padding: 0.55rem 1.1rem;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-body);
  }
  .tab-btn:hover { border-color: var(--border-strong); color: var(--text-secondary); }
  .tab-btn.active { background: var(--accent); color: #0c0d10; border-color: var(--accent); font-weight: 600; }
  .frame-card { background: var(--bg-page); border: 1px solid var(--border-subtle); border-radius: 10px; overflow: hidden; transition: border-color 0.2s; }
  .frame-card:hover { border-color: var(--accent); }
  .frame-img { width: 100%; height: 150px; object-fit: cover; display: block; }
  .frame-body { padding: 1rem; }
  .frame-title { font-size: 0.82rem; font-weight: 700; color: var(--accent); margin-bottom: 0.25rem; }
  .frame-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }
</style>

<script define:vars={{ workflowsData }}>
  const workflows = workflowsData;

  function renderWorkflow(key) {
    const grid = document.getElementById('sandbox-grid');
    if (!grid) return;
    grid.innerHTML = '';
    (workflows[key] || []).forEach((frame) => {
      const card = document.createElement('div');
      card.className = 'frame-card';
      card.innerHTML =
        `<img class="frame-img" src="${frame.img}" alt="${frame.title}" loading="lazy">` +
        `<div class="frame-body"><div class="frame-title">${frame.title}</div><div class="frame-desc">${frame.desc}</div></div>`;
      grid.appendChild(card);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderWorkflow('sequence');
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        renderWorkflow(btn.dataset.workflow);
      });
    });
  });
</script>
