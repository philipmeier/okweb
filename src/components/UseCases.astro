---
/**
 * UseCases — persona rotator. Visible tabs auto-advance (progress bar on the
 * active tab), pause on hover/focus/off-screen, and stop after a manual click.
 * Content lives in src/data/solutions.ts; media in src/data/media.ts.
 */
import MediaSlot from './MediaSlot.astro';
import { solutions } from '../data/solutions';

const DURATION_MS = 7000;
---

<section class="section" aria-labelledby="usecases-heading" id="use-cases">
  <div class="sect-head reveal">
    <span class="sect-label">Who It's For</span>
    <h2 id="usecases-heading">Built for How <span class="grad-text">You Make Video</span></h2>
  </div>

  <div class="uc is-offscreen reveal" data-uc style={`--uc-duration:${DURATION_MS}ms;`}>
    <div class="uc-tabs" role="tablist" aria-label="Use cases">
      {solutions.map((s, i) => (
        <button
          type="button"
          class:list={['uc-tab', { 'is-active': i === 0 }]}
          role="tab"
          id={`uc-tab-${s.slug}`}
          aria-controls={`uc-panel-${s.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="uc-tab__label">{s.label}</span>
          <span class="uc-tab__track" aria-hidden="true"><span class="uc-tab__bar"></span></span>
        </button>
      ))}
    </div>

    <div class="uc-stage">
      {solutions.map((s, i) => (
        <article
          class="uc-panel"
          role="tabpanel"
          id={`uc-panel-${s.slug}`}
          aria-labelledby={`uc-tab-${s.slug}`}
          hidden={i !== 0}
        >
          <MediaSlot
            slot={s.media}
            class="uc-media"
            sizes="(max-width: 900px) 100vw, 1200px"
            widths={[640, 960, 1440]}
            eager={i === 0}
          />
          <div class="uc-scrim" aria-hidden="true"></div>
          <div class="uc-copy">
            <span class="uc-kicker">For {s.label}</span>
            <h3>{s.headline}</h3>
            <p>{s.summary}</p>
            <ul class="uc-chips">
              {s.chips.map((c) => <li><span class="uc-chip-dot" aria-hidden="true"></span>{c}</li>)}
            </ul>
            <a href={`/solutions/${s.slug}`} class="btn btn-primary" id={`uc-cta-${s.slug}`}>{s.cta} &rarr;</a>
          </div>
        </article>
      ))}
    </div>

    <div class="uc-foot">
      <a href="/solutions" id="uc-all-solutions">Explore all solutions &rarr;</a>
    </div>
  </div>
</section>

<style>
  /* ---------- Tabs ---------- */
  .uc-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .uc-tab {
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 0.5rem 0.25rem 0;
    font-family: var(--font-display);
    color: var(--text-muted);
    transition: color 0.25s;
  }
  .uc-tab:hover { color: var(--text-secondary); }
  .uc-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
  .uc-tab.is-active { color: var(--text-primary); }
  .uc-tab__label { display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.7rem; letter-spacing: -0.2px; }
  .uc-tab__track {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--border-subtle);
    overflow: hidden;
  }
  .uc-tab__bar {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-secondary));
    transform: scaleX(0);
    transform-origin: left;
  }
  .uc-tab.is-active .uc-tab__bar { animation: uc-fill var(--uc-duration) linear forwards; }
  .uc.is-paused .uc-tab__bar,
  .uc.is-offscreen .uc-tab__bar { animation-play-state: paused; }
  .uc.is-stopped .uc-tab.is-active .uc-tab__bar { animation: none; transform: scaleX(1); }
  @keyframes uc-fill { to { transform: scaleX(1); } }

  /* ---------- Stage ---------- */
  .uc-stage {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    aspect-ratio: 16 / 7.5;
    min-height: 480px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }
  .uc-panel { position: absolute; inset: 0; }
  .uc-panel[hidden] { display: none; }

  .uc-panel :global(.uc-media) { position: absolute; inset: 0; }
  .uc-panel:not([hidden]) :global(.media-slot__img) {
    animation: uc-kenburns calc(var(--uc-duration) + 1500ms) ease-out both;
  }
  @keyframes uc-kenburns { from { transform: scale(1.08); } to { transform: scale(1); } }

  .uc-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 13, 16, 0.94) 0%, rgba(12, 13, 16, 0.72) 32%, rgba(12, 13, 16, 0.1) 62%, transparent 75%),
      linear-gradient(0deg, rgba(12, 13, 16, 0.6) 0%, transparent 35%);
    pointer-events: none;
  }

  .uc-copy {
    position: absolute;
    left: 0;
    bottom: 0;
    top: 0;
    max-width: 500px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
  }
  .uc-copy > * { animation: uc-rise 0.7s var(--ease-out) both; }
  .uc-copy > *:nth-child(2) { animation-delay: 0.06s; }
  .uc-copy > *:nth-child(3) { animation-delay: 0.12s; }
  .uc-copy > *:nth-child(4) { animation-delay: 0.18s; }
  .uc-copy > *:nth-child(5) { animation-delay: 0.24s; }
  @keyframes uc-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .uc-kicker {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .uc-copy h3 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -1px;
    margin-bottom: 0.9rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }
  .uc-copy p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.4rem;
    max-width: 420px;
  }
  .uc-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .uc-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }
  .uc-chip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .uc-copy .btn { align-self: flex-start; }

  .uc-foot { text-align: center; margin-top: 1.5rem; }
  .uc-foot a { color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: color 0.2s; }
  .uc-foot a:hover { color: var(--accent); }

  /* ---------- Mobile ---------- */
  @media (max-width: 900px) {
    .uc-tabs {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 1rem;
      margin: 0 -1.5rem 1rem;
      padding: 0 1.5rem;
    }
    .uc-tabs::-webkit-scrollbar { display: none; }
    .uc-tab { flex: 0 0 auto; min-width: 140px; }
    .uc-stage { aspect-ratio: auto; min-height: 0; }
    .uc-panel { position: relative; }
    .uc-panel :global(.uc-media) { position: relative; aspect-ratio: 16 / 9; }
    .uc-scrim { display: none; }
    .uc-copy { position: relative; max-width: none; padding: 1.75rem 1.5rem 2rem; }
    .uc-copy .btn { white-space: normal; text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .uc-panel:not([hidden]) :global(.media-slot__img),
    .uc-copy > * { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-uc]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.uc-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.uc-panel'));
    let index = 0;
    let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (stopped) root.classList.add('is-stopped');

    const stop = () => {
      stopped = true;
      root.classList.add('is-stopped');
    };

    const activate = (next: number, focus = false) => {
      index = (next + tabs.length) % tabs.length;
      tabs.forEach((tab, n) => {
        const on = n === index;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        // Restart the progress animation on the newly active tab.
        const bar = tab.querySelector<HTMLElement>('.uc-tab__bar');
        if (bar && on) {
          bar.style.animation = 'none';
          void bar.offsetWidth;
          bar.style.animation = '';
        }
      });
      panels.forEach((panel, n) => (panel.hidden = n !== index));
      if (focus) tabs[index].focus();
      if (window.innerWidth <= 900) {
        tabs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    };

    tabs.forEach((tab, n) => {
      tab.addEventListener('click', () => {
        stop();
        activate(n);
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: tabs.length - 1 };
        if (e.key in keys) {
          e.preventDefault();
          stop();
          activate(keys[e.key], true);
        }
      });
      tab.querySelector('.uc-tab__bar')?.addEventListener('animationend', () => {
        if (!stopped && n === index) activate(index + 1);
      });
    });

    // Pause while the user is engaging with the section.
    const pause = () => root.classList.add('is-paused');
    const resume = () => root.classList.remove('is-paused');
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) resume();
    });

    // Only run while on screen.
    new IntersectionObserver(
      ([entry]) => root.classList.toggle('is-offscreen', !entry.isIntersecting),
      { threshold: 0.35 }
    ).observe(root);
  });
</script>
