---
import { Image } from "astro:assets";
import { solutions } from "/src/data/solutions";
---
<header class="h-[60px] px-[5%] flex justify-between items-center sticky top-0 z-[1000] border-b border-[var(--border-subtle)]"
  style="background:rgba(12,13,16,0.85); backdrop-filter:blur(16px) saturate(1.3);">

  <a href="/" class="flex items-center gap-2 no-underline text-[var(--text-primary)] max-w-[200px]" aria-label="10zebra home">
    <img
      src="https://cdn.prod.website-files.com/63c08dc99cc1f6e207c35685/673d8f0ef64a98520b1354de_10zebra-watermark-white.png"
      alt="10zebra" class="block w-full"
    />
  </a>

  <nav aria-label="Main navigation" class="nav-links flex gap-6 items-center">
    <!-- Solutions mega-menu: opens on hover + keyboard focus (no JS required) -->
    <div class="nav-dd" id="nav-solutions">
      <a href="/solutions" class="nav-dd__trigger text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors" aria-haspopup="true">
        Solutions
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <div class="nav-dd__panel" role="menu" aria-label="Solutions">
        <div class="nav-dd__grid">
          {solutions.map((s) => (
            <a href={`/solutions/${s.slug}`} class="nav-dd__item" role="menuitem" style={`--sol:${s.accent}`} id={`nav-sol-${s.slug}`}>
              <span class="nav-dd__thumb">
                <Image src={s.media.image} alt="" width={160} height={112} loading="lazy" />
              </span>
              <span class="nav-dd__text">
                <span class="nav-dd__label"><i class="nav-dd__dot" aria-hidden="true"></i>{s.label}</span>
                <span class="nav-dd__sub">{s.headline}</span>
              </span>
            </a>
          ))}
        </div>
        <a href="/solutions" class="nav-dd__all" role="menuitem" id="nav-sol-all">
          <span>Compare all solutions</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
    <a href="/features" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">Features</a>
    <a href="/models" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">AI Models</a>
    <a href="/pricing" class="text-[var(--text-muted)] text-sm font-medium no-underline hover:text-[var(--text-primary)] transition-colors">Pricing</a>
    <a href="/mcp" class="text-[var(--accent)] text-sm font-medium no-underline hover:text-amber-300 transition-colors">MCP</a>
  </nav>

  <div class="flex items-center gap-3">
    <a href="/login" class="btn btn-ghost" id="nav-login-btn">Log In</a>
    <a href="/signup" class="btn btn-primary" id="nav-signup-btn">Start Free</a>
  </div>
</header>

<style>
  .nav-dd { position: relative; }
  .nav-dd__trigger { display: inline-flex; align-items: center; gap: 0.3rem; padding: 1.1rem 0; }
  .nav-dd__trigger svg { transition: transform 0.25s ease; }

  .nav-dd__panel {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(560px, 90vw);
    padding: 0.75rem;
    border-radius: 18px;
    border: 1px solid var(--border-subtle);
    background: rgba(18, 19, 24, 0.96);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity 0.2s ease, transform 0.25s ease, visibility 0s linear 0.25s;
  }
  /* Hover bridge so the panel doesn't close crossing the gap */
  .nav-dd__panel::before { content: ""; position: absolute; inset: -12px 0 auto; height: 12px; }

  .nav-dd:hover .nav-dd__panel,
  .nav-dd:focus-within .nav-dd__panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }
  .nav-dd:hover .nav-dd__trigger svg,
  .nav-dd:focus-within .nav-dd__trigger svg { transform: rotate(180deg); }
  .nav-dd:hover .nav-dd__trigger,
  .nav-dd:focus-within .nav-dd__trigger { color: var(--text-primary); }

  .nav-dd__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem; }

  .nav-dd__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .nav-dd__item:hover,
  .nav-dd__item:focus-visible {
    background: color-mix(in srgb, var(--sol) 8%, transparent);
    border-color: color-mix(in srgb, var(--sol) 30%, transparent);
    outline: none;
  }
  .nav-dd__thumb {
    flex: none;
    width: 64px;
    height: 46px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav-dd__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .nav-dd__item:hover .nav-dd__thumb :global(img) { transform: scale(1.08); }

  .nav-dd__text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .nav-dd__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .nav-dd__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sol);
    box-shadow: 0 0 8px var(--sol);
  }
  .nav-dd__sub {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nav-dd__all {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .nav-dd__all:hover,
  .nav-dd__all:focus-visible { background: rgba(249, 115, 22, 0.08); outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav-dd__panel, .nav-dd__trigger svg, .nav-dd__thumb :global(img) { transition: none; }
  }
</style>

<script>
  // Escape closes the Solutions menu for keyboard users.
  const dd = document.getElementById("nav-solutions");
  dd?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      (dd.querySelector(".nav-dd__trigger") as HTMLElement | null)?.focus();
      (document.activeElement as HTMLElement | null)?.blur();
    }
  });
</script>

