---
import { Image } from "astro:assets";
import logo from "/src/assets/logo.png";
import { solutions } from "/src/data/solutions";
import { getModelFamilies, catalog } from "/src/data/models";

const modelFamilies = getModelFamilies().slice(0, 5);
---
<footer class="pt-16 pb-8 border-t border-[var(--border-subtle)]" style="background:var(--bg-page);">
  <div class="wrap">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/index.html" class="block mb-4 max-w-[160px]" aria-label="10zebra home">
          <Image src={logo} alt="10zebra" class="block w-full h-auto" />
        </a>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed max-w-[280px]">
          The AI video production workspace: multi-model generation, character consistency, project budgets, team collaboration, and YouTube-ready export from one place.
        </p>
      </div>

      <!-- Solutions -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Solutions</h4>
        {solutions.map((s) => (
          <a href={`/solutions/${s.slug}/index.html`} class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">{s.label}</a>
        ))}
        <a href="/solutions/index.html" class="block text-sm text-[var(--accent)] mb-2 hover:text-amber-300 transition-colors no-underline">All Solutions &rarr;</a>
      </div>

      <!-- Features -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Features</h4>
        <a href="/features/model-comparison/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Model Comparison</a>
        <a href="/features/agentic-workflows/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Agentic Workflows (Agent Z)</a>
        <a href="/features/text-to-sequence/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Text-to-Sequence</a>
        <a href="/features/character-swap/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Character Swap</a>
        <a href="/features/quick-start-tools/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Quick Start Tools</a>
        <a href="/features/project-management/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Project Teams &amp; Budgets</a>
        <a href="/features/publish-to-youtube/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Publish to YouTube</a>
        <a href="/features/referral-program/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Referral Program (3%)</a>
      </div>

      <!-- AI Models -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">AI Models</h4>
        {modelFamilies.map((f) => (
          <a href={`/models/${f.slug}/index.html`} class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">
            {f.name}
          </a>
        ))}
        <a href="/models/index.html" class="block text-sm text-[var(--accent)] mb-2 hover:text-amber-300 transition-colors no-underline">
          All {catalog.totalFamilies} Model Families &rarr;
        </a>
      </div>

      <!-- Developers -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Developers</h4>
        <a href="/mcp/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">MCP Server</a>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Resources</h4>
        <a href="/about/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">About 10zebra</a>
        <a href="/pricing/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Pricing &amp; Credits</a>
        <a href="/blog/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Tutorials &amp; Blog</a>
        <a href="/faq/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">FAQs</a>
        <a href="/demo/index.html" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Interactive Demo</a>
      </div>
    </div>

    <div class="text-center text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-8">
      &copy; 2026 10zebra.com &mdash; Direct AI video like a producer. Not a prompter.
    </div>
  </div>
</footer>
