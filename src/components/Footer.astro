---
---
<footer class="pt-16 pb-8 border-t border-[var(--border-subtle)]" style="background:var(--bg-page);">
  <div class="wrap">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="block mb-4 max-w-[160px]" aria-label="10zebra home">
          <img src="https://cdn.prod.website-files.com/63c08dc99cc1f6e207c35685/673d8f0ef64a98520b1354de_10zebra-watermark-white.png"
            alt="10zebra" class="block w-full" />
        </a>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed max-w-[280px]">
          The AI video production workspace — multi-model generation, character consistency, project budgets, team collaboration, and YouTube-ready export from one place.
        </p>
      </div>

      <!-- Features -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Features</h4>
        <a href="/features/text-to-sequence" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Text-to-Sequence</a>
        <a href="/features/character-swap" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Character Swap</a>
        <a href="/features/multi-reference-edit" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Multi-Reference Edit</a>
        <a href="/features/produce-and-export" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Produce &amp; Export</a>
        <a href="/features/team-management" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Team Management</a>
      </div>

      <!-- AI Models -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">AI Models</h4>
        <a href="/models/kling" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Kling 3.0</a>
        <a href="/models/veo" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Google Veo 3</a>
        <a href="/models/sora" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">OpenAI Sora</a>
        <a href="/models/runway" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Runway Gen-4</a>
        <a href="/models/seedance" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">SeeDance 2.0</a>
      </div>

      <!-- Developers -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Developers</h4>
        <a href="/mcp" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">MCP Server</a>
        <a href="/api" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">API Docs</a>
        <a href="/integrations" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Integrations</a>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-[0.72rem] uppercase tracking-[1.5px] font-bold text-[var(--text-primary)] mb-4">Resources</h4>
        <a href="/about" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">About 10zebra</a>
        <a href="/pricing" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Pricing &amp; Credits</a>
        <a href="/resources" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Resource Center</a>
        <a href="/faq" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">FAQ &amp; Knowledge Base</a>
        <a href="/demo" class="block text-sm text-[var(--text-muted)] mb-2 hover:text-[var(--text-primary)] transition-colors no-underline">Interactive Demo</a>
      </div>
    </div>

    <div class="text-center text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-8">
      &copy; 2026 10zebra.com &mdash; Direct AI video like a producer. Not a prompter.
    </div>
  </div>
</footer>
