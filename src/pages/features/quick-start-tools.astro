---
import FeatureLandingLayout from "/src/layouts/FeatureLandingLayout.astro";
import QuickStartToolsExplorer from "/src/components/features/QuickStartToolsExplorer.astro";

const stats = [
  { value: "6 Engines", label: "Pre-Built Story Tools", detail: "Script, 3-Act, Ad, Locations, Expressions, Grok" },
  { value: "Dual Mode", label: "New Project or Extend Scene", detail: "Launch from /new or 'Start Workflow' in any scene" },
  { value: "3 to 30", label: "Shot Fanout Range", detail: "Generate full storyboards or new scenes in 1 click" },
  { value: "Auto-Sync", label: "Style & Reference Inheritance", detail: "In-scene mode locks project style & RefManager" }
];

const workflowSteps = [
  {
    step: "Step 01",
    title: "Start a New Project OR Click 'Start Workflow' in Any Scene",
    description: "Launch any of the 6 tools from a blank canvas to build a new storyboard, OR click 'Start Workflow' right beside 'Add Scene' inside an existing project to extend your story.",
    tag: "New or In-Scene"
  },
  {
    step: "Step 02",
    title: "Inherit Project Style & Select Reference Takes",
    description: "When extending an existing scene, the tool automatically inherits your project's active Visual Style and Aspect Ratio (16:9 or 9:16) and opens your Reference Manager to pick existing character or location takes.",
    tag: "Context-Aware"
  },
  {
    step: "Step 03",
    title: "Generate Storyboard or Insert New Scene Immediately",
    description: "10zebra's directorial prompts structure camera rules, lighting, and coverage—either creating a brand-new storyboard or inserting a freshly populated scene right after your active scene.",
    tag: "Storyboard Ready"
  }
];

const features = [
  {
    title: "Dual-Context Workflow: Launch New Projects or Extend Any Scene",
    description: "Quick Start tools aren't just for blank canvases. Every scene on your 10zebra storyboard includes a 'Start Workflow' button right next to 'Add Scene' so you can expand your story at any moment.",
    bullets: [
      "<strong>Automatic style &amp; format lock:</strong> Launching a tool inside an existing project automatically applies your project's active Visual Style and vertical/horizontal format.",
      "<strong>Built-in Reference Manager (RefManager):</strong> Instead of re-uploading files from disk, pick any existing character portrait or shot take from your project library as the visual anchor.",
      "<strong>Seamless scene insertion:</strong> Clicking 'Generate Workflow' inserts a brand-new scene immediately after the current scene and populates it with your generated shots."
    ],
    tag: "Start + Extend"
  },
  {
    title: "From a Script: 3 to 30 Cohesive Shots From One Prompt",
    description: "Drop in your raw script, screenplay, or story outline. Select your target shot count &mdash; 3, 5, 10, 20, or up to 30 shots. 10zebra automatically extracts dramatic beats and queues a complete visual storyboard or new scene.",
    bullets: [
      "<strong>Configurable density:</strong> Generate a quick 3-shot scene extension or a full 30-shot storyboard from one single paste.",
      "<strong>Dramatic pacing:</strong> Begins with an attention-grabbing hook shot and sequences subsequent actions logically.",
      "<strong>Parallel generation:</strong> All shots generate in parallel across your preferred AI video engines."
    ],
    tag: "Script Engine"
  },
  {
    title: "Three Acts: 60-Second Dramatic Short",
    description: "Master the timeless three-act storytelling structure in 60 seconds. 10zebra breaks your prompt into Act I (Setup), Act II (Conflict), and Act III (Payoff).",
    bullets: [
      "<strong>Constant world rules:</strong> Visual taste, lighting, camera type, narrative tone, time of day, and weather are held strictly constant.",
      "<strong>Pacing rule:</strong> System prompt embeds 'Edit: fast paced cuts that advance the narrative' to guarantee momentum.",
      "<strong>Perfect for pitch reels &amp; subplots:</strong> Turn story concepts into complete 3-beat visual treatments or insert a 3-beat sequence mid-project."
    ],
    tag: "Dramatic Structure"
  },
  {
    title: "Make An Ad: Commercial-Grade Art Direction",
    description: "Engineered specifically for brands and advertising agencies. Generates three high-impact commercial scenes that spotlight product scale and aesthetic.",
    bullets: [
      "<strong>Cinematic commercial language:</strong> Utilizes compact diction from modern advertising, cinematography, and high-end printmaking.",
      "<strong>Consistent brand mood:</strong> Preserves grade, lighting, and product focus across all cuts.",
      "<strong>Fast commercial editing:</strong> Structured specifically for high-energy promotional pacing."
    ],
    tag: "Commercials"
  },
  {
    title: "Grok: Native 9:16 Social Microdramas",
    description: "Social media video demands different rules than cinema. The Grok tool produces punchy vertical video optimized for TikTok, Instagram Reels, and YouTube Shorts.",
    bullets: [
      "<strong>Native 9:16 vertical composition:</strong> Zero cropping or pillar-boxing artifacts.",
      "<strong>Mobile camera movement:</strong> Dynamic push-ins, pans, and handheld energy typical of viral social content.",
      "<strong>Dialogue &amp; closeups:</strong> Snappy character closeups with dialogue prompts that hook viewers before they swipe."
    ],
    tag: "Social 9:16"
  },
  {
    title: "Explore Locations & Explore Expressions: Build Your Visual Bible In-Project",
    description: "Need new b-roll angles of your set or emotional reaction shots for your lead actor mid-edit? Run Explore Locations or Explore Expressions directly inside your storyboard.",
    bullets: [
      "<strong>Explore Locations (Environment-only):</strong> Sanitizes prompts to remove human descriptions, generating 3, 5, or 10 wide, medium, and novel architectural angles.",
      "<strong>Explore Expressions (Acting spectrum):</strong> Anchors to your character reference to generate 3, 5, or 10 subtle micro-expressions, conflicted reactions, and closeups.",
      "<strong>Instant scene coverage:</strong> Drop a new location or expression scene right into your active project and pull the best takes onto your timeline."
    ],
    tag: "Coverage & Acting"
  }
];

const comparisonItems = [
  {
    feature: "Where Workflow Tools Can Run",
    zebra: "Use all 6 tools both to start a new storyboard from scratch AND to extend any scene inside an active project",
    competitor: "One-off templates that only work on a blank project and cannot extend existing timelines",
    zebraAdvantage: true
  },
  {
    feature: "In-Project Style & Reference Continuity",
    zebra: "In-scene 'Start Workflow' inherits project Visual Style, Aspect Ratio, and Reference Manager takes automatically",
    competitor: "Forces you to re-upload references and re-type style prompts for every new scene",
    zebraAdvantage: true
  },
  {
    feature: "Script Breakdown Capacity",
    zebra: "Drop a script; choose 3, 5, 10, 20, or 30 cohesive sequential shots in 1 click",
    competitor: "Zero script understanding; you must break down and prompt every shot manually",
    zebraAdvantage: true
  },
  {
    feature: "Environment & Expression Coverage",
    zebra: "Dedicated Explore Locations and Explore Expressions engines for instant B-roll and reaction coverage",
    competitor: "Models frequently insert unwanted background faces or lose actor identity on closeups",
    zebraAdvantage: true
  }
];

const faqs = [
  {
    question: "Can I use Quick Start tools inside an existing project, or only when starting a new one?",
    answer: "Both! You can launch any of the 6 tools from /new to generate a brand-new storyboard from scratch, OR click the 'Start Workflow' button on any scene inside an existing project. When triggered inside a project, the tool automatically inherits your project's visual style and aspect ratio, lets you pick existing character/location takes from your Reference Manager, and inserts the generated shots as a new scene right after your current scene."
  },
  {
    question: "How many shots can I generate at once from a script?",
    answer: "In the 'From a Script' tool, you can select 3, 5, 10, 20, or up to 30 shots from a single script paste—whether you are creating a full project from scratch or adding a new scene to an active storyboard."
  },
  {
    question: "How do I combine Quick Start tools within the same project?",
    answer: "Start your project with 'From a Script' or 'Three Acts', then click 'Start Workflow' on any scene to run 'Explore Locations' (for establishing B-roll) or 'Explore Expressions' (for emotional closeups of your locked character)—all within the same storyboard."
  },
  {
    question: "Do Quick Start and scene extension tools cost extra credits?",
    answer: "No. Workflow tools only consume the standard credits for the video models you choose to generate with (e.g. Kling, SeeDance, Grok). The prompt structuring and directorial system prompts are included for free."
  }
];

const relatedFeatures = [
  {
    title: "Side-by-Side Model Comparison",
    description: "Run your quick-start prompts across Kling, Grok, and Seedance at the same time.",
    href: "/features/model-comparison/index.html",
    badge: "Multi-Model"
  },
  {
    title: "Text-to-Sequence",
    description: "Deep dive into how 10zebra translates single prompts into multi-shot storyboards.",
    href: "/features/text-to-sequence/index.html",
    badge: "Story"
  },
  {
    title: "Publish to YouTube",
    description: "Arrange your quick-start shots into a timeline and export directly to YouTube.",
    href: "/features/publish-to-youtube/index.html",
    badge: "Distribution"
  }
];
---

<FeatureLandingLayout
  title="Quick Start & Scene Extension Tools | 10zebra AI Video Story Engines"
  description="Start a new storyboard OR quickly extend any scene within an existing project using 6 guided tools: From a Script, Three Acts, Make an Ad, Explore Locations, Explore Expressions, and Grok 9:16."
  eyebrow="START NEW OR EXTEND ANY SCENE"
  headline="Quick Start Tools:"
  headlineHighlight="Start a Storyboard or Extend Any Scene."
  subheadline="Use our 6 guided workflow engines both to launch a brand-new project from scratch AND to quickly extend any scene inside an active storyboard—automatically inheriting your project's visual style, aspect ratio, and reference library."
  badgeText="6 Pre-Tuned Story & Scene Engines"
  stats={stats}
  workflowSteps={workflowSteps}
  features={features}
  comparisonItems={comparisonItems}
  faqs={faqs}
  relatedFeatures={relatedFeatures}
>
  <div slot="hero-visual">
    <!-- Quick start tools hero teaser -->
    <div class="rounded-xl bg-[#0e1014] border border-[var(--border-subtle)] p-5 text-left">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)] mb-4">
        <span class="text-xs font-mono uppercase text-[var(--accent)] font-bold">10zebra Dual-Mode Workflow Suite</span>
        <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/20">New Project + In-Scene</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-4">
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">From a Script</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">3 to 30 Shots</div>
        </div>
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">Three Acts</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">60s Narrative Arc</div>
        </div>
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">Make An Ad</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">Commercial Cuts</div>
        </div>
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">Explore Locations</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">Environment Bible</div>
        </div>
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">Explore Expressions</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">Acting &amp; Micro-Emotions</div>
        </div>
        <div class="p-3 rounded-lg bg-[#14161c] border border-[var(--border-subtle)]">
          <div class="text-xs font-bold text-[var(--text-primary)] mb-0.5">Grok Social</div>
          <div class="text-[10px] text-[var(--accent)] font-mono">9:16 Microdramas</div>
        </div>
      </div>

      <div class="text-xs text-[var(--text-secondary)] leading-relaxed bg-[#121418] p-3 rounded-lg border border-white/5">
        Launch from <code class="text-amber-300 font-mono">/new</code> to build a fresh storyboard, or click <strong class="text-white">"Start Workflow"</strong> on any scene inside a project to insert a new scene right after it using your project's active style and Reference Manager.
      </div>
    </div>
  </div>

  <!-- Interactive Explorer Section Slot -->
  <section class="section border-t border-[var(--border-subtle)] bg-[rgba(19,20,23,0.3)]">
    <div class="wrap">
      <div class="sect-head">
        <span class="sect-label">Interactive Tool Sandbox</span>
        <h2>Test All 6 Story Engines</h2>
        <p>Explore prompts, shot options, and sample outputs for each tool below.</p>
      </div>

      <QuickStartToolsExplorer initialTool="from-script" />
    </div>
  </section>
</FeatureLandingLayout>
