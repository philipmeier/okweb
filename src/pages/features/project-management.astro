---
import FeatureLandingLayout from "/src/layouts/FeatureLandingLayout.astro";
import ProjectBudgetMockup from "/src/components/features/ProjectBudgetMockup.astro";

const stats = [
  { value: "Per-Project", label: "Scoped Seats", detail: "Invite by project, not whole app" },
  { value: "$0 Bleed", label: "Credit Vault Isolation", detail: "Projects never share credit balances" },
  { value: "Free Viewers", label: "Client Review Seats", detail: "Clients review & approve for $0" },
  { value: "100%", label: "Per-Shot Audit Trail", detail: "Track who generated what & at what cost" }
];

const workflowSteps = [
  {
    step: "Step 01",
    title: "Create Project & Fund Credit Vault",
    description: "Launch a dedicated production container (e.g. 'Apex Sports Commercial'). Allocate an isolated credit bank that cannot be drained by other projects.",
    tag: "Budget Shield"
  },
  {
    step: "Step 02",
    title: "Invite Project-Level Seats & Assign Roles",
    description: "Invite directors, freelance animators, and agency clients directly to this specific project with discrete roles (Director, Editor, or free Client Viewer).",
    tag: "Project Seats"
  },
  {
    step: "Step 03",
    title: "Direct & Review with Hard Caps",
    description: "Collaborate in real time on storyboards, camera rules, and takes. Generations automatically pause when the project budget threshold is reached.",
    tag: "Live Governance"
  }
];

const features = [
  {
    title: "Project-Level Seats vs. App-Level Seats: Built for Agencies, Enterprises & Collabs",
    description: "Traditional AI tools force you to pay for expensive whole-account seat licenses ($35–$100/mo) for anyone you invite, and once added, they either have account-wide exposure or require separate logins. 10zebra scopes membership per project:",
    bullets: [
      "<strong>Agency client isolation:</strong> Keep Client A (e.g. Automotive) completely cordoned off from Client B (e.g. Fragrance) with zero risk of NDA leaks or cross-client visibility.",
      "<strong>Free client review seats:</strong> Invite brand stakeholders as Viewers to inspect takes, scrub animatics, and approve cuts without paying for an extra seat or giving them generation access.",
      "<strong>Bigger companies & studios:</strong> Departmental teams (Marketing, Previs, Social) manage their own rosters and projects without cross-team chaos or credit interference.",
      "<strong>Creator collaborations:</strong> Team up with guest directors, VFX specialists, or sound designers on a single production without handing over your personal studio credentials or billing."
    ],
    tag: "Project Membership"
  },
  {
    title: "Project-Level Budgets: Isolated Credit Banks & Spending Policies",
    description: "No two productions have the same financial requirements. 10zebra provides independent credit banks and spending policies per project:",
    bullets: [
      "<strong>Zero cross-project credit bleed:</strong> An editor experimenting with expensive Veo 3 or Sora takes in an exploratory project can never drain the credits reserved for a commercial deliverable.",
      "<strong>Granular credit draw rules:</strong> Configure whether collaborators draw from the project's credit bank only, require director authorization, or can draw from their personal allowance.",
      "<strong>Itemized client billing:</strong> Export clean, timestamped billing logs showing exact shots, models, seeds, and credit costs per project."
    ],
    tag: "Budget Vaults"
  },
  {
    title: "Collaborative Team Storyboard with Role-Based Controls",
    description: "Bring your team and clients onto one shared visual canvas where creative decisions and media are synchronized in real time:",
    bullets: [
      "<strong>Global story directives:</strong> Director locks camera angles, aspect ratios, lighting, and reference portraits project-wide.",
      "<strong>Live streaming take pool:</strong> Generations rendered by any teammate immediately appear in the shared bin for collective review.",
      "<strong>Role-based actions:</strong> Owners manage budgets; Editors generate and trim; Viewers review and comment."
    ],
    tag: "Team Canvas"
  }
];

const comparisonItems = [
  {
    feature: "Seat Architecture",
    zebra: "Project-level seats: invite collaborators & clients per project",
    competitor: "App-wide seats only ($35+/user) with full account visibility",
    zebraAdvantage: true
  },
  {
    feature: "Credit Budgeting Scope",
    zebra: "Independent credit vault per project; zero risk of one project draining another",
    competitor: "Account-level shared pool; one user can exhaust the entire monthly allowance",
    zebraAdvantage: true
  },
  {
    feature: "Client & Stakeholder Review",
    zebra: "Free Viewer seats for real-time review and sign-off",
    competitor: "Requires paying full seat cost or exporting offline MP4s",
    zebraAdvantage: true
  },
  {
    feature: "Agency Multi-Client Separation",
    zebra: "Independent project vaults and strict NDA isolation per client",
    competitor: "All clients and projects pooled in one messy workspace",
    zebraAdvantage: true
  },
  {
    feature: "Audit & Cost Attribution",
    zebra: "Timestamped ledger of who prompted, which model was used, and exact cost",
    competitor: "Vague monthly usage bar with no per-project breakdown",
    zebraAdvantage: true
  }
];

const faqs = [
  {
    question: "Why are project-level seats better than app-level seats?",
    answer: "App-level seats lock you into paying for team members across your entire organization, giving them access to all your work. Project-level seats allow you to add collaborators, freelance artists, and clients strictly to the specific project they are working on. They have zero visibility into your other client projects, and you don't have to purchase expensive account-wide licenses."
  },
  {
    question: "How do project-level seats and budgets work together for agencies?",
    answer: "For agencies, each client or campaign gets a dedicated project container with its own credit vault. You can invite your internal team as Editors and the client as a free Viewer. The client can review takes and leave feedback without burning credits, while your team can only spend the credits allocated to that project. Zero cross-client bleed and zero surprise invoices."
  },
  {
    question: "Can creators collaborate on a single video without sharing account access?",
    answer: "Yes. You can invite another creator as a co-director or editor to a specific project. They collaborate with you in the shared storyboard, use your project's allocated credits, and see that project's reference portraits—without ever accessing your other projects, billing info, or personal account credits."
  },
  {
    question: "What happens when a project reaches its budget limit?",
    answer: "The project automatically enters a paused state for new generations, preventing overruns. Existing takes remain accessible for trimming, organizing, and playback. The project owner can increase the budget allocation at any time."
  }
];

const relatedFeatures = [
  {
    title: "Collaborative Team Storyboard",
    description: "Explore how the shared storyboard canvas keeps creative teams aligned in real time.",
    href: "/features/collaborative-storyboard",
    badge: "Collaboration"
  },
  {
    title: "Side-by-Side Model Comparison",
    description: "Let your team compare takes across Kling, Grok, and Seedance within budget limits.",
    href: "/features/model-comparison",
    badge: "Studio"
  },
  {
    title: "Publish to YouTube",
    description: "Export the approved client cut straight to YouTube without downloading locally.",
    href: "/features/publish-to-youtube",
    badge: "Distribution"
  }
];
---

<FeatureLandingLayout
  title="Project Management: Teams & Budgets | 10zebra AI Video"
  description="Project-level seats and isolated credit vaults built for agencies, enterprise studios, and creator collaborations. Eliminate app-level seat lock-in and credit bleed."
  eyebrow="PROJECT TEAMS & BUDGETS"
  headline="Project Management:"
  headlineHighlight="Project Teams & Budgets Hand-in-Hand."
  subheadline="Traditional AI video tools force rigid, expensive app-level seats and pool all credits in one vulnerable bucket. 10zebra scopes membership and budgets per project &mdash; the purpose-built production workspace for agencies, enterprise studios, and creator collaborations."
  badgeText="Project-Level Seats & Budgets"
  stats={stats}
  workflowSteps={workflowSteps}
  features={features}
  comparisonItems={comparisonItems}
  faqs={faqs}
  relatedFeatures={relatedFeatures}
>
  <div slot="hero-visual">
    <ProjectBudgetMockup />
  </div>
</FeatureLandingLayout>

