---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ModelTicker from "../components/ModelTicker.astro";
import PainPoints from "../components/PainPoints.astro";
import FeatureMultiModel from "../components/FeatureMultiModel.astro";
import FeatureTeam from "../components/FeatureTeam.astro";
import FeatureCharacter from "../components/FeatureCharacter.astro";
import FeatureTracking from "../components/FeatureTracking.astro";
import WorkflowSandbox from "../components/WorkflowSandbox.astro";
import MCPSection from "../components/MCPSection.astro";
import CompareTable from "../components/CompareTable.astro";
import ProduceExport from "../components/ProduceExport.astro";
import Pricing from "../components/Pricing.astro";
import SocialProof from "../components/SocialProof.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="10zebra | AI Video Production Workspace — Multi-Model, Team-Ready, Creator-Controlled"
  description="Direct AI video like a producer. Generate across Kling, Veo, Runway, Sora & more from one workspace. Set project budgets, manage your team, keep characters consistent, and export to YouTube. Start free with 200 credits."
>
  <Header />

  <main>
    <Hero />
    <ModelTicker />

    <div class="wrap">
      <PainPoints />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FeatureMultiModel />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FeatureTeam />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FeatureCharacter />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FeatureTracking />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <WorkflowSandbox />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <MCPSection />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <CompareTable />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <ProduceExport />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <Pricing />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <SocialProof />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FAQ />
    </div>
  </main>

  <FinalCTA />
  <Footer />
</Layout>
