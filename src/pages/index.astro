---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ModelTicker from "../components/ModelTicker.astro";
import UseCases from "../components/UseCases.astro";
import ProductTour from "../components/ProductTour.astro";
import FeatureTeam from "../components/FeatureTeam.astro";
import SocialProof from "../components/SocialProof.astro";
import CompareTable from "../components/CompareTable.astro";
import MCPSection from "../components/MCPSection.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="10zebra | AI Video Production Workspace — Multi-Model, Team-Ready, Creator-Controlled"
  description="Direct AI video like a producer. Generate across Kling, Veo, Runway, Sora & more from one workspace. Set project budgets, manage your team, keep characters consistent, and export to YouTube. Start free with 200 credits."
>
  <Header />

  <main>
    <Hero />
    <ModelTicker />

    <!-- Who it's for: persona rotator → /solutions/[slug] -->
    <div class="wrap">
      <UseCases />
    </div>

    <div class="sect-divider"></div>

    <!-- How it works: Generate → Lock → Assemble → Export -->
    <div class="wrap">
      <ProductTour />
    </div>

    <div class="sect-divider"></div>

    <!-- The "Only 10zebra" differentiator -->
    <div class="wrap">
      <FeatureTeam />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <SocialProof />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <CompareTable />
    </div>

    <div class="wrap">
      <MCPSection />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <Pricing />
    </div>

    <div class="sect-divider"></div>

    <div class="wrap">
      <FAQ />
    </div>
  </main>

  <FinalCTA />
  <Footer />
</Layout>
