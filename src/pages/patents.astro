---
// src/pages/patents.astro
import Layout from "/src/layouts/Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";

const pageTitle = "Patents & Intellectual Property | 10zebra";
const pageDescription =
  "With over 20 years of R&D experience, our patent portfolio is focused on: multi media production, deep learning, image understanding, computer vision, multimodal, video, 3D, curation, rating systems, and learning systems. All media produced with 10zebra includes a free license to our patent portfolio for online digital distribution. All film and television should inquire for the appropriate package for your distribution channel.";
const canonicalUrl = "https://10zebra.com/patents";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-US",
      "isPartOf": {
        "@id": "https://10zebra.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://10zebra.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Patents",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main-content" class="py-12 md:py-20 relative overflow-hidden">
    <div
      class="absolute top-24 left-1/2 -translate-x-1/2 w-[650px] h-[300px] pointer-events-none rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(ellipse, var(--accent) 0%, rgba(251,191,36,0.25) 50%, transparent 80%);"
      aria-hidden="true"
    ></div>

    <div class="wrap relative z-10 max-w-4xl mx-auto">
      <!-- Legal & IP Navigation Tabs -->
      <nav aria-label="Legal and intellectual property pages" class="flex flex-wrap items-center gap-2 mb-8">
        <a
          href="/privacy-policy/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-and-conditions/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Terms &amp; Conditions
        </a>
        <a
          href="/patents/index.html"
          aria-current="page"
          class="px-4 py-1.5 rounded-full text-xs font-bold border border-[var(--accent)] bg-[var(--accent-subtle)] text-[var(--accent)] transition-colors no-underline"
        >
          Patents
        </a>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <span class="sect-label">10z, LLC &middot; Intellectual Property</span>
        <h1 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight text-[var(--text-primary)] mt-1" style="font-family:var(--font-display);">
          Patents
        </h1>
      </div>

      <!-- Content Card -->
      <article class="glass p-7 sm:p-10 rounded-2xl border border-[var(--border-subtle)] space-y-8 text-[var(--text-secondary)] leading-relaxed text-sm sm:text-base">
        <!-- Welcome & Artist Advocacy Statement -->
        <div class="p-6 rounded-xl bg-[rgba(12,13,16,0.65)] border border-[var(--border-subtle)] space-y-4 italic text-[var(--text-primary)]">
          <p>
            Hello, and welcome to 10z, LLC (&ldquo;10z&rdquo;, &ldquo;10zebra&rdquo;, &ldquo;we&rdquo;, &ldquo;us&rdquo; or &ldquo;our&rdquo;). We build stuff for artists. We want the artists to win. Please enjoy our media production tools, and please do no simply copy them. We know agents can let you try this, but that does not give you access to our patents. We offer licenses for companies that want to use these frameworks at scale. In fact, if you just login to our online system for your generation - your license is fully covered, and lets you download and distribute anywhere online. And if you are a builder, please inquire about our <a href="/mcp/index.html" class="text-[var(--accent)] underline hover:text-amber-300">MCP</a>. If you have a related product or service, please consider signing on to CAISI genAI Interoperability Standards and Artist Advocacy in exchange for favorable licensing. Thanks!
          </p>
          <p>
            If you are looking to use this for film and television, please inquire at <a href="mailto:hello@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">hello@10zebra.com</a> to find the right setup for your generative workload. You probably work with artists right? We want the artists to win. Ask for favorable licensing terms for co-marketing.
          </p>
        </div>

        <!-- Patents & Intellectual Property Notice -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            Patents &amp; Intellectual Property
          </h2>
          <p>
            10zebra develops proprietary technology for collaborative media creation, artificial intelligence, computer vision, and distributed video production. Certain 10zebra technologies and features are protected by U.S. patents and other intellectual property rights. This page identifies patents associated with those technologies and, where applicable, provides notice pursuant to 35 U.S.C. &sect; 287(a).
          </p>
        </section>

        <!-- Portfolio Summary & Licensing Inquiry Footer -->
        <div class="pt-6 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
          <div>
            &copy; 2026 10z, LLC. All Rights Reserved.
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a href="mailto:hello@10zebra.com?subject=10zebra%20Patent%20%26%20Licensing%20Inquiry" class="text-[var(--accent)] font-semibold hover:underline">
              Contact Licensing (hello@10zebra.com) &rarr;
            </a>
          </div>
        </div>
      </article>
    </div>
  </main>

  <Footer />
</Layout>

