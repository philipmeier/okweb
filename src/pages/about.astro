---
// src/pages/about.astro
import Layout from "/src/layouts/Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";
import FinalCTA from "/src/components/FinalCTA.astro";
import { Image } from "astro:assets";
import philipImg from "/src/assets/media/philip.jpg";

const pageTitle = "About 10zebra | Pioneering Multi-Model AI Video Production";
const pageDescription = "Learn about 10zebra and founder Philip Meier, PhD. Founded in 2021, 10zebra empowers creative directors, film producers, agencies, and creators to orchestrate 68+ models in one browser studio.";
const canonicalUrl = "https://10zebra.com/about";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-US",
      "mainEntity": {
        "@type": "Organization",
        "name": "10zebra",
        "url": "https://10zebra.com",
        "logo": "https://10zebra.com/assets/logo.png",
        "founder": {
          "@type": "Person",
          "name": "Philip Meier",
          "honorificPrefix": "Dr.",
          "jobTitle": "Founder & CEO",
          "alumniOf": "University of California, San Diego",
          "sameAs": [
            "https://www.linkedin.com/in/philip-meier-phd/"
          ]
        },
        "sameAs": [
          "https://www.linkedin.com/company/10zebra/",
          "https://twitter.com/10zebra_app",
          "https://www.youtube.com/@10zebra",
          "https://discord.gg/7PCt4Xqw7k",
          "https://www.reddit.com/r/10zebra/"
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://10zebra.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "About",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main-content" class="about-page">
    {/* -------------------------------------------------------------
        1. HERO SECTION
    -------------------------------------------------------------- */}
    <section class="section about-hero">
      <div class="about-hero__glow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="about-hero__content">
          <div class="about-badge">
            <span class="about-badge__dot"></span>
            <span>Est. 2021 &bull; Built in California</span>
          </div>

          <h1 class="about-hero__title">
            Direct AI Video Like a Producer. <br />
            <span class="grad-text">Not a Prompter.</span>
          </h1>

          <p class="about-hero__lead">
            10zebra was founded on a simple conviction: the future of cinematic AI isn't a solitary chat prompt, but a collaborative production studio where directors orchestrate the world's best generative video models with true continuity, budget control, and creative autonomy.
          </p>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        2. THE 10ZEBRA STORY & LONGEVITY
    -------------------------------------------------------------- */}
    <section class="section about-story-section">
      <div class="wrap">
        <div class="about-split-grid">
          <div class="about-story-text">
            <span class="about-eyebrow">Our Heritage</span>
            <h2 class="about-section-title">An Early Pioneer in Generative AI Video</h2>
            <p>
              When 10zebra was founded in 2021, generative AI video was barely on the horizon. Founded by computational neuroscientist and visual artist Dr. Philip Meier, 10zebra was created to explore how computational models of human perception could transform visual art and digital storytelling.
            </p>
            <p>
              As diffusion models and early latent video generators began to surface, others treated them as novelty prompt toys. We saw the beginnings of a profound transformation in film and digital storytelling. But we also recognized the fundamental bottleneck: <strong>filmmaking is non-linear and collaborative</strong>. Directing a narrative requires continuity of character, camera trajectory, frame-accurate timing, and multi-scene pacing&mdash;capabilities that a standalone text box could never deliver.
            </p>
            <p>
              Over the years, we have continuously expanded, optimized, and stress-tested 10zebra alongside real productions. Today, our cloud studio integrates <strong>68+ active production engines</strong> across 10 global model architectures (Kling, Veo, Sora, Runway, Wan, and Grok), giving production teams a unified canvas where they can direct without engine lock-in.
            </p>

            <div class="about-stats-row">
              <div class="about-stat">
                <span class="about-stat__num">68+</span>
                <span class="about-stat__label">AI Models Integrated</span>
              </div>
              <div class="about-stat">
                <span class="about-stat__num">2021</span>
                <span class="about-stat__label">Pioneering Roots</span>
              </div>
              <div class="about-stat">
                <span class="about-stat__num">100%</span>
                <span class="about-stat__label">Failed Render Refund</span>
              </div>
            </div>
          </div>

          <div class="glass about-milestones-card">
            <h3 class="about-milestones-title">The 10zebra Timeline</h3>
            <div class="about-timeline">
              <div class="about-tl-item">
                <div class="about-tl-dot"></div>
                <div class="about-tl-content">
                  <span class="about-tl-year">2021</span>
                  <strong>Founding &amp; Perception Foundations</strong>
                  <p>Founded by Dr. Philip Meier at the intersection of computational neuroscience, visual cognition, and generative synthesis.</p>
                </div>
              </div>
              <div class="about-tl-item">
                <div class="about-tl-dot"></div>
                <div class="about-tl-content">
                  <span class="about-tl-year">2023</span>
                  <strong>Early AI Video Studio</strong>
                  <p>Launched browser-based video transforms, prompt-to-motion pipelines, and multi-shot animatics as generative video emerged.</p>
                </div>
              </div>
              <div class="about-tl-item">
                <div class="about-tl-dot"></div>
                <div class="about-tl-content">
                  <span class="about-tl-year">2024</span>
                  <strong>Multi-Model Comparison &amp; Character Swap</strong>
                  <p>Pioneered multi-reference face locking, community AI Video Jams, and parallel engine benchmarking.</p>
                </div>
              </div>
              <div class="about-tl-item">
                <div class="about-tl-dot"></div>
                <div class="about-tl-content">
                  <span class="about-tl-year">2025</span>
                  <strong>Non-Linear Storyboarding &amp; Budgets</strong>
                  <p>Added frame-accurate take trimming, project-level credit pools, and granular team permissions.</p>
                </div>
              </div>
              <div class="about-tl-item about-tl-item--active">
                <div class="about-tl-dot"></div>
                <div class="about-tl-content">
                  <span class="about-tl-year">Today</span>
                  <strong>Model Context Protocol (MCP) &amp; Frontier Fleet</strong>
                  <p>Full support for Kling 3.0, Veo 3, Sora, and autonomous Claude/Cursor orchestration via FastMCP.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        3. FOUNDER SPOTLIGHT: DR. PHILIP MEIER
    -------------------------------------------------------------- */}
    <section class="section about-founder-section">
      <div class="wrap">
        <div class="glass glow-border about-founder-card">
          <div class="about-founder-avatar-wrap">
            <div class="about-founder-avatar-ring">
              <Image
                src={philipImg}
                alt="Dr. Philip Meier, Founder and CEO of 10zebra"
                width={340}
                height={340}
                format="webp"
                class="about-founder-photo"
              />
            </div>
            <div class="about-founder-tag">Founder &bull; Director</div>
          </div>

          <div class="about-founder-bio">
            <div class="about-founder-header">
              <div>
                <span class="about-eyebrow">Leadership</span>
                <h2 class="about-founder-name">Dr. Philip Meier</h2>
                <span class="about-founder-role">Founder &amp; CEO, 10zebra</span>
              </div>
              <a
                href="https://www.linkedin.com/in/philip-meier-phd/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost about-linkedin-btn"
                aria-label="Connect with Philip Meier on LinkedIn"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                <span>LinkedIn Profile</span>
              </a>
            </div>

            <p class="about-founder-desc">
              Philip Meier is a printmaker, visual artist, computational neuroscientist, and founder of 10zebra. Holding a <strong>PhD in Computational Neuroscience from UC San Diego</strong>, his academic and creative work investigates how visual perception operates&mdash;how human minds construct meaning, narrative continuity, and belief from moving images.
            </p>

            <blockquote class="about-founder-quote">
              &ldquo;The technology now allows anyone to visualize anything in seconds. Precisely because of that, the director's intent, the provenance of our ideas, and the discipline of narrative structure matter more than ever before.&rdquo;
            </blockquote>

            <p class="about-founder-desc">
              At 10zebra, Philip combines scientific rigor with real-world filmmaking workflows. He collaborates regularly with master artists (such as the De la Torre brothers for the Future Vision XPRIZE), commercial directors, and indie filmmakers to design hybrid production pipelines that blend traditional camera framing, physical glass and character sculptures, and generative video tools into cohesive cinematic stories.
            </p>

            <div class="about-founder-credentials">
              <span class="about-cred-pill">PhD, Computational Neuroscience (UCSD)</span>
              <span class="about-cred-pill">Printmaker &amp; Fine Artist</span>
              <span class="about-cred-pill">AI Video Jam Host</span>
              <span class="about-cred-pill">San Diego &bull; San Francisco</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        4. WHO WE BUILD FOR
    -------------------------------------------------------------- */}
    <section class="section about-audiences-section">
      <div class="wrap">
        <div class="about-section-header">
          <span class="about-eyebrow">Our Focus</span>
          <h2 class="about-section-title">Built for Production Realities</h2>
          <p class="about-section-sub">
            We don't build generic prompt playgrounds. Every feature in 10zebra is engineered to eliminate real production friction for four core creative disciplines.
          </p>
        </div>

        <div class="about-personas-grid">
          {/* Creative Directors */}
          <a href="/solutions/creative-directors" class="glass about-persona-card no-underline">
            <div class="about-persona-icon about-persona-icon--orange">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
            </div>
            <h3>Creative Directors</h3>
            <p>
              Transition instantly from initial mood boards to fully animated storyboard animatics. Pitch bold visual worlds with consistent lighting, color palettes, and cinematic camera trajectories.
            </p>
            <span class="about-persona-link">Explore CD Solutions &rarr;</span>
          </a>

          {/* Film Producers */}
          <a href="/solutions/film-producers" class="glass about-persona-card no-underline">
            <div class="about-persona-icon about-persona-icon--blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                <line x1="7" y1="2" x2="7" y2="22"></line>
                <line x1="17" y1="2" x2="17" y2="22"></line>
                <line x1="2" y1="12" x2="22" y2="12"></line>
              </svg>
            </div>
            <h3>Film Producers</h3>
            <p>
              Maintain tight financial control with project-isolated credit ledgers, multi-tier team permissions, and our 100% refund guarantee on generation model failures.
            </p>
            <span class="about-persona-link">Explore Producer Solutions &rarr;</span>
          </a>

          {/* Agencies */}
          <a href="/solutions/agencies" class="glass about-persona-card no-underline">
            <div class="about-persona-icon about-persona-icon--purple">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3>Agencies &amp; Studios</h3>
            <p>
              Deliver client campaigns faster. Lock brand character identities with multi-reference face consistency, test variations across engines, and export polished 4K sequences.
            </p>
            <span class="about-persona-link">Explore Agency Solutions &rarr;</span>
          </a>

          {/* Content Creators */}
          <a href="/solutions/content-creators" class="glass about-persona-card no-underline">
            <div class="about-persona-icon about-persona-icon--green">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <h3>Content Creators</h3>
            <p>
              Transform solo video ideas into high-production YouTube episodes and social shorts. Cut and trim takes directly in-browser and publish to YouTube in one click.
            </p>
            <span class="about-persona-link">Explore Creator Solutions &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        5. CONNECT & FOLLOW THE COMPANY
    -------------------------------------------------------------- */}
    <section class="section about-connect-section">
      <div class="wrap">
        <div class="glass about-connect-box">
          <div class="about-connect-header">
            <span class="about-eyebrow">Get In Touch</span>
            <h2 class="about-section-title">Connect &amp; Follow 10zebra</h2>
            <p class="about-section-sub">
              Stay in the loop with our latest model drops, community AI video jams, tutorials, and studio updates.
            </p>
          </div>

          <div class="about-channels-grid">
            {/* LinkedIn Company */}
            <a
              href="https://www.linkedin.com/company/10zebra/about/?viewAsMember=true"
              target="_blank"
              rel="noopener noreferrer"
              class="about-channel-item"
            >
              <div class="about-channel-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div class="about-channel-meta">
                <strong>LinkedIn</strong>
                <span>@10zebra Company Page</span>
              </div>
            </a>

            {/* Founder LinkedIn */}
            <a
              href="https://www.linkedin.com/in/philip-meier-phd/"
              target="_blank"
              rel="noopener noreferrer"
              class="about-channel-item"
            >
              <div class="about-channel-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div class="about-channel-meta">
                <strong>Founder LinkedIn</strong>
                <span>Philip Meier, PhD</span>
              </div>
            </a>

            {/* X / Twitter */}
            <a
              href="https://twitter.com/10zebra_app"
              target="_blank"
              rel="noopener noreferrer"
              class="about-channel-item"
            >
              <div class="about-channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </div>
              <div class="about-channel-meta">
                <strong>X (Twitter)</strong>
                <span>@10zebra_app</span>
              </div>
            </a>

            {/* YouTube */}
            <a
              href="https://www.youtube.com/@10zebra"
              target="_blank"
              rel="noopener noreferrer"
              class="about-channel-item"
            >
              <div class="about-channel-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </div>
              <div class="about-channel-meta">
                <strong>YouTube</strong>
                <span>@10zebra Tutorials &amp; Demos</span>
              </div>
            </a>

            {/* Discord */}
            <a
              href="https://discord.gg/7PCt4Xqw7k"
              target="_blank"
              rel="noopener noreferrer"
              class="about-channel-item"
            >
              <div class="about-channel-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
              </div>
              <div class="about-channel-meta">
                <strong>Discord Community</strong>
                <span>Chat with Creators</span>
              </div>
            </a>
          </div>

          <div class="about-locations-bar">
            <span class="about-loc-label">Locations:</span>
            <span class="about-loc-pill">San Francisco, CA</span>
            <span class="about-loc-pill">San Diego, CA</span>
            <span class="about-loc-pill">Los Angeles, CA</span>
            <span class="about-loc-divider">&bull;</span>
            <span class="about-loc-email">Inquiries: <a href="mailto:hello@10zebra.com">hello@10zebra.com</a></span>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        6. FINAL CALL TO ACTION
    -------------------------------------------------------------- */}
    <FinalCTA
      title="Start Directing with 10zebra"
      subtitle="Experience the difference of a true AI video production workspace. Sign up today and receive 200 free trial credits."
      primaryBtnText="Create Free Account"
      primaryBtnHref="/signup"
      secondaryBtnText="Explore Supported Models"
      secondaryBtnHref="/models"
    />
  </main>

  <Footer />
</Layout>

<style>
  /* -------------------------------------------------------------
     ABOUT PAGE STYLES
  -------------------------------------------------------------- */
  .about-page {
    position: relative;
    overflow-x: hidden;
  }

  /* Hero */
  .about-hero {
    padding-top: 8rem;
    padding-bottom: 4rem;
    position: relative;
    text-align: center;
  }

  .about-hero__glow {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 750px;
    height: 400px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.16) 0%, rgba(251, 191, 36, 0.05) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .about-hero__content {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
  }

  .about-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .about-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
