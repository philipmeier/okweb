---
/**
 * /features — Feature hub.
 * Hero (copy + feature mosaic) → Stats → Pipeline (4 phases of visual feature cards)
 * → Try it (tabbed interactive mockups) → By role (solutions) → Old way vs 10zebra → CTA.
 * Feature titles, blurbs, and imagery come from src/data/features.ts.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import FeatureVisual from "../components/features/FeatureVisual.astro";
import FeatureCard from "../components/features/FeatureCard.astro";
import SolutionCard from "../components/solutions/SolutionCard.astro";
import ShiftList from "../components/shared/ShiftList.astro";
import ModelComparisonMockup from "../components/features/ModelComparisonMockup.astro";
import CharacterSwapMockup from "../components/features/CharacterSwapMockup.astro";
import QuickStartToolsExplorer from "../components/features/QuickStartToolsExplorer.astro";
import ProjectBudgetMockup from "../components/features/ProjectBudgetMockup.astro";
import YouTubeExportMockup from "../components/features/YouTubeExportMockup.astro";
import { features, featureEntries, phases, type PhaseKey } from "../data/features";
import { solutions } from "../data/solutions";

const phaseKeys = Object.keys(phases) as PhaseKey[];
const byPhase = phaseKeys.map((key) => ({
  key,
  ...phases[key],
  items: featureEntries.filter(([, f]) => f.phase === key).map(([, f]) => f),
}));

// Hero mosaic tiles (grid areas a–f)
const mosaic = [
  { area: "a", f: features.modelComparison },
  { area: "b", f: features.characterSwap },
  { area: "c", f: features.multiReference },
  { area: "d", f: features.textToSequence },
  { area: "e", f: features.quickStart },
  { area: "f", f: features.collaborativeStoryboard },
];

// Interactive demos (mockups will be rebuilt to mirror the app — see docs/ROADMAP.md)
const demos = [
  { id: "compare", f: features.modelComparison, line: "Same prompt. Every model. You pick the take.", Comp: ModelComparisonMockup, props: {} },
  { id: "swap", f: features.characterSwap, line: "Re-cast a finished take without re-shooting it.", Comp: CharacterSwapMockup, props: {} },
  { id: "quickstart", f: features.quickStart, line: "Six launchpads, so you never start from a blank prompt.", Comp: QuickStartToolsExplorer, props: { initialTool: "from-script" } },
  { id: "budgets", f: features.projectBudgets, line: "Every project gets its own budget, rules, and team.", Comp: ProjectBudgetMockup, props: {} },
  { id: "publish", f: features.publishYouTube, line: "Cut, score, and publish straight from the storyboard.", Comp: YouTubeExportMockup, props: {} },
];

const comparisonData = [
  { label: "Multi-Model Generation", after: "Kling, Grok, Seedance, Veo, Sora, Runway in 1 prompt", before: "Locked to 1 proprietary engine" },
  { label: "Model Comparison", after: "Side-by-side synchronized take previewer", before: "Switch tabs and copy-paste prompts" },
  { label: "Project-Level Budgets", after: "Independent credit pools per project & team", before: "Pooled account-wide (1 mistake drains all)" },
  { label: "Batch Character Swap", after: "10z Agent swaps a character across every take", before: "Manual single-frame inpainting only" },
  { label: "From a Script Fanout", after: "3, 5, 10, 20, or 30 cohesive shots from 1 prompt", before: "Generate 1 clip at a time" },
  { label: "Team Storyboard Sync", after: "Shared takes with locked story rules", before: "Isolated individual accounts" },
  { label: "YouTube Publishing", after: "1-click publish with audio mixdown & metadata", before: "Download locally, then upload manually" },
];
---

<Layout
  title="10zebra Feature Hub | The Complete AI Video Production Suite"
  description="Explore 10zebra's production features: side-by-side multi-model comparisons (Kling, Grok, Seedance), text-to-sequence, character swap with 10z agent, isolated project budgets, 6 quick-start tools, and 1-click YouTube publishing."
  canonicalUrl="https://10zebra.com/features"
>
  <Header />

  <main class="fh">
    <!-- ================= HERO ================= -->
    <section class="fh-hero" aria-labelledby="fh-heading">
      <div class="fh-hero__glow" aria-hidden="true"></div>
      <div class="wrap fh-hero__inner">
        <div class="fh-hero__copy">
          <span class="fh-kicker"><span class="fh-dot" aria-hidden="true"></span>Feature Hub</span>
          <h1 id="fh-heading">Every Tool to <span class="grad-text">Direct AI Video</span>, Not Just Generate It</h1>
          <p class="fh-hero__sub">Compare models, lock your cast, cut the edit, and keep every budget in check. One workspace, first prompt to final cut.</p>
          <div class="fh-hero__ctas">
            <a href="/signup" class="btn btn-primary btn-lg" id="hub-hero-cta">Start Free &mdash; 200 Credits</a>
            <a href="#try" class="btn btn-ghost btn-lg" id="hub-try-cta">Try the Tools &darr;</a>
          </div>
          <nav class="fh-phases" aria-label="Jump to phase">
            {byPhase.map((p) => (
              <a href={`#phase-${p.key}`}><b>{p.num}</b>{p.label}</a>
            ))}
          </nav>
        </div>

        <div class="fh-mosaic" aria-label="Feature previews">
          {mosaic.map(({ area, f }, i) => (
            <a href={f.href} class="fh-tile" style={`grid-area:${area}; --i:${i}`}>
              <FeatureVisual
                feature={f}
                single={area !== "a"}
                labels={area === "a"}
                sizes={area === "a" ? "(max-width: 1000px) 66vw, 420px" : "(max-width: 1000px) 33vw, 200px"}
                eager
                hideTag={area !== "a"}
              />
              <span class="fh-tile__label">{f.short}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    <div class="wrap">
      <div class="fh-stats glass reveal">
        <div class="fh-stat"><div class="fh-stat__value grad-text">8+</div><div class="fh-stat__label">AI video models</div></div>
        <div class="fh-stat"><div class="fh-stat__value grad-text">30</div><div class="fh-stat__label">shots from one script</div></div>
        <div class="fh-stat"><div class="fh-stat__value grad-text">Per&#8209;Project</div><div class="fh-stat__label">budgets &amp; teams</div></div>
        <div class="fh-stat"><div class="fh-stat__value grad-text">1&#8209;Click</div><div class="fh-stat__label">publish to YouTube</div></div>
      </div>
    </div>

    <!-- ================= PIPELINE ================= -->
    <section class="wrap section" aria-labelledby="fh-pipe-heading" id="pipeline">
      <div class="sect-head reveal">
        <span class="sect-label">The Pipeline</span>
        <h2 id="fh-pipe-heading">Four Phases. <span class="grad-text">One Workspace.</span></h2>
      </div>

      <div class="fh-pipe">
        {byPhase.map((p) => (
          <div class="fh-phase" id={`phase-${p.key}`}>
            <div class="fh-phase__rail reveal">
              <span class="fh-phase__num">{p.num}</span>
              <h3>{p.label}</h3>
              <p>{p.line}</p>
            </div>
            <div class="fh-phase__cards" style={`--n:${p.items.length}`}>
              {p.items.map((f, i) => <FeatureCard feature={f} class={`reveal reveal-d${i + 1}`} />)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= TRY IT ================= -->
    <section class="section fh-try" aria-labelledby="fh-try-heading" id="try">
      <div class="wrap">
        <div class="sect-head reveal">
          <span class="sect-label">Try It</span>
          <h2 id="fh-try-heading">Take the Workspace <span class="grad-text">for a Spin</span></h2>
        </div>

        <div class="fh-tabs reveal" role="tablist" aria-label="Interactive feature demos">
          {demos.map((d, i) => (
            <button
              type="button"
              role="tab"
              class="fh-tab"
              id={`tab-${d.id}`}
              aria-controls={`panel-demo-${d.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="fh-tab__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d.f.icon} /></svg>
              </span>
              {d.f.short}
            </button>
          ))}
        </div>

        {demos.map(({ id, f, line, Comp, props }, i) => (
          <div class="fh-panel" role="tabpanel" id={`panel-demo-${id}`} aria-labelledby={`tab-${id}`} hidden={i !== 0}>
            <div class="fh-panel__head">
              <div>
                <h3>{f.title}</h3>
                <p>{line}</p>
              </div>
              <a href={f.href} class="btn btn-ghost">Explore {f.short} &rarr;</a>
            </div>
            <div class="fh-panel__demo">
              <Comp {...props} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= BY ROLE ================= -->
    <section class="wrap section" aria-labelledby="fh-role-heading">
      <div class="sect-head reveal">
        <span class="sect-label">By Role</span>
        <h2 id="fh-role-heading">See the Tools <span class="grad-text">for Your Team</span></h2>
      </div>
      <div class="fh-roles">
        {solutions.map((s, i) => <SolutionCard solution={s} variant="compact" class={`reveal reveal-d${i + 1}`} />)}
      </div>
    </section>

    <div class="sect-divider"></div>

    <!-- ================= OLD WAY vs 10ZEBRA ================= -->
    <section class="wrap section" aria-labelledby="fh-shift-heading">
      <div class="sect-head reveal">
        <span class="sect-label">The Studio Advantage</span>
        <h2 id="fh-shift-heading">10zebra vs <span class="grad-text">Standalone AI Tools</span></h2>
      </div>
      <ShiftList items={comparisonData} beforeLabel="Standalone tools (Runway, Higgsfield, Luma)" afterLabel="10zebra" />
    </section>

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<style>
  .fh-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); flex-shrink: 0; }

  /* ---------- Hero ---------- */
  .fh-hero { position: relative; padding: 5rem 0 6.5rem; overflow: hidden; }
  .fh-hero__glow {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 900px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(249, 115, 22, 0.16), rgba(251, 191, 36, 0.05) 45%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }
  .fh-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 3.5rem; align-items: center; }
  .fh-hero__copy > * { animation: fh-rise 0.8s var(--ease-out) both; }
  .fh-hero__copy > *:nth-child(2) { animation-delay: 0.06s; }
  .fh-hero__copy > *:nth-child(3) { animation-delay: 0.12s; }
  .fh-hero__copy > *:nth-child(4) { animation-delay: 0.18s; }
  .fh-hero__copy > *:nth-child(5) { animation-delay: 0.24s; }
  @keyframes fh-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .fh-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.25rem;
  }
  .fh-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.6vw, 3.7rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1.8px;
    margin-bottom: 1.1rem;
  }
  .fh-hero__sub { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.75rem; max-width: 520px; }
  .fh-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.75rem; }
  .fh-phases { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fh-phases a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    transition: border-color 0.25s, color 0.25s, transform 0.25s var(--ease-out);
  }
  .fh-phases a b { font: 700 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--accent); }
  .fh-phases a:hover { color: var(--text-primary); border-color: rgba(249, 115, 22, 0.45); transform: translateY(-2px); }

  /* Mosaic */
  .fh-mosaic {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: repeat(3, 150px);
    grid-template-areas:
      "a a b"
      "a a c"
      "d e f";
    gap: 0.75rem;
  }
  .fh-tile {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.85);
    animation: fh-tile-in 0.9s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.08s);
    transition: transform 0.4s var(--ease-out), border-color 0.3s;
  }
  @keyframes fh-tile-in { from { opacity: 0; transform: translateY(20px) scale(0.97); } to { opacity: 1; transform: none; } }
  .fh-tile:hover { transform: translateY(-4px); border-color: rgba(249, 115, 22, 0.55); }
  .fh-tile :global(.media-slot__img) { transition: transform 1s var(--ease-out); }
  .fh-tile:hover :global(.media-slot__img) { transform: scale(1.06); }
  .fh-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(12, 13, 16, 0.75), transparent 50%); pointer-events: none; }
  .fh-tile__label {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    z-index: 3;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
  }
  .fh-tile[style*="grid-area:a"] .fh-tile__label {
    top: 0.6rem;
    left: 0.6rem;
    right: auto;
    bottom: auto;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    background: rgba(12, 13, 16, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
  }

  /* ---------- Stats ---------- */
  .fh-stats { position: relative; z-index: 3; margin-top: -3rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 1.6rem 1rem; }
  .fh-stat { text-align: center; padding: 0 1rem; }
  .fh-stat + .fh-stat { border-left: 1px solid var(--border-subtle); }
  .fh-stat__value { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 900; letter-spacing: -1px; line-height: 1.1; }
  .fh-stat__label { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem; }

  /* ---------- Pipeline ---------- */
  .fh-pipe { display: grid; gap: 4rem; }
  .fh-phase { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 2.5rem; align-items: start; scroll-margin-top: 90px; }
  .fh-phase__rail { position: sticky; top: 90px; padding-top: 0.5rem; border-top: 2px solid var(--accent); }
  .fh-phase__num {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -2px;
    margin: 0.75rem 0 0.4rem;
    background: linear-gradient(180deg, rgba(249, 115, 22, 0.85), transparent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .fh-phase__rail h3 { font-family: var(--font-display); font-size: 1.6rem; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 0.4rem; }
  .fh-phase__rail p { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; }
  .fh-phase__cards { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1.1rem; }

  /* ---------- Try it ---------- */
  .fh-try { background: linear-gradient(180deg, transparent, rgba(19, 20, 23, 0.6) 12%, rgba(19, 20, 23, 0.6) 88%, transparent); }
  .fh-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .fh-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: 600 0.85rem/1 var(--font-body);
    color: var(--text-secondary);
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    cursor: pointer;
    transition: color 0.25s, border-color 0.25s, background 0.25s, box-shadow 0.25s;
  }
  .fh-tab:hover { color: var(--text-primary); border-color: rgba(249, 115, 22, 0.35); }
  .fh-tab[aria-selected="true"] {
    color: #0c0d10;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    border-color: transparent;
    box-shadow: 0 10px 30px -10px rgba(249, 115, 22, 0.55);
  }
  .fh-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fh-tab__icon svg { width: 16px; height: 16px; display: block; }
  .fh-panel { animation: fh-rise 0.5s var(--ease-out) both; }
  .fh-panel[hidden] { display: none; }
  .fh-panel__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .fh-panel__head h3 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; letter-spacing: -0.4px; margin-bottom: 0.25rem; }
  .fh-panel__head p { color: var(--text-secondary); }

  /* ---------- Roles ---------- */
  .fh-roles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.1rem; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .fh-roles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1000px) {
    .fh-hero__inner { grid-template-columns: 1fr; }
    .fh-phase { grid-template-columns: 1fr; gap: 1.25rem; }
    .fh-phase__rail { position: static; }
    .fh-phase__num { font-size: 2.6rem; }
  }
  @media (max-width: 800px) {
    .fh-hero { padding: 3.5rem 0 5.5rem; }
    .fh-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.25rem; }
    .fh-stat:nth-child(odd) { border-left: none; }
    .fh-phase__cards { grid-template-columns: 1fr; }
    .fh-mosaic { grid-template-rows: repeat(3, 110px); }
  }
  @media (max-width: 560px) {
    .fh-mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 180px 110px 110px;
      grid-template-areas: "a a" "b c" "d e";
    }
    .fh-tile[style*="grid-area:f"] { display: none; }
    .fh-roles { grid-template-columns: 1fr; }
    .fh-roles :global(.sc--compact) { aspect-ratio: 16 / 10; }
    .fh-tab { padding: 0.6rem 0.8rem; font-size: 0.78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fh-hero__copy > *, .fh-tile, .fh-panel { animation: none; }
  }
</style>

<script>
  // Accessible tabs for the interactive demos (arrow keys, Home/End).
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".fh-tab"));
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute("aria-controls") || "");
      if (panel) panel.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select(tabs[(keys[e.key] + tabs.length) % tabs.length], true);
    });
  });
</script>
