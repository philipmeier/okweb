<script>
  // Tab switching logic for Technical Specification
  const specTabs = document.querySelectorAll<HTMLButtonElement>('.mcp-tab');
  const specPanes = document.querySelectorAll<HTMLElement>('.mcp-tab-pane');

  specTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      specTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      specPanes.forEach((p) => p.classList.remove('active'));

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const activePane = document.getElementById(`pane-${target}`);
      if (activePane) activePane.classList.add('active');
    });
  });

  // Tab switching logic for Config Setup
  const cfgTabs = document.querySelectorAll<HTMLButtonElement>('.mcp-cfg-btn');
  const cfgPanes = document.querySelectorAll<HTMLElement>('.mcp-cfg-pane');

  cfgTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.cfg;
      cfgTabs.forEach((b) => b.classList.remove('active'));
      cfgPanes.forEach((p) => p.classList.remove('active'));

      btn.classList.add('active');
      const activePane = document.getElementById(`cfg-${target}`);
      if (activePane) activePane.classList.add('active');
    });
  });

  // Copy to clipboard helper
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.mcp-copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.copyTarget;
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      try {
        await navigator.clipboard.writeText(targetEl.innerText);
        const originalText = btn.innerText;
        btn.innerText = 'Copied!';
        btn.style.background = 'var(--accent)';
        btn.style.color = '#fff';
        setTimeout(() => {
          btn.innerText = originalText;
          btn.style.background = '';
          btn.style.color = '';
        }, 2000);
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });
  });
</script>
