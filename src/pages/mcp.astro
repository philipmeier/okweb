                  <span class="mcp-pill mcp-pill--blue">Resource</span>
                  <code class="mcp-fn-name">{res.uri}</code>
                </div>
                <p class="mcp-spec-summary">{res.summary}</p>
                <div class="mcp-spec-args">
                  <strong>Handler Function:</strong> <code>{res.functionName}()</code>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Tab 3: Prompts (Dynamic) */}
        <div class="mcp-tab-pane" id="pane-prompts">
