---
// src/pages/mcp.astro
import Layout from "/src/layouts/Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";
import FinalCTA from "/src/components/FinalCTA.astro";
import {
  mcpCatalog,
  getMcpTools,
  getMcpResources,
  getMcpPrompts,
  getMcpStats,
  getMcpEnvVars,
} from "/src/data/mcp";

const tools = getMcpTools();
const resources = getMcpResources();
const prompts = getMcpPrompts();
const stats = getMcpStats();
const envVars = getMcpEnvVars();

const pageTitle = "10zebra MCP Server | Direct AI Video with Claude, Cursor & LLM Agents (Director Plan)";
const pageDescription = "Connect Claude Desktop, Cursor, and LLM coding agents directly to 10zebra's multi-model AI video production pipeline via the Model Context Protocol (MCP). Requires Director subscription ($79/mo). Includes 11 tools, 5 resources, and project credit isolation.";
const canonicalUrl = "https://10zebra.com/mcp";

// Comprehensive AEO & SEO Schema.org Graph
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": "10zebra Model Context Protocol (MCP) Server Architecture & Integration Guide",
      "description": "Technical specification and guide for using 10zebra's FastMCP server to programmatically orchestrate multi-model AI video pipelines through Anthropic Claude Desktop, Cursor, and custom autonomous agents on the Director plan.",
      "url": canonicalUrl,
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "10zebra",
        "url": "https://10zebra.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "10zebra",
        "url": "https://10zebra.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://10zebra.com/assets/logo.png"
        }
      },
      "about": [
        {
          "@type": "Thing",
          "name": "Model Context Protocol",
          "description": "An open standard enabling AI assistants to securely discover tools, resources, and pre-engineered prompts."
        },
        {
          "@type": "Thing",
          "name": "AI Video Generation",
          "description": "Multi-model video orchestration across Kling, Google Veo, OpenAI Sora, Runway Gen-4, and Wan 2.1."
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "10zebra MCP Server",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Cross-platform (HTTP / stdio)",
      "offers": {
        "@type": "Offer",
        "price": "79",
        "priceCurrency": "USD",
        "description": "Available exclusively with the 10zebra Director subscription ($79/month) or Studio enterprise tier.",
        "url": "https://10zebra.com/pricing"
      },
      "featureList": [
        "FastMCP Streamable HTTP & stdio transport",
        `Multi-tenant video project orchestration across ${stats.totalTools} callable tools`,
        `Direct access to ${stats.totalResources} live storyboard resources and ${stats.totalPrompts} director prompts`,
        "Atomic Firestore transaction credit enforcement",
        "Multi-model video generation across 68+ AI models",
        "Real-time storyboard manipulation, scene creation, and shot sequencing",
        "Frame-accurate take trimming and final master cut saving",
        "Zero-credential client architecture via secure mcpAction cloud function"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which subscription plan is required to access the 10zebra MCP server?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Access to the 10zebra Model Context Protocol (MCP) server requires an active Director plan ($79/mo) or higher. Director subscribers receive their dedicated MCP API key and streamable-HTTP / stdio credentials, 3,500 monthly credits, 30% discount on credit top-ups, and project-level isolated budget controls to power autonomous workflows in Claude Desktop and Cursor."
          }
        },
        {
          "@type": "Question",
          "name": "What is an MCP server and how does 10zebra use it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Model Context Protocol (MCP) is an open standard developed by Anthropic that allows large language models (LLMs) like Claude, Cursor, and ChatGPT to connect to external systems. The 10zebra MCP server exposes 10zebra's multi-model AI video production pipeline as standard Tools (generate, add_story_shot, trim_take, etc.), Resources (board://{portal_id}, models://by-method), and Prompts, allowing AI assistants to act as autonomous video directors."
          }
        },
        {
          "@type": "Question",
          "name": "How does 10zebra protect against AI agents overspending credits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "10zebra enforces credit limits server-side within atomic Firestore transactions on a dedicated project-level ledger. An agent has no access to the user's personal wallet or credit card. If a project's allocated credits run out, the MCP server returns an actionable HTTP 402 Payment Required response containing a browser funding link (https://10zebra.com/p/{portal_id}), preventing runaway spend and headless silent failure."
          }
        },
        {
          "@type": "Question",
          "name": "Can 10zebra MCP generate video using multiple AI models in the same project?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Through the generate tool, an AI agent can specify any supported model key (e.g. Kling 3.0 for physical camera motion, Google Veo 3 for photorealistic environmental shots, Runway Gen-4 for stylized action, or Wan 2.1 for open-source workflows) for each individual shot while maintaining storyboard coherence and character references."
          }
        },
        {
          "@type": "Question",
          "name": "How is the MCP server kept up-to-date with latest app features?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "10zebra utilizes an automated sync script (npm run sync:app) that inspects the backend server definitions in mcp/server.py and functions/mcp.js, immediately updating tools, parameter signatures, resources, and model catalogs directly on the web documentation."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://10zebra.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Developers",
          "item": "https://10zebra.com/api"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "MCP Server",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main-content" class="mcp-page">
    {/* -------------------------------------------------------------
        1. HERO SECTION
    -------------------------------------------------------------- */}
    <section class="section mcp-hero">
      <div class="mcp-hero__bg-glow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="mcp-hero__content">
          <div class="mcp-badge">
            <span class="mcp-badge__dot"></span>
            <span>FastMCP Streamable-HTTP &bull; Requires Director Plan ($79/mo)</span>
          </div>

          <h1 class="mcp-hero__title">
            Direct Multi-Model AI Video from <span class="grad-text">Claude, Cursor</span> &amp; Custom LLM Agents
          </h1>

          <p class="mcp-hero__lead">
            The <strong>10zebra Model Context Protocol (MCP) server</strong> gives AI assistants native tools to compose storyboards, dispatch generations across 68+ models (Kling, Veo, Sora, Runway, Grok), trim takes, and render cuts&mdash;all backed by server-authoritative project credit guardrails.
          </p>

          <div class="mcp-hero__actions">
            <a href="/signup?plan=director" class="btn btn-primary btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
              <span>Unlock MCP on Director Plan ($79/mo)</span>
            </a>
            <a href="/pricing" class="btn btn-ghost btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="6" y1="8" x2="6" y2="8"></line>
                <line x1="10" y1="8" x2="18" y2="8"></line>
                <line x1="6" y1="12" x2="6" y2="12"></line>
                <line x1="10" y1="12" x2="18" y2="12"></line>
              </svg>
              <span>Compare Pricing &amp; Plans</span>
            </a>
            <a href="#quickstart" class="btn btn-ghost btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Setup Guide</span>
            </a>
          </div>

          {/* Quick Metrics Bar (Dynamic from mcp.json) */}
          <div class="mcp-metrics-bar">
            <div class="mcp-metric-pill">
              <span class="mcp-metric-pill__num">{stats.totalTools}</span>
              <span class="mcp-metric-pill__label">Active Tools</span>
            </div>
            <div class="mcp-metric-divider"></div>
            <div class="mcp-metric-pill">
              <span class="mcp-metric-pill__num">{stats.totalResources}</span>
              <span class="mcp-metric-pill__label">Live Resources</span>
            </div>
            <div class="mcp-metric-divider"></div>
            <div class="mcp-metric-pill">
              <span class="mcp-metric-pill__num">{stats.totalPrompts}</span>
              <span class="mcp-metric-pill__label">Director Prompts</span>
            </div>
            <div class="mcp-metric-divider"></div>
            <div class="mcp-metric-pill">
              <span class="mcp-metric-pill__num">68+</span>
              <span class="mcp-metric-pill__label">Supported Engines</span>
            </div>
            <div class="mcp-metric-divider"></div>
            <div class="mcp-metric-pill mcp-metric-pill--highlight">
              <span class="mcp-metric-pill__num">Director</span>
              <span class="mcp-metric-pill__label">Plan Required</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        PLAN GATE CALLOUT BANNER: DIRECTOR SUBSCRIPTION REQUIRED
    -------------------------------------------------------------- */}
    <section class="section mcp-plan-gate-section">
      <div class="wrap">
        <div class="glass glow-border mcp-plan-gate-card">
          <div class="mcp-plan-gate-left">
            <div class="mcp-gate-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Subscription Requirement</span>
            </div>
            <h2>Available Exclusively on the Director Plan ($79/mo)</h2>
            <p>
              Autonomous LLM agents generate high-volume takes, construct multi-scene storyboards, and execute frame-accurate renders in rapid sequence. To ensure high-throughput GPU queue priority and provide dedicated project-level credit pools, <strong>MCP server access is reserved exclusively for Director subscribers</strong>.
            </p>
            <div class="mcp-plan-perks-grid">
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>3,500 monthly credits</strong> included (approx. 87 Kling shots or 175 Veo 3 clips)</span>
              </div>
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>Personal MCP API key</strong> &amp; streamable-HTTP endpoint access</span>
              </div>
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>30% discount</strong> on all additional top-up credit packs</span>
              </div>
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>Project-isolated credit ledgers</strong> preventing runaway agent spend</span>
              </div>
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>3 included team seats</strong> with role-based permissions</span>
              </div>
              <div class="mcp-perk-item">
                <span class="mcp-perk-check">&check;</span>
                <span><strong>100% automated credit refund</strong> on any upstream engine failure</span>
              </div>
            </div>
          </div>

          <div class="mcp-plan-gate-right">
            <div class="mcp-plan-box">
              <span class="mcp-plan-kicker">Director Subscription</span>
              <div class="mcp-plan-price">
                <span class="mcp-price-val">$79</span>
                <span class="mcp-price-sub">/ month</span>
              </div>
              <p class="mcp-plan-save">Or $63/mo billed annually (save $192/yr)</p>
              <a href="/signup?plan=director" class="btn btn-primary btn-full btn-lg">
                Start Director Plan
              </a>
              <a href="/pricing" class="mcp-plan-link">
                View full feature comparison &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        2. AEO EXPLANATION: WHAT IS MCP & HOW 10ZEBRA USES IT
    -------------------------------------------------------------- */}
    <section class="section mcp-aeo-primer">
      <div class="wrap">
        <div class="mcp-section-header">
          <span class="mcp-eyebrow">AEO &bull; Fundamental Concepts</span>
          <h2 class="mcp-section-title">What is an MCP Server, and How Does It Transform AI Video Production?</h2>
          <p class="mcp-section-sub">
            The <strong>Model Context Protocol</strong> is an open-source standard created by Anthropic to solve the AI "silo problem." Rather than building isolated plugins for every LLM, MCP establishes a universal communication layer between frontier reasoning models and production cloud engines.
          </p>
        </div>

        <div class="mcp-trio-grid">
          <div class="glass mcp-concept-card">
            <div class="mcp-concept-card__icon mcp-concept-card__icon--tools">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <h3>1. Executable Tools ({tools.length})</h3>
            <p>
              Tools are atomic, callable functions that allow an LLM to take actions in 10zebra. Instead of hallucinating descriptions, the agent executes real production commands: creates scenes, generates videos, changes visual styles, and trims frames.
            </p>
            <div class="mcp-concept-card__examples">
              <code>generate()</code> &bull; <code>add_story_shot()</code> &bull; <code>trim_take()</code>
            </div>
          </div>

          <div class="glass mcp-concept-card">
            <div class="mcp-concept-card__icon mcp-concept-card__icon--resources">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <h3>2. Live Resources ({resources.length})</h3>
            <p>
              Resources provide real-time, zero-latency context to the model via standard URI schemes. An agent reads project storyboards, spendable credit balances, model rate cards, and render telemetry without manual copy-pasting.
            </p>
            <div class="mcp-concept-card__examples">
              <code>board://&#123;portal_id&#125;</code> &bull; <code>models://by-method</code> &bull; <code>funds://</code>
            </div>
          </div>

          <div class="glass mcp-concept-card">
            <div class="mcp-concept-card__icon mcp-concept-card__icon--prompts">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <h3>3. Directorial Prompts ({prompts.length})</h3>
            <p>
              Prompts are pre-engineered creative workflows exposed by the server. They guide the LLM to orchestrate cinematic narratives, expand short pitches into shotlists, fill timeline gaps, or tighten cuts to exact second targets.
            </p>
            <div class="mcp-concept-card__examples">
              <code>compose_storyboard</code> &bull; <code>reimagine_shot</code> &bull; <code>tighten_cut</code>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        3. VISUAL DIAGRAM 1: COMPLETE MCP ARCHITECTURE
    -------------------------------------------------------------- */}
    <section id="architecture" class="section mcp-arch-section">
      <div class="wrap">
        <div class="mcp-section-header">
          <span class="mcp-eyebrow">Visual Architecture &bull; End-to-End Topology</span>
          <h2 class="mcp-section-title">How 10zebra MCP Server Connects to Your Workflow</h2>
          <p class="mcp-section-sub">
            A zero-credential, multi-tenant architecture designed for seamless coordination between local AI clients and 10zebra's distributed GPU production cluster.
          </p>
        </div>

        {/* Interactive Diagram Container */}
        <div class="glass mcp-diagram-card">
          <div class="mcp-diagram-header">
            <div class="mcp-diagram-dots">
              <span class="mcp-dot mcp-dot--red"></span>
              <span class="mcp-dot mcp-dot--yellow"></span>
              <span class="mcp-dot mcp-dot--green"></span>
            </div>
            <div class="mcp-diagram-title">System Architecture: Client &bull; FastMCP &bull; Cloud Action &bull; GPU Fanout</div>
            <div class="mcp-diagram-tag">Streamable HTTP :8080 / stdio</div>
          </div>

          <div class="mcp-arch-diagram">
            {/* Column 1: AI Clients */}
            <div class="mcp-arch-node mcp-arch-node--client">
              <div class="mcp-node-header">
                <span class="mcp-node-badge">AI Assistant Clients</span>
                <h4>Reasoning &amp; Directing</h4>
              </div>
              <div class="mcp-client-item">
                <span class="mcp-client-icon">&Delta;</span>
                <div class="mcp-client-meta">
                  <strong>Claude Desktop</strong>
                  <span>Anthropic Native GUI</span>
                </div>
              </div>
              <div class="mcp-client-item">
                <span class="mcp-client-icon">&bull;</span>
                <div class="mcp-client-meta">
                  <strong>Cursor &amp; Windsurf</strong>
                  <span>Agentic IDE Workflows</span>
                </div>
              </div>
              <div class="mcp-client-item">
                <span class="mcp-client-icon">&lambda;</span>
                <div class="mcp-client-meta">
                  <strong>Autonomous Python Agents</strong>
                  <span>LangChain, CrewAI, Custom</span>
                </div>
              </div>
            </div>

            {/* Flow 1: Protocol Connector */}
            <div class="mcp-arch-arrow">
              <div class="mcp-arrow-line">
                <span class="mcp-pulse-dot"></span>
              </div>
              <div class="mcp-arrow-label">
                <strong>Model Context Protocol</strong>
                <span>JSON-RPC 2.0 / SSE</span>
              </div>
            </div>

            {/* Column 2: 10zebra FastMCP Server */}
            <div class="mcp-arch-node mcp-arch-node--server">
              <div class="mcp-node-header">
                <span class="mcp-node-badge mcp-node-badge--brand">10zebra FastMCP</span>
                <h4>Stateless Gateway</h4>
              </div>
              <div class="mcp-server-box">
                <div class="mcp-subbox">
                  <strong>{stats.totalTools} Callable Tools</strong>
                  <span>generate, add_shot, trim, cut</span>
                </div>
                <div class="mcp-subbox">
                  <strong>{stats.totalResources} Live Resources</strong>
                  <span>board://, models://, funds://</span>
                </div>
                <div class="mcp-subbox">
                  <strong>Multi-Tenant Router</strong>
                  <span>portal_id isolation on every call</span>
                </div>
              </div>
              <div class="mcp-security-flag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Zero Database Credentials on Host</span>
              </div>
            </div>

            {/* Flow 2: Cloud Gateway */}
            <div class="mcp-arch-arrow">
              <div class="mcp-arrow-line">
                <span class="mcp-pulse-dot mcp-pulse-dot--delayed"></span>
              </div>
              <div class="mcp-arrow-label">
                <strong>mcpAction Cloud API</strong>
                <span>x-mcp-key &bull; agent:uid</span>
              </div>
            </div>

            {/* Column 3: 10zebra Production Engine & Guardrails */}
            <div class="mcp-arch-node mcp-arch-node--cloud">
              <div class="mcp-node-header">
                <span class="mcp-node-badge mcp-node-badge--secure">Authoritative Cloud</span>
                <h4>Credit Guard &amp; Transcode</h4>
              </div>
              <div class="mcp-cloud-box">
                <div class="mcp-cloud-row">
                  <span class="mcp-check-icon">&check;</span>
                  <span><strong>Atomic Firestore Transaction:</strong> Deducts from project balance</span>
                </div>
                <div class="mcp-cloud-row">
                  <span class="mcp-check-icon">&check;</span>
                  <span><strong>Credit Firewall:</strong> HTTP 402 on shortfall with human top-up URL</span>
                </div>
                <div class="mcp-cloud-row">
                  <span class="mcp-check-icon">&check;</span>
                  <span><strong>Trigger Fanout:</strong> Creates authoritative veneer documents</span>
                </div>
              </div>

              {/* Model Fanout Pills */}
              <div class="mcp-model-fanout">
                <span class="mcp-model-tag">Kling 3.0</span>
                <span class="mcp-model-tag">Veo 3</span>
                <span class="mcp-model-tag">Sora</span>
                <span class="mcp-model-tag">Runway Gen-4</span>
                <span class="mcp-model-tag">Wan 2.1</span>
                <span class="mcp-model-tag">Grok</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------
        4. DYNAMIC TECHNICAL SPECIFICATION (PULLED FROM APP CODE)
    -------------------------------------------------------------- */}
    <section id="tools-reference" class="section mcp-catalog-section">
      <div class="wrap">
        <div class="mcp-section-header">
          <div class="mcp-sync-badge">
            <span class="mcp-sync-dot"></span>
            <span>Synced from App Codebase ({stats.totalTools} Tools &bull; {stats.totalResources} Resources &bull; {stats.totalPrompts} Prompts)</span>
          </div>
          <h2 class="mcp-section-title">Supported Tools, Resources &amp; Prompts</h2>
          <p class="mcp-section-sub">
            The authoritative capability matrix extracted directly from <code>../10z/mcp/server.py</code> and enforced by 10zebra Cloud Functions.
          </p>
        </div>

        {/* Tab Switcher */}
        <div class="mcp-tabs" role="tablist">
          <button class="mcp-tab active" data-tab="tools" role="tab" aria-selected="true">
            Callable Tools ({tools.length})
          </button>
          <button class="mcp-tab" data-tab="resources" role="tab" aria-selected="false">
            Live Resources ({resources.length})
          </button>
          <button class="mcp-tab" data-tab="prompts" role="tab" aria-selected="false">
            Director Prompts ({prompts.length})
          </button>
          <button class="mcp-tab" data-tab="env" role="tab" aria-selected="false">
            Environment &amp; Config ({envVars.length})
          </button>
        </div>

        {/* Tab 1: Tools (Dynamic) */}
        <div class="mcp-tab-pane active" id="pane-tools">
          <div class="mcp-spec-grid">
            {tools.map((tool) => (
              <div class="glass mcp-spec-card">
                <div class="mcp-spec-card__top">
                  <span class="mcp-pill mcp-pill--orange">Tool</span>
                  <code class="mcp-fn-name">{tool.name}()</code>
                </div>
                <p class="mcp-spec-summary">{tool.summary}</p>

                {tool.parameters && tool.parameters.length > 0 && (
                  <div class="mcp-spec-args">
                    <strong>Parameters ({tool.parameters.length}):</strong>
                    <ul>
                      {tool.parameters.map((p) => (
                        <li>
                          <code>{p.name}</code>
                          <span class="mcp-param-type">({p.type})</span>
                          {p.required ? (
                            <span class="mcp-param-req">required</span>
                          ) : (
                            <span class="mcp-param-opt">default: {p.default || 'None'}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        {/* Tab 2: Resources (Dynamic) */}
