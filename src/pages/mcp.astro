                  <strong>Arguments:</strong> <code>{prompt.args}</code>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Tab 4: Environment Variables (Dynamic) */}
        <div class="mcp-tab-pane" id="pane-env">
