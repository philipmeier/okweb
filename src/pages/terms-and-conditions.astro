---
// src/pages/terms-and-conditions.astro
import Layout from "/src/layouts/Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";

const pageTitle = "Terms & Conditions | 10zebra";
const pageDescription =
  "Read the Terms and Conditions ('Terms') governing your access to and use of the 10z, LLC ('10zebra') platform, website services, user interfaces, products, and associated content and software applications.";
const canonicalUrl = "https://10zebra.com/terms-and-conditions";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-US",
      "isPartOf": {
        "@id": "https://10zebra.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://10zebra.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Terms & Conditions",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main-content" class="py-12 md:py-20 relative overflow-hidden">
    <div
      class="absolute top-24 left-1/2 -translate-x-1/2 w-[650px] h-[300px] pointer-events-none rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(ellipse, var(--accent) 0%, rgba(251,191,36,0.25) 50%, transparent 80%);"
      aria-hidden="true"
    ></div>

    <div class="wrap relative z-10 max-w-4xl mx-auto">
      <!-- Legal & IP Navigation Tabs -->
      <nav aria-label="Legal and intellectual property pages" class="flex flex-wrap items-center gap-2 mb-8">
        <a
          href="/privacy-policy/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-and-conditions/index.html"
          aria-current="page"
          class="px-4 py-1.5 rounded-full text-xs font-bold border border-[var(--accent)] bg-[var(--accent-subtle)] text-[var(--accent)] transition-colors no-underline"
        >
          Terms &amp; Conditions
        </a>
        <a
          href="/patents/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Patents
        </a>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <span class="sect-label">10z, LLC &middot; Terms of Service</span>
        <h1 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight text-[var(--text-primary)] mt-1" style="font-family:var(--font-display);">
          Terms &amp; Conditions
        </h1>
        <p class="text-xs font-mono text-[var(--text-muted)] mt-2">
          Last modified: February, 2023.
        </p>
      </div>

      <!-- Content Card -->
      <article class="glass p-7 sm:p-10 rounded-2xl border border-[var(--border-subtle)] space-y-8 text-[var(--text-secondary)] leading-relaxed text-sm sm:text-base">
        <!-- Intro -->
        <div class="space-y-4">
          <p>
            Hello, and welcome to 10z, LLC (&ldquo;10z&rdquo;, &ldquo;we&rdquo;, &ldquo;us&rdquo; or &ldquo;our&rdquo;) and our Terms and Conditions (the &ldquo;Terms&rdquo;). These Terms govern your access to and use of the 10z platform, website services, user interfaces, products, as well as all content and software applications associated with our services, or any videos or other content or material that is made available through 10z (collectively, the &ldquo;10z&rdquo; Services&rdquo;).
          </p>
          <p class="p-4 rounded-xl bg-[rgba(12,13,16,0.65)] border border-[var(--border-subtle)] text-xs sm:text-sm font-semibold text-[var(--text-primary)]">
            BY SIGNING UP TO, ACCESSING AND/OR USING THE 10Z SERVICES, YOU ACKNOWLEDGE, ACCEPT AND AGREE TO BE BOUND AND ABIDE BY THESE TERMS, OUR PRIVACY POLICY (THE <a href="/privacy-policy/index.html" class="text-[var(--accent)] underline hover:text-amber-300">&ldquo;PRIVACY POLICY&rdquo;</a>). THE PRIVACY POLICY IS INCORPORATED HEREIN BY REFERENCE.
          </p>
          <p>
            If you do not wish to agree to these Terms, the <a href="/privacy-policy/index.html" class="text-[var(--accent)] underline hover:text-amber-300">Privacy Policy</a>, you must not access or use the 10z Services. These Terms apply to all visitors, users, and others who access the 10z Services.
          </p>
        </div>

        <!-- 1. 10z Services -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            1. 10z Services
          </h2>
          <p>
            The 10z Services provide software, website, and a variety of platforms for the development, distribution, usage, training, and commercialization of machine learning models. Your right to access and use the 10z Services is contingent upon your access and use of the 10z Services solely in accordance with these Terms. The 10z Services are in public beta form.
          </p>
        </section>

        <!-- 2. Use of the 10z Services -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            2. Use of the 10z Services
          </h2>
          <p>
            The 10z Services are offered and available to users who are 13 years of age or older and who are not barred from receiving 10z Services under the laws of the United States or other countries, including the country in which you are a resident or from which you use the 10z Services. By using the 10z Services, you represent and warrant that you are at least 13 years of age and meet all of the foregoing eligibility requirements. If you do not meet all of these requirements, you must not access or use the 10z Service.
          </p>
          <p>
            You agree and acknowledge that your access and use the 10z Services is not contingent on the delivery of any future functionality or features or dependent on any oral or written public comments made by 10z or any of its affiliates regarding future functionality or features.
          </p>
        </section>

        <!-- 3. Accessing the 10z Services; Account Security -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            3. Accessing the 10z Services; Account Security
          </h2>
          <p>
            We reserve the right to withdraw or amend these Terms and/or the 10z Services at any time, and any other service or material we provide in connection therewith, in our sole discretion without notice. We will not be liable if for any reason all or any part of the 10z Services are unavailable at any time or for any period. From time to time, we may restrict access to some parts of the 10z Services, or all of the 10z Services, to users, including registered users.
          </p>
          <p>You are responsible for both:</p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>Making all arrangements necessary for you to have access to the 10z Services; and</li>
            <li>Ensuring that all persons who access the 10z Services through your internet connection are aware of these Terms and comply with them.</li>
          </ul>
        </section>

        <!-- 4. Your Account and Use of the 10z Services -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            4. Your Account and Use of the 10z Services
          </h2>
          <p>
            To access the 10z Services, you may be asked to provide certain registration details or other information. It is a condition of your use of the 10z Services that all of the information that you provide is correct, current, and complete. You agree that all information that you provide to register in connection with your use of the 10z Services or otherwise is governed by the <a href="/privacy-policy/index.html" class="text-[var(--accent)] underline hover:text-amber-300">Privacy Policy</a> and you consent to all actions we take with respect to your information consistent with our <a href="/privacy-policy/index.html" class="text-[var(--accent)] underline hover:text-amber-300">Privacy Policy</a>.
          </p>
          <p>
            If you choose, or are provided with, a username, password, or any other piece of information as part of our security procedures, you must treat such information as confidential, and you must not disclose it to any other person or entity. You also acknowledge that your account is personal to you and agree not to provide any other person with access to the 10z Services or portions of it using your username, password, or other security information. You agree to notify us immediately of any unauthorized access to or use of your username or password or any other breach of security. You also agree to ensure that you exit from your account at the end of each session. You should use particular caution when accessing your account from a public or shared computer, so that others are not able to view or record your password or other personal information.
          </p>
          <p>
            You must provide accurate and complete registration information whenever you register to use the 10z Services. You are responsible for the security of your password and for any use of your account. If you become aware of any unauthorized use of your password or of your account, you must notify 10z immediately at <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>.
          </p>
          <p>
            Your access and use of the 10z Services must comply with all applicable laws, regulations and ordinances, including any laws regarding the export of data or software.
          </p>
          <p>
            You agree not to (a) access (or attempt to access) the administrative interface of the 10z Services by any means other than through the interface that is provided by 10z, unless you have been specifically permitted do so by us in a separate agreement with 10z; or (b) engage in any activity that interferes with or disrupts the 10z Services (or the servers and networks that are connected to the 10z Services) or that violates these Terms.
          </p>
          <p>
            You may not access the 10z Services for the purpose of bringing an intellectual property infringement claim against 10z or for the purpose of creating a product or service competitive with the 10z Services.
          </p>
          <p>
            If you create a 10z account on behalf of a legal entity, such as your business or employer, you represent that you have the legal authority to bind that entity to these Terms.
          </p>
          <p>
            Subject to your acceptance of, and compliance with, these Terms, you may use the 10z Services for the sole purposes of testing the 10z Services and providing Feedback (as defined below).
          </p>
          <p>
            You are responsible for all activity that occurs under your 10z account. You may receive notifications associated with your 10z account if we believe that you need to be notified of certain changes, developments or modifications to the 10z Services. We may also send you 10z Service notifications by other means. If the 10z Services are canceled (whether by you or us), your right to access the 10z Services will immediately cease. In addition, we have the right to delete all data associated with your account and use of the 10z Services (except to the extent prohibited by applicable law).
          </p>
          <p>
            If we reasonably suspect that your 10z account is being used by a third party fraudulently or that violates our <a href="/privacy-policy/index.html" class="text-[var(--accent)] underline hover:text-amber-300">Privacy Policy</a>, 10z may suspend your account immediately without notice.
