---
// src/pages/privacy-policy.astro
import Layout from "/src/layouts/Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";

const pageTitle = "Privacy Policy | 10zebra";
const pageDescription =
  "This Privacy Policy explains how 10z, LLC ('10z', '10zebra', 'we,' or 'us') collects, uses, discloses, and protects information that applies to the 10z Services, including our CCPA Privacy Notice for California residents.";
const canonicalUrl = "https://10zebra.com/privacy-policy";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-US",
      "isPartOf": {
        "@id": "https://10zebra.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://10zebra.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Privacy Policy",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main-content" class="py-12 md:py-20 relative overflow-hidden">
    <div
      class="absolute top-24 left-1/2 -translate-x-1/2 w-[650px] h-[300px] pointer-events-none rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(ellipse, var(--accent) 0%, rgba(251,191,36,0.25) 50%, transparent 80%);"
      aria-hidden="true"
    ></div>

    <div class="wrap relative z-10 max-w-4xl mx-auto">
      <!-- Legal & IP Navigation Tabs -->
      <nav aria-label="Legal and intellectual property pages" class="flex flex-wrap items-center gap-2 mb-8">
        <a
          href="/privacy-policy/index.html"
          aria-current="page"
          class="px-4 py-1.5 rounded-full text-xs font-bold border border-[var(--accent)] bg-[var(--accent-subtle)] text-[var(--accent)] transition-colors no-underline"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-and-conditions/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Terms &amp; Conditions
        </a>
        <a
          href="/patents/index.html"
          class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors no-underline"
        >
          Patents
        </a>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <span class="sect-label">10z, LLC &middot; Legal &amp; Privacy</span>
        <h1 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight text-[var(--text-primary)] mt-1" style="font-family:var(--font-display);">
          Privacy Policy
        </h1>
        <p class="text-xs font-mono text-[var(--text-muted)] mt-2">
          Last updated: February, 2023.
        </p>
      </div>

      <!-- Content Card -->
      <article class="glass p-7 sm:p-10 rounded-2xl border border-[var(--border-subtle)] space-y-8 text-[var(--text-secondary)] leading-relaxed text-sm sm:text-base">
        <!-- Intro -->
        <div class="space-y-4">
          <p>
            This Privacy Policy explains how 10z, LLC (&ldquo;10z&rdquo;, &ldquo;we,&rdquo; or &ldquo;us&rdquo;) collects, uses, discloses, and protects information that applies to the 10z Services, and your choices about the collection and use of your information by us. Capitalized terms that are not defined in this Privacy Policy have the meaning given to such terms in our <a href="/terms-and-conditions/index.html" class="text-[var(--accent)] underline hover:text-amber-300">Terms of Service</a>.
          </p>
          <div>
            <p class="mb-2">This Privacy Policy does not apply to information collected by:</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>Us offline or through any other means; or</li>
              <li>Any third party, including through any application or content that may link to or be accessible in connection with the 10z Services.</li>
            </ul>
          </div>
          <p>
            Please read this Privacy Policy carefully to understand our policies and practices regarding your information and how we will treat it. If you do not agree with our policies and practices, your choice is not to use the 10z Services. By accessing or using the 10z Services, you agree to this Privacy Policy. This Privacy Policy may change from time to time. Your continued use of the 10z Services after we make changes is deemed to be acceptance of those changes, so please check the Privacy Policy periodically for updates.
          </p>
        </div>

        <!-- 1. Information We Collect About You and How We Collect It -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            1. Information We Collect About You and How We Collect It
          </h2>
          <p>We collect several types of information from and about users of the 10z Services, including information:</p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>By which you may be personally identified, such as name, postal address, e-mail address, telephone number, or any other identifier by which you may be contacted online or offline (&ldquo;personal data&rdquo;); and</li>
            <li>About your internet connection, the equipment you use to access the 10z Services, and usage details.</li>
          </ul>
          <p>We collect this information:</p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>Directly from you when you provide it to us; and</li>
            <li>Automatically as you navigate through the 10z Services. Information collected automatically may include usage details, IP addresses, and information collected through cookies, web beacons, and other tracking technologies.</li>
          </ul>
          <p>The information we collect on or through the 10z Services may include:</p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>Information that you provide by filling in forms in connection with the 10z Services. This includes information provided at the time of registering to use the 10z Services, posting material, or requesting assistance. We may also ask you for information when you report a problem with or have a question about the 10z Services;</li>
            <li>Records and copies of your correspondence (including email addresses), if you contact us;</li>
            <li>Details of your use of and access to the 10z Services;</li>
            <li>Your search queries on the 10z Services; and</li>
            <li>File data types and associated meta data regarding models.</li>
          </ul>
          <p>
            You also may provide information to be published or displayed (&ldquo;posted&rdquo;) on public areas of the 10z Services or transmitted to other users of the 10z Services or third parties (collectively, &ldquo;User Contributions&rdquo; and each, &ldquo;User Contribution&rdquo;). Your User Contributions are posted on and transmitted to others at your own risk. Although we may limit access to certain pages and 10z Services, please be aware that no security measures are perfect or impenetrable. Additionally, we cannot control the actions of other users of the 10z Services with whom you may choose to share your User Contributions. Therefore, we cannot and do not guarantee that your User Contributions will not be viewed by unauthorized persons. Please note that we use this information to operate, maintain, improve and provide to you the features and functionality of the 10z Services.
          </p>
        </section>

        <!-- 2. Information We Collect Through Automatic Data Collection Technology -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            2. Information We Collect Through Automatic Data Collection Technology
          </h2>
          <p>
            As you navigate through and interact with the 10z Services, we may use automatic data collection technologies to collect certain information about your equipment, browsing actions, and patterns, including:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>Details of your access to and use of the 10z Services, including traffic data, location data, logs, and other communication data and the resources that you access and use in connection with the 10z Services; and</li>
            <li>Information about your computer and internet connection, including your IP address, operating system, and browser type.</li>
          </ul>
          <p>
            The information that we collect automatically may include personal data and such collection helps us to improve the 10z Services and to deliver a better and more personalized service, including by enabling us to:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>Estimate our audience size and usage patterns;</li>
            <li>Store information about your preferences, which allows us to customize the 10z Services according to your individual interests;</li>
            <li>Speed up your searches; and</li>
            <li>Recognize you when you use the 10z Services.</li>
          </ul>
          <p>The technologies we use for this automatic data collection may include:</p>
          <ul class="list-disc pl-6 space-y-2.5">
            <li>
              <strong class="text-[var(--text-primary)]">Analytics information:</strong> We may directly collect analytics data, or use third-party analytics tools, to help us measure traffic and usage trends for the 10z Services. These tools collect information sent by the 10z Services, including the pages you visit and other information that assists us in improving the 10z Services. We collect and use this analytics information in aggregate form, such that it cannot reasonably be manipulated to identify any particular individual user;
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Cookies Information:</strong> When you access and use the 10z Services, we may send one or more cookies &mdash; a small text file containing a string of alphanumeric characters &mdash; to your computer that uniquely identifies your access and use of the 10z Services and lets 10z help you log in faster and enhance your navigation through the 10z Services. A cookie may also convey information to us about how you use the 10z Services (e.g., the pages that you view, the links you click and other actions you take on the 10z Services), and allow us to track your usage of the 10z Services over time. A persistent cookie remains on your hard drive after you close the 10z Services and browser. Persistent cookies may be used by your browser and on the applicable 10z Services on subsequent access and use of the 10z Services. A session cookie is temporary and disappears after you close your browser. You can reset your web browser to refuse all cookies or to indicate when a cookie is being sent. However, some features of the 10z Services may not function properly if the ability to accept cookies is disabled;
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Log file Information:</strong> Log file information is automatically reported by the 10z Services each time that you access the 10z Services. When you use the 10z Services, our servers automatically record certain log file information. These server logs may include anonymous information such as your request, IP address, machine type, referring / exit pages and URLs, number of clicks and how you interact with links on the 10z Services, domain names, landing pages, pages viewed, and other such information;
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Clear Gifs/Web Beacons Information:</strong> When you use the 10z Services, we may employ clear gifs (also known as web beacons), which are used to anonymously track the online usage patterns of our users. In addition, we may also use clear gifs in HTML-based emails sent to our users to track which emails are opened and which links are clicked by recipients. The information allows for more accurate reporting and improvement of the 10z Services; and
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Communications:</strong> We use the information we collect or receive to communicate directly with you. If you do not want to receive such email messages, you will be given the option to opt out or change your preferences. We also use your information to send you 10z Services-related emails (e.g., account verification, changes/updates to features of the 10z Services, technical and security notices).
            </li>
          </ul>
          <p>
            We use or may use cookies, log file, device identifiers, location data and clear gifs information to (i) remember information so that you will not have to re-enter it during your visit or the next time you visit the 10z Services; (ii) provide custom, personalized content and information; (iii) provide and monitor the effectiveness of the 10z Services; (iv) monitor aggregate metrics such as total number of visitors, traffic, and demographic patterns; (v) diagnose or fix technology problems; and (vi) help you efficiently access your information after you sign in.
          </p>
        </section>

        <!-- 3. How We Use Your Personal Data -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            3. How We Use Your Personal Data
          </h2>
          <p>We use personal data that we collect about you or that you provide to us, including any personal data:</p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>To respond to your inquiries and fulfill your requests;</li>
            <li>To provide services to you;</li>
            <li>To provide you with notices about your account, including expiration and renewal notices;</li>
            <li>To present the 10z Services and its contents to you;</li>
            <li>To inform you about information regarding the 10z Services, products or services for which you apply or may be interested in applying for, or in which you are already enrolled, changes to terms, conditions, and policies and/or other administrative information;</li>
            <li>To verify your identity and/or location (or the identity or location of your representative or agent) in order to allow access to your accounts, conduct online transactions and to maintain measures aimed at preventing fraud and protecting the security of account and personal data;</li>
            <li>To allow you to participate in interactive features of the 10z Services, including surveys and other forms of research;</li>
            <li>To help us to improve the 10z Services and to deliver a better and more useful experience to our customers and to understand which parts of the 10z Services may be of most interest;</li>
            <li>To carry out our obligations and enforce our rights arising from any contracts entered into between you and us, including for billing and collection;</li>
            <li>To comply with a legal obligation or to carry out a legitimate interest that we or a third party may have; and</li>
            <li>In any other way we may describe when you provide the information.</li>
          </ul>
        </section>

        <!-- 4. Sharing of Your Information -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            4. Sharing of Your Information
          </h2>
          <p>
            We do not and will not rent or sell your information to third parties outside of 10z and its affiliates without your consent, except as noted below:
          </p>
          <ul class="list-disc pl-6 space-y-2.5">
            <li>
              <strong class="text-[var(--text-primary)]">What Happens in the Event of a Change of Control:</strong> We may buy or sell/divest/transfer 10z (including any shares in 10z), or any combination of its products, services, assets and/or businesses. Your information, such as names and email addresses, User Contribution and other user information related to the 10z Services may be among the items sold or otherwise transferred in these types of transactions. We may also sell, assign or otherwise transfer such information in the course of corporate divestitures, mergers, acquisitions, bankruptcies, dissolutions, reorganizations, liquidations, similar transactions or proceedings involving all or a portion of 10z;
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Instances Where We Are Required to Share Your Information:</strong> 10z will disclose your information where required to do so by law or subpoena or if we reasonably believe that such action is necessary to (i) comply with the law and the reasonable requests of law enforcement; (ii) enforce our Terms of Service or to protect the security or integrity of the 10z Services; and/or (iii) to exercise or protect the rights, property, or personal safety of 10z, our users or others; and
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Sharing Certain Service Type Information We Collect About You:</strong> We may share certain service type information, including information obtained through tools such as cookies, log files, and clear gifs (including, without limitation, anonymous usage data, referring/exit pages and URLs, platform types, and number of clicks). We may also aggregate or otherwise strip data of all personally identifying characteristics and may share that aggregated, anonymized data with third parties.
            </li>
          </ul>
        </section>

        <!-- 5. How We Store and Protect Your Information -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            5. How We Store and Protect Your Information
          </h2>
          <ul class="list-disc pl-6 space-y-2.5">
            <li>
              <strong class="text-[var(--text-primary)]">Storage and Processing:</strong> Currently, information collected through the 10z Services is stored and processed in the United States.
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Keeping Your Information Safe:</strong> 10z cares about the security of your information, and uses safeguards to preserve the integrity and security of all information collected through the 10z Services. To protect your privacy and security, we take reasonable steps (such as requesting a unique password and token identification) to verify your identity before granting you access to your account. You are responsible for maintaining the secrecy of your unique password and account information, and for controlling access to your email communications from 10z, at all times. However, 10z cannot ensure or warrant the security of any information that you transmit to 10z or guarantee that information on the 10z Services may not be accessed, disclosed, altered, or destroyed. Your privacy settings may also be affected by changes to the functionality of third party sites and services that you add to the 10z Services, such as social networks. 10z is not responsible for the functionality or security measures of any third party; and
            </li>
            <li>
              <strong class="text-[var(--text-primary)]">Compromise of Information:</strong> In the event that any information under our control is compromised as a result of a breach of security, 10z will investigate the situation without undue delay and, where appropriate, notify those individuals whose information may have been compromised and take other steps, in accordance with any applicable laws and regulations.
            </li>
          </ul>
        </section>

        <!-- 6. Your Choices About Your Information -->
        <section class="space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            6. Your Choices About Your Information
          </h2>
          <p>
            <strong class="text-[var(--text-primary)]">You Control, Review and Change Your Personal data, Account Information and Settings:</strong> You can update your account information and email-communication preferences at any time by logging into your account and changing your profile settings. You can also stop receiving promotional email communications from us by clicking on the &ldquo;unsubscribe link&rdquo; provided in such communications. We make every effort to promptly process all unsubscribe requests. As noted above, except as provided by applicable law, you may not opt out of 10z Services-related communications (e.g., account verification, purchase and billing confirmations and reminders, changes/updates to features of the 10z Services, technical and security notices). Notwithstanding the foregoing, under the new European Union law called the General Data Protection Regulation, you have certain rights relating to your personal data. Except as limited under applicable law, you have the following rights:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>The right to be informed of and request access to the personal data that we process about you;</li>
            <li>The right to request that we amend or update your personal data where it is inaccurate or incomplete;</li>
            <li>The right to request that we temporarily or permanently stop processing all or some of your personal data;</li>
            <li>The right to object to us processing your personal data where we no longer have a legitimate or legal need to process it;</li>
            <li>The right to object to being subject to a decision based solely on automated decision-making, including profiling, where the decision would have a legal effect on your or produce a similarly significant effect;</li>
            <li>The right to request a copy of your personal data in a machine readable format and the right to transmit that personal data for use in another party&rsquo;s service; and</li>
            <li>The right to request that we delete your personal data.</li>
          </ul>
          <p>
            If you have any questions about reviewing, correcting, deleting or modifying your personal data and account information, you can contact us directly at <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>. If you delete your User Contributions from the 10z Services, copies of your User Contributions may still remain viewable in cached and archived pages, or might have been copied or stored by other users of the 10z Services; and
          </p>
          <p>
            <strong class="text-[var(--text-primary)]">Opting out of Collection of Your Information for Tracking:</strong> Please refer to your browser&rsquo;s technical information for instructions on how to delete and disable cookies, and other tracking/recording tools. Note that disabling cookies and/or other tracking tools may prevent 10z or its business partners from tracking your browser&rsquo;s activities in relation to the 10z Services. However, doing so may disable many of the features available through the 10z Services. Also, you may contact us if you wish to opt-out and exercise your right to be forgotten under applicable laws. If you have any questions about opting out of the collection of cookies and other tracking/recording tools, you can always contact us directly at <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>.
          </p>
          <p>
            California residents may have additional personal information rights and choices. Please see our <a href="#ccpa" class="text-[var(--accent)] underline hover:text-amber-300">CCPA Privacy Notice for more information.</a>
          </p>
        </section>

        <!-- 7. How Long We Keep User Contribution -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            7. How Long We Keep User Contribution
          </h2>
          <p>
            Following termination or deactivation of your user account, except as limited by applicable law, 10z may retain your profile information and User Contribution for a commercially reasonable time for backup, archival, or audit purposes.
          </p>
        </section>

        <!-- 8. Children under the Age of 13 -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            8. Children under the Age of 13
          </h2>
          <p>
            The 10z Services (including this website) are not intended for children under 13 years of age. No one under the age of 13 may provide any information to or on this website. We do not knowingly collect personal data from children under 13. If you are under 13, do not use or provide any information on this website or through any of its features about yourself to us, including your name, address, telephone number, email address, or any screen name or user name you may use. If we learn that we have collected or received personal data from a child under 13 without verification of parental consent, we will immediately delete that information. If you believe we might have any information from or about a child under 13, please contact us at <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>.
          </p>
        </section>

        <!-- 9. Third Party Use of Cookies; Other Tracking Technologies -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            9. Third Party Use of Cookies; Other Tracking Technologies
          </h2>
          <p>
            Some content or applications used by the 10z Services are served by third-parties, and servers. These third parties may use cookies alone or in conjunction with web beacons or other tracking technologies to collect information about you when you use the 10z Services. The information that they collect may be associated with your personal data or they may collect information, including personal data, about your online activities over time and across different websites and other online services. They may use this information to provide you with interest-based (behavioral) targeted content. We do not control these third parties&rsquo; tracking technologies or how they may be used. If you have any questions about targeted content, you should contact the responsible provider directly.
          </p>
        </section>

        <!-- 10. Links to Other Websites and Services -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            10. Links to Other Websites and Services
          </h2>
          <p>
            We are not responsible for the practices employed by websites or services linked to or from the 10z Services, including the information or content contained therein. Please remember that when you use a link to go from the 10z Services to another website, our Privacy Policy does not apply to third-party websites or services. Your browsing and interaction on any third-party website or service, including those that have a link on our website, are subject to that third party&rsquo;s own rules and policies. In addition, you agree that we are not responsible for and we do not have control over any third-parties that you authorize to access your User Contribution. If you are using a third-party website or service and you allow such a third-party access to your User Contribution you do so at your own risk. As a reminder, this Privacy Policy does not apply to information we collect by other means (including offline) or from other sources other than through the 10z Services.
          </p>
        </section>

        <!-- 11. How to Contact Us -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            11. How to Contact Us
          </h2>
          <p>
            If you have any questions about this Privacy Policy or the 10z Services, please contact us at <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>. As a reminder, you can always opt-out sending us an email with your request to <a href="mailto:support@10zebra.com" class="text-[var(--accent)] underline hover:text-amber-300">support@10zebra.com</a>.
          </p>
        </section>

        <!-- 12. Changes to this Privacy Policy -->
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
            12. Changes to this Privacy Policy
          </h2>
          <p>
            10z may modify or update this Privacy Policy from time to time to reflect the changes in our business and practices, and so you should review this page periodically. When we change this Privacy Policy, we will let you know by updating the &ldquo;last modified&rdquo; date at the bottom of this page. You are responsible for ensuring we have an up-to-date active and deliverable email address for you, and for periodically accessing and using the 10z Services and this Privacy Policy to check for any changes. This Privacy Policy was last modified on February, 2023.
          </p>
        </section>

        <!-- Divider before CCPA Privacy Notice -->
        <hr class="border-[var(--border-subtle)] my-8" />

        <!-- CCPA Privacy Notice -->
        <section id="ccpa" class="space-y-6 scroll-mt-24">
          <div>
            <span class="sect-label">California Residents</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] mt-1" style="font-family:var(--font-display);">
              CCPA Privacy Notice
            </h2>
            <p class="text-xs font-mono text-[var(--text-muted)] mt-1">
              Last updated: February 3, 2023.
            </p>
          </div>

          <p>
            This Privacy Notice for California Residents (&ldquo;CCPA Privacy Notice&rdquo;) supplements the information contained in 10z&rsquo;s Privacy Notice and applies solely to all visitors, users, and others who reside in the State of California (&ldquo;consumers&rdquo; or &ldquo;you&rdquo;). 10z has adopted this CCPA Privacy Notice to comply with the California Consumer Privacy Act of 2018 (&ldquo;CCPA&rdquo;) and any terms defined in the CCPA have the same meaning when used in this CCPA Privacy Notice.
          </p>

          <!-- CCPA 1. Information We Collect -->
          <div class="space-y-4">
            <h3 class="text-lg font-bold text-[var(--text-primary)]" style="font-family:var(--font-display);">
              1. Information We Collect
