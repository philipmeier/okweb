---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  label?: string;
  description?: string;
  cta?: { text: string; href: string };
}

const {
  title,
  label = "Coming Soon",
  description = "This page is under active development. Sign up to be notified when it launches.",
  cta = { text: "Back to Home", href: "/" },
} = Astro.props;
---

<Layout title={`${title} | 10zebra`} description={description}>
  <Header />
  <main class="min-h-[80vh] flex items-center justify-center py-24">
    <div class="text-center px-6 max-w-lg mx-auto">
      <div class="badge inline-flex mx-auto mb-6">{label}</div>
      <h1 class="text-4xl font-black mb-4 tracking-[-1px]" style="font-family:var(--font-display);">{title}</h1>
      <p class="text-[var(--text-secondary)] mb-8 leading-relaxed">{description}</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href={cta.href} class="btn btn-primary btn-lg">{cta.text}</a>
        <a href="/signup" class="btn btn-ghost btn-lg">Start Free &rarr;</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
