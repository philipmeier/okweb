---
/**
 * Feature detail template. Shared by every /features/* page.
 *
 * Section flow (mirrors the solution pages):
 * Hero (backdrop + app-window visual) → Stats → [interactive-demo slot] →
 * Phase banner → Workflow stepper → Deep dive → [default slot] →
 * Old way vs. 10zebra way → Who uses it → FAQ → Related → Final CTA.
 *
 * Imagery comes from src/data/features.ts (matched by URL), so pages don't need
 * to pass media. Props API is unchanged from the original template.
 */
import Layout from "./Layout.astro";
import Header from "/src/components/layout/Header.astro";
import Footer from "/src/components/layout/Footer.astro";
import FinalCTA from "/src/components/FinalCTA.astro";
import FeatureVisual from "/src/components/features/FeatureVisual.astro";
import FeatureCard from "/src/components/features/FeatureCard.astro";
import SolutionCard from "/src/components/solutions/SolutionCard.astro";
import ShiftList from "/src/components/shared/ShiftList.astro";
import { getFeatureByHref, phases } from "/src/data/features";
import { solutions } from "/src/data/solutions";

interface StatItem {
  value: string;
  label: string;
  detail?: string;
}

interface WorkflowStep {
  step: string;
  title: string;
  description: string;
  tag?: string;
}

interface FeatureItem {
  title: string;
  description: string;
  bullets: string[];
  tag?: string;
  icon?: string;
}

interface ComparisonRow {
  feature: string;
  zebra: string;
  competitor: string;
  zebraAdvantage?: boolean;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedFeature {
  title: string;
  description: string;
  href: string;
  badge?: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  headlineHighlight: string;
  subheadline: string;
  badgeText?: string;
  stats?: StatItem[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  workflowTitle?: string;
  workflowSubtitle?: string;
  workflowSteps?: WorkflowStep[];
  features?: FeatureItem[];
  comparisonTitle?: string;
  competitorLabel?: string;
  zebraLabel?: string;
  comparisonItems?: ComparisonRow[];
  faqs?: FaqItem[];
  relatedFeatures?: RelatedFeature[];
}

const {
  title,
  description,
  eyebrow,
  headline,
  headlineHighlight,
  subheadline,
  badgeText = "Feature Deep-Dive",
  stats = [],
  primaryCta = { label: "Start Free with 200 Credits", href: "/signup" },
  secondaryCta = { label: "Explore Feature Hub", href: "/features" },
  workflowTitle = "How It Works in 10zebra",
  workflowSubtitle = "From single direction to production-ready take in seconds.",
  workflowSteps = [],
  features = [],
  comparisonTitle = "The Old Way vs. the 10zebra Way",
  competitorLabel = "Single-Model AI Tools",
  zebraLabel = "10zebra Production Suite",
  comparisonItems = [],
  faqs = [],
  relatedFeatures = [],
} = Astro.props;

// ---- Helpers -------------------------------------------------------------
// Page props sometimes contain HTML entities (e.g. "&amp;") — decode for text nodes.
const decode = (s: string) =>
  s
    .replace(/&amp;/g, "&")
    .replace(/&mdash;/g, "—")
    .replace(/&ndash;/g, "–")
    .replace(/&rarr;/g, "→")
    .replace(/&nbsp;/g, " ");
const stripHtml = (s: string) => decode(s.replace(/<[^>]+>/g, "")).replace(/\s+/g, " ").trim();

const path = Astro.url.pathname.replace(/\/+$/, "");
const match = getFeatureByHref(path);
const featureKey = match?.[0];
const feature = match?.[1];
const phase = feature ? phases[feature.phase] : undefined;

const lead = decode(headline).replace(/:\s*$/, "");
const highlight = decode(headlineHighlight);
const crumb = feature?.short ?? lead;
const canonicalUrl = `https://10zebra.com${path}`;

const usedBy = featureKey ? solutions.filter((s) => (s.features as string[]).includes(featureKey)) : [];
const related = relatedFeatures.map((rel) => ({ rel, ref: getFeatureByHref(rel.href)?.[1] }));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...(faqs.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: faqs.map((f) => ({
              "@type": "Question",
              name: stripHtml(f.question),
              acceptedAnswer: { "@type": "Answer", text: stripHtml(f.answer) },
            })),
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://10zebra.com/" },
        { "@type": "ListItem", position: 2, name: "Features", item: "https://10zebra.com/features" },
        { "@type": "ListItem", position: 3, name: crumb, item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Header />

  <main class="fl overflow-hidden">
    <!-- ================= HERO ================= -->
    <section class="fl-hero" aria-labelledby="fl-heading">
      {feature && (
        <div class="fl-hero__backdrop" aria-hidden="true">
          <FeatureVisual feature={feature} single class="fl-hero__media" sizes="100vw" eager hideTag />
        </div>
      )}
      <div class="fl-hero__scrim" aria-hidden="true"></div>

      <div class="wrap fl-hero__inner">
        <div class="fl-hero__copy">
          <nav class="fl-crumbs" aria-label="Breadcrumb">
            <a href="/features">Features</a><span aria-hidden="true">/</span><span aria-current="page">{crumb}</span>
          </nav>
          <span class="fl-kicker"><span class="fl-dot" aria-hidden="true"></span>{eyebrow}</span>
          <h1 id="fl-heading">
            <span class="fl-h1__lead">{lead}</span><span class="sr-only">: </span>
            <span class="grad-text fl-h1__hl">{highlight}</span>
          </h1>
          <p class="fl-hero__sub">{decode(subheadline)}</p>
          <div class="fl-hero__ctas">
            <a href={primaryCta.href} class="btn btn-primary btn-lg" id="feature-primary-cta">
              {primaryCta.label}
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href={secondaryCta.href} class="btn btn-ghost btn-lg fl-ghost" id="feature-secondary-cta">{secondaryCta.label}</a>
          </div>
          <ul class="fl-trust">
            <li><span class="fl-check" aria-hidden="true">&#10003;</span>No subscription required</li>
            <li><span class="fl-check" aria-hidden="true">&#10003;</span>200 free credits</li>
            <li><span class="fl-check" aria-hidden="true">&#10003;</span>Team-ready</li>
          </ul>
        </div>

        <div class="fl-hero__visual">
          <div class="fl-window">
            <div class="fl-window__bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span>{badgeText}</span>
            </div>
            <div class="fl-window__body">
              {Astro.slots.has("hero-visual") ? (
                <slot name="hero-visual" />
              ) : feature ? (
                <div class="fl-window__media"><FeatureVisual feature={feature} eager /></div>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    {stats.length > 0 && (
      <div class="wrap">
        <div class="fl-stats glass reveal" style={`--n:${Math.min(stats.length, 4)}`}>
          {stats.map((stat) => (
            <div class="fl-stat" title={stat.detail}>
              <div class="fl-stat__value grad-text">{stat.value}</div>
              <div class="fl-stat__label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- INTERACTIVE DEMO / PLAYGROUND SLOT -->
    <slot name="interactive-demo" />

    <!-- ================= PHASE BANNER ================= -->
    {feature && phase && (
      <section class="wrap fl-banner-wrap" aria-label={`${phase.label} phase`}>
        <a href={`/features#phase-${feature.phase}`} class="fl-banner reveal">
          <FeatureVisual feature={feature} class="fl-banner__media" sizes="(max-width: 1200px) 100vw, 1200px" />
          <div class="fl-banner__scrim" aria-hidden="true"></div>
          <div class="fl-banner__copy">
            <span class="fl-banner__phase"><b>{phase.num}</b>{phase.label}</span>
            <p>{phase.line}</p>
            <span class="fl-banner__more">See every {phase.label.toLowerCase()} tool &rarr;</span>
          </div>
        </a>
      </section>
    )}

    <!-- ================= WORKFLOW ================= -->
    {workflowSteps.length > 0 && (
      <section class="section" aria-labelledby="fl-flow-heading">
        <div class="wrap">
          <div class="sect-head reveal">
            <span class="sect-label">Step-by-Step</span>
            <h2 id="fl-flow-heading">{workflowTitle}</h2>
            <p>{workflowSubtitle}</p>
          </div>

          <ol class="fl-steps reveal" style={`--n:${workflowSteps.length}`}>
            {workflowSteps.map((step, idx) => (
              <li class="fl-step" style={`--i:${idx}`}>
                <span class="fl-step__node" aria-hidden="true">{String(idx + 1).padStart(2, "0")}</span>
                {step.tag && <span class="fl-step__tag">{step.tag}</span>}
                <h3>{decode(step.title)}</h3>
                <p>{decode(step.description)}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ================= DEEP DIVE ================= -->
    {features.length > 0 && (
      <section class="section fl-section-alt" aria-labelledby="fl-deep-heading">
        <div class="wrap">
          <div class="sect-head reveal">
            <span class="sect-label">Deep Dive</span>
            <h2 id="fl-deep-heading">Built for Serious <span class="grad-text">Production Control</span></h2>
          </div>

          <div class="fl-pillars">
            {features.map((feat, i) => (
              <article class={`fl-pillar reveal reveal-d${(i % 3) + 1}`}>
                <div class="fl-pillar__top">
                  <span class="fl-pillar__num">{String(i + 1).padStart(2, "0")}</span>
                  {feat.tag && <span class="fl-pillar__tag">{feat.tag}</span>}
                </div>
                <h3>{decode(feat.title)}</h3>
                <p class="fl-pillar__desc">{decode(feat.description)}</p>
                <ul>
                  {feat.bullets.map((bullet) => (
                    <li>
                      <span class="fl-check" aria-hidden="true">&#10003;</span>
                      <span set:html={bullet} />
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CUSTOM CONTENT SLOT -->
    <slot />

    <!-- ================= OLD WAY vs 10ZEBRA ================= -->
    {comparisonItems.length > 0 && (
      <section class="section" aria-labelledby="fl-shift-heading">
        <div class="wrap">
          <div class="sect-head reveal">
            <span class="sect-label">The Difference</span>
            <h2 id="fl-shift-heading">{decode(comparisonTitle)}</h2>
          </div>

          <ShiftList
            beforeLabel={competitorLabel}
            afterLabel={zebraLabel}
            items={comparisonItems.map((item) => ({
              label: decode(item.feature),
              before: decode(item.competitor),
              after: decode(item.zebra),
            }))}
          />
        </div>
      </section>
    )}

    <!-- ================= WHO USES IT ================= -->
    {usedBy.length > 0 && (
      <section class="section fl-section-alt" aria-labelledby="fl-who-heading">
        <div class="wrap">
          <div class="sect-head reveal">
            <span class="sect-label">Who Uses It</span>
            <h2 id="fl-who-heading">A Core Tool for <span class="grad-text">{usedBy.map((s) => s.label).join(" & ")}</span></h2>
          </div>
          <div class="fl-who">
            {usedBy.map((s, i) => <SolutionCard solution={s} variant="compact" class={`reveal reveal-d${i + 1}`} />)}
          </div>
          <p class="fl-foot"><a href="/solutions" id="fl-all-solutions">See all solutions &rarr;</a></p>
        </div>
      </section>
    )}

    <!-- ================= FAQ ================= -->
    {faqs.length > 0 && (
      <section class="section" aria-labelledby="fl-faq-heading">
        <div class="wrap">
          <div class="sect-head reveal">
            <span class="sect-label">FAQ</span>
            <h2 id="fl-faq-heading">Frequently Asked Questions</h2>
          </div>
          <div class="fl-faq reveal">
            {faqs.map((faq, i) => (
              <details open={i === 0}>
                <summary>{decode(faq.question)}<span class="fl-faq__chev" aria-hidden="true">+</span></summary>
                <div class="fl-faq__a" set:html={faq.answer} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ================= RELATED ================= -->
    {related.length > 0 && (
      <section class="section fl-section-alt" aria-labelledby="fl-rel-heading">
        <div class="wrap">
          <div class="fl-rel__head reveal">
            <div>
              <span class="sect-label">More in the Workspace</span>
              <h2 id="fl-rel-heading">Pairs Well <span class="grad-text">With</span></h2>
            </div>
            <a href="/features" class="fl-rel__all">View all features &rarr;</a>
          </div>

          <div class="fl-rel">
            {related.map(({ rel, ref }, i) =>
              ref ? (
                <FeatureCard feature={ref} blurb={decode(rel.description)} class={`reveal reveal-d${i + 1}`} />
              ) : (
                <a href={rel.href} class={`fl-rel__text glass reveal reveal-d${i + 1}`}>
                  {rel.badge && <span class="fl-pillar__tag">{rel.badge}</span>}
                  <h3>{decode(rel.title)}</h3>
                  <p>{decode(rel.description)}</p>
                  <span>Learn more &rarr;</span>
                </a>
              )
            )}
          </div>
        </div>
      </section>
    )}

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .fl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    flex-shrink: 0;
  }
  .fl-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    font-size: 0.6rem;
    font-weight: 900;
    color: #0c0d10;
    background: var(--accent);
  }
  .fl-section-alt { background: linear-gradient(180deg, transparent, rgba(19, 20, 23, 0.55) 15%, rgba(19, 20, 23, 0.55) 85%, transparent); }

  /* ---------- Hero ---------- */
  .fl-hero { position: relative; padding: 5.5rem 0 6.5rem; overflow: hidden; }
  .fl-hero__backdrop { position: absolute; inset: 0; z-index: 0; }
  .fl-hero :global(.fl-hero__media) { position: absolute; inset: 0; }
  .fl-hero :global(.fl-hero__media .media-slot__img) {
    filter: saturate(1.1) blur(1px);
    animation: fl-kenburns 16s ease-out both;
  }
  @keyframes fl-kenburns { from { transform: scale(1.12); } to { transform: scale(1.02); } }
  .fl-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 60% 70% at 75% 45%, rgba(249, 115, 22, 0.14), transparent 70%),
      linear-gradient(90deg, rgba(12, 13, 16, 0.97) 0%, rgba(12, 13, 16, 0.86) 45%, rgba(12, 13, 16, 0.6) 100%),
      linear-gradient(0deg, var(--bg-page) 0%, transparent 40%);
  }
  .fl-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 3.5rem;
    align-items: center;
  }
  .fl-hero__copy > * { animation: fl-rise 0.8s var(--ease-out) both; }
  .fl-hero__copy > *:nth-child(2) { animation-delay: 0.06s; }
  .fl-hero__copy > *:nth-child(3) { animation-delay: 0.12s; }
  .fl-hero__copy > *:nth-child(4) { animation-delay: 0.18s; }
  .fl-hero__copy > *:nth-child(5) { animation-delay: 0.24s; }
  .fl-hero__copy > *:nth-child(6) { animation-delay: 0.3s; }
  @keyframes fl-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .fl-crumbs { display: flex; gap: 0.5rem; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem; }
  .fl-crumbs a { color: var(--text-secondary); text-decoration: none; }
  .fl-crumbs a:hover { color: var(--accent); }
  .fl-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    margin-bottom: 1.25rem;
  }
  .fl-hero h1 {
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin-bottom: 1.1rem;
  }
  .fl-h1__lead { display: block; font-size: clamp(1.15rem, 1.8vw, 1.4rem); letter-spacing: -0.3px; color: var(--text-secondary); margin-bottom: 0.55rem; }
  .fl-h1__hl { display: block; font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
  .fl-hero__sub { color: var(--text-secondary); font-size: 1.08rem; line-height: 1.65; margin-bottom: 1.75rem; max-width: 540px; }
  .fl-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .fl-ghost { background: rgba(12, 13, 16, 0.4); backdrop-filter: blur(8px); }
  .fl-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.8rem; color: var(--text-muted); }
  .fl-trust li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .fl-trust .fl-check { width: 16px; height: 16px; font-size: 0.55rem; }

  /* App-window frame around the mockup */
  .fl-hero__visual { position: relative; animation: fl-rise 0.9s var(--ease-out) 0.2s both; }
  .fl-hero__visual::before {
    content: '';
    position: absolute;
    inset: -8% -6%;
    z-index: -1;
    background: radial-gradient(ellipse at center, rgba(249, 115, 22, 0.28), rgba(251, 191, 36, 0.06) 45%, transparent 70%);
    filter: blur(40px);
  }
  .fl-window {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(16, 17, 21, 0.88);
    backdrop-filter: blur(16px);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
  }
  .fl-window__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }
  .fl-window__bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); }
  .fl-window__bar i:first-child { background: #f87171; }
  .fl-window__bar i:nth-child(2) { background: #fbbf24; }
  .fl-window__bar i:nth-child(3) { background: #34d399; }
  .fl-window__bar span {
    margin-left: 0.6rem;
    font: 600 0.7rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--text-muted);
    letter-spacing: 0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fl-window__body { padding: 0.75rem; }
  .fl-window__media { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; }

  /* ---------- Stats ---------- */
  .fl-stats {
    position: relative;
    z-index: 3;
    margin-top: -3rem;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    padding: 1.6rem 1rem;
  }
  .fl-stat { text-align: center; padding: 0 1rem; }
  .fl-stat + .fl-stat { border-left: 1px solid var(--border-subtle); }
  .fl-stat__value { font-family: var(--font-display); font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 900; letter-spacing: -1px; line-height: 1.1; }
  .fl-stat__label { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem; }

  /* ---------- Phase banner ---------- */
  .fl-banner-wrap { padding-top: 5rem; }
  .fl-banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 300px;
    aspect-ratio: 21 / 8;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
  }
  .fl-banner :global(.fl-banner__media) { position: absolute; inset: 0; }
  .fl-banner :global(.media-slot__img) { transition: transform 1.4s var(--ease-out); }
  .fl-banner:hover :global(.media-slot__img) { transform: scale(1.04); }
  .fl-banner__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(12, 13, 16, 0.92) 0%, rgba(12, 13, 16, 0.65) 40%, rgba(12, 13, 16, 0.05) 75%);
    pointer-events: none;
  }
  .fl-banner__copy { position: relative; z-index: 2; padding: 2.5rem 3rem; max-width: 520px; }
  .fl-banner__phase {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .fl-banner__phase b { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text-muted); letter-spacing: 0; }
  .fl-banner__copy p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.6px;
    margin-bottom: 1.1rem;
  }
  .fl-banner__more { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); transition: color 0.2s; }
  .fl-banner:hover .fl-banner__more { color: var(--accent); }

  /* ---------- Workflow stepper ---------- */
  .fl-steps {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 2rem;
  }
  .fl-steps::before {
    content: '';
    position: absolute;
    top: 27px;
    left: calc(100% / var(--n) / 2);
    right: calc(100% / var(--n) / 2);
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-secondary), rgba(249, 115, 22, 0.15));
    transform-origin: left;
    transform: scaleX(0);
